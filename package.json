{
  "name": "cloud-swarm",
  "version": "0.1.80",
  "private": true,
  "description": "A shared workspace for people and their agents, at home and at work. Share messages and files.",
  "type": "module",
  "bin": {
    "cswarm": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "hooks:install": "git config core.hooksPath scripts/hooks",
    "agent-trailers": "scripts/agent-trailers.sh --emit",
    "check:agent-trailers": "scripts/check-agent-trailers.sh --self-test",
    "build:command-core": "esbuild src/protocol/index.ts --bundle --format=esm --platform=neutral --target=es2022 --external:node:crypto --banner:js='// GENERATED from src/protocol/index.ts; do not hand-edit.' --outfile=supabase/functions/_shared/protocol.js && node scripts/build-admin-types.mjs",
    "dev": "tsc --watch",
    "check:tests": "tsc -p tsconfig.tests.json",
    "check:edge": "deno check --config supabase/functions/command/deno.json supabase/functions/command/index.ts supabase/functions/read/index.ts supabase/functions/capability/index.ts supabase/functions/activity/index.ts supabase/functions/h0/index.ts supabase/functions/mcp/index.ts supabase/functions/admin/index.ts deploy/edge-runtime/main/index.ts",
    "test": "node scripts/run-test-list.mjs tests/lists/test.txt && node --import tsx --test tests/c1-task-from-plan.test.ts",
    "test:box-dry-run": "node --import tsx --test --test-concurrency=1 tests/box-dry-run.test.ts tests/release-preflight.test.mjs",
    "test:site": "npm --prefix site test",
    "test:p1-cli": "node scripts/require-cli-build.mjs && node --import tsx --test --test-timeout=300000 tests/p1-cli/**/*.test.ts",
    "test:p1-local": "node scripts/run-test-list.mjs tests/lists/test:p1-local.txt --test-concurrency=1",
    "test:uxtest": "node --import tsx --test tests/uxtest-harness.test.ts",
    "pretest:p1-server": "npm run build:command-core",
    "test:p1-server": "node scripts/run-test-list.mjs tests/lists/test:p1-server.txt --test-concurrency=1",
    "prebuild": "rm -rf dist",
    "postbuild": "chmod 755 dist/cli.js",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:status": "supabase status",
    "db:diff": "supabase db diff --local",
    "db:migrate": "supabase migration up --local",
    "benchmark:onboarding": "node --import tsx scripts/benchmark-onboarding.mjs",
    "test:h0-upgrade:local": "python3 deploy/supabase-stack/migrate/test-h0-upgrade.py",
    "test:h0-counts": "python3 deploy/supabase-stack/migrate/test-post-upgrade-counts.py",
    "test:chatgpt-package": "node --test tests/chatgpt-package.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.110.8",
    "@types/node": "^25.5.0",
    "postgres": "^3.4.9",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0"
  }
}
