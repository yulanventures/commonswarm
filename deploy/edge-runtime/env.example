# Copy only the names needed by the box to /home/commonswarm/.env. Put values
# in that 0600 file. Do not put values in this repository.
SWARM_DATABASE_URL=
SUPABASE_DB_URL=
SWARM_DATABASE_TLS_CA_B64=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SWARM_ENV=
SWARM_COMMAND_ALLOWED_ORIGINS=
SWARM_CAPABILITY_URLS=
SWARM_CAPABILITY_ALLOWED_ORIGINS=
SWARM_SELF_SERVE=

# Hosted MCP resource worker. Tool access remains dark unless the final flag is 1.
SWARM_MCP_ISSUER=
SWARM_MCP_RESOURCE=
SWARM_MCP_JWKS_URL=
SWARM_MCP_ALLOWED_ORIGINS=
SWARM_MCP_MAX_BODY_BYTES=
SWARM_MCP_MAX_RESPONSE_BYTES=
SWARM_MCP_REQUEST_TIMEOUT_MS=
SWARM_MCP_MAX_CONCURRENT_REQUESTS=
SWARM_MCP_JWKS_CACHE_TTL_SECONDS=
SWARM_MCP_CLOCK_SKEW_SECONDS=
SWARM_MCP_PUBLIC_ENABLED=
# Exact 1 admits to-do/list tools and their server-side storage credential.
SWARM_MCP_TODOS_LISTS_ENABLED=
# Exact 1 turns on workspace memory for agents: command, read and local MCP. Off when unset.
SWARM_BRAIN_MEMORY=
# Exact 1, with SWARM_BRAIN_MEMORY, also gives hosted MCP seats the memory tools.
SWARM_BRAIN_MEMORY_HOSTED=
# Exact 1 turns on choice asks and answers (interactive replies). Off when unset.
SWARM_INTERACTIVE_REPLIES=
# Random, at least 32 characters. Read by the main service and handed only to the mcp
# worker; it authenticates mcp to main's loopback-only PDF text path. Unset disables PDF text.
SWARM_FILE_TEXT_TOKEN=
# Main service only. User-worker wall clock in ms, 150000 to 3600000; workers retire at half
# of it. Unset or invalid keeps 150000. Main logs the applied value as edge_worker_timeout.
SWARM_EDGE_WORKER_TIMEOUT_MS=
# Main service only. User-worker CPU soft limit in ms over a worker's life, 1000 to 10000; the
# hard limit is twice it. Unset or invalid keeps the runtime's 1000/2000. Logged in edge_worker_timeout.
SWARM_EDGE_WORKER_CPU_SOFT_MS=

# Test-only names are listed for source completeness. Leave them commented out
# on the box. The main service also removes them unless SWARM_ENV is test.
# SWARM_CMD_TEST_SLEEP_AFTER_STEP=
# SWARM_CMD_TEST_ROLLBACK_BEFORE_STEP=
