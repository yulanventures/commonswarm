{
	servers {
		# Cloudflare published proxy ranges, pinned 2026-09-16. Trust only these
		# peers when deriving client_ip from CF-Connecting-IP/X-Forwarded-For.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(supabase_origin) {
	reverse_proxy https://ukezjcnxjvkpkeezxaew.supabase.co {
		header_up Host ukezjcnxjvkpkeezxaew.supabase.co
		header_up X-Forwarded-Host ukezjcnxjvkpkeezxaew.supabase.co
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {http.request.client_ip}
		transport http {
			tls_server_name ukezjcnxjvkpkeezxaew.supabase.co
		}
	}
}

(supabase_realtime_origin) {
	reverse_proxy https://ukezjcnxjvkpkeezxaew.supabase.co {
		header_up Host ukezjcnxjvkpkeezxaew.supabase.co
		header_up X-Forwarded-Host ukezjcnxjvkpkeezxaew.supabase.co
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {http.request.client_ip}
		# Realtime needs an HTTP/1.1 upstream for websocket Upgrade. Auth, REST,
		# and Storage do not upgrade and can keep the default HTTP/2 transport.
		flush_interval -1
		transport http {
			versions 1.1
			tls_server_name ukezjcnxjvkpkeezxaew.supabase.co
		}
	}
}

# edge-staging.commonswarm.com is the approved staging name (HezLead, zone rule <service>-staging). It serves the
# same routes so the cutover can be rehearsed before api.commonswarm.com moves; this block gets no api traffic until
# the api DNS record points at the box.
api.commonswarm.com, edge-staging.commonswarm.com {
	tls /etc/caddy/certs/commonswarm.com.pem /etc/caddy/certs/commonswarm.com.key

	# The CLI, site, listener activity publisher, and H0 client call these functions.
	# Include bare /functions/v1 so the local runtime can return Kong's matching 404.
	@edge_functions path /functions/v1 /functions/v1/*
	handle @edge_functions {
		reverse_proxy 127.0.0.1:9000 {
			# Capability rate limits must key the visitor, not the Cloudflare edge.
			header_up X-Forwarded-For {http.request.client_ip}
			transport http {
				# Workers may use the hosted 150 s wall clock. Keep 15 s of proxy margin.
				response_header_timeout 165s
			}
		}
	}

	# supabase-js and the CLI use GoTrue for OAuth, OTP, refresh, user, and logout.
	handle /auth/v1/* {
		import supabase_origin
	}

	# The CLI and site use PostgREST for workspace, signal, channel, file, and invite rows.
	handle /rest/v1/* {
		import supabase_origin
	}

	# The site and command function use Storage object and signed-URL endpoints.
	handle /storage/v1/* {
		import supabase_origin
	}

	# supabase-js uses this websocket route for wake, feed, and activity channels.
	# Use HTTP/1.1 upstream and disable response buffering for the upgrade.
	handle /realtime/v1/* {
		import supabase_realtime_origin
	}

	# Keep every other Supabase project path available during and after cutover.
	handle {
		import supabase_origin
	}
}
