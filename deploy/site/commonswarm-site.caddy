# site-staging.commonswarm.com follows the zone rule <service>-staging and lets the full path through Cloudflare
# be checked with parity-check.mjs before commonswarm.com and www move (HezLead approved the naming rule).
https://commonswarm.com, https://www.commonswarm.com, https://site-staging.commonswarm.com {
	# The origin answers only requests that present a client certificate signed by the pool below
	# (the edge in front of it does); anything reaching the box directly is refused at the handshake.
	# Paths and settings only: the certificate, key and trust pool live on the box.
	tls /etc/caddy/certs/commonswarm.com.pem /etc/caddy/certs/commonswarm.com.key {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/aop/commonswarm.com/ca.pem
		}
	}
	root * /srv/commonswarm/site/current

	route {
		header {
			Strict-Transport-Security "max-age=63072000"
			Cache-Control "public, max-age=0, must-revalidate"
		}

		# Astro names every file under /_astro/ and Vite names every file under /next/assets/ after a hash
		# of its contents, so a name never changes what it holds: the browser may keep it for a year without
		# asking again. Pages, fonts and everything else keep the rule above. A miss resets this in
		# handle_errors, so a 404 for a hashed name is never kept.
		@hashed path /_astro/* /next/assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Preview app security headers apply to every response under /next (HTML, assets, fonts, and errors)
		# and nowhere else. Preview HTML is never cached; hashed preview assets keep the long-lived rule above.
		@next path /next /next/*
		header @next {
			Content-Security-Policy "frame-ancestors 'none'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
		}
		@nextHtml path /next /next/ /next/index.html /next/index.html/
		header @nextHtml Cache-Control "no-cache"

		# Vercel treats a slash after a file name as the file itself. Remove that
		# slash before MIME matching and file lookup. This also turns a missing
		# file-with-slash into the normal 404 path instead of Caddy's 400.
		@fileWithSlash path_regexp fileWithSlash ^(.+\.[^/]+)/$
		rewrite @fileWithSlash {re.fileWithSlash.1}

		@install path /install.sh
		header @install Content-Type "application/x-sh"

		@markdown path *.md
		header @markdown Content-Type "text/markdown; charset=utf-8"
		@javascript path *.js
		header @javascript Content-Type "application/javascript; charset=utf-8"
		@manifest path /site.webmanifest
		header @manifest Content-Type "application/manifest+json; charset=utf-8"
		@xml path *.xml
		header @xml Content-Type "application/xml"

		# Vercel returns 404 for dotfile-shaped paths. Never expose a file that was
		# copied into the release by mistake.
		@dotfile path_regexp dotfile (?:^|/)\.
		error @dotfile 404

		# Vercel serves /x from Astro's x/index.html without a redirect. A handle
		# applies the matcher to try_files; try_files itself takes file candidates only.
		@cleanUrl not path */
		handle @cleanUrl {
			try_files {path}/index.html {path}
			file_server {
				disable_canonical_uris
			}
		}

		# Vercel also serves /x/ without a redirect. Missing indexes stay 404.
		handle {
			rewrite * {path}index.html
			file_server {
				disable_canonical_uris
			}
		}
	}

	handle_errors {
		# Caddy reports ENOTDIR as 400 when a request adds a segment below a
		# real file. Vercel treats that path as missing, so normalize both cases.
		@notFound expression {http.error.status_code} == 404 || {http.error.status_code} == 400

		# An error is never kept, whatever the route set for the path that failed.
		header Cache-Control "public, max-age=0, must-revalidate"

		# The site's own not-found page (site/src/pages/404.astro, built to /404.html), still
		# answered with status 404, for requests that are asking for a page: an address with no
		# file extension, or one ending in .html. Everything else keeps the plain answer below:
		# a missing .js, .md, .txt, .json or .xml, any other file type, and anything under the
		# asset folders. An agent or a script fetching a missing file must not be handed HTML.
		# The original address is tested, because the route above may have rewritten the path.
		# A release that has no /404.html also keeps the plain answer, so this block and the
		# site can ship in either order.
		@notFoundPage {
			expression `({http.error.status_code} == 404 || {http.error.status_code} == 400) && !{http.request.orig_uri.path}.matches("^/(_astro|fonts|next/assets|next/fonts)/") && ({http.request.orig_uri.path}.matches("\\.html?/?$") || !{http.request.orig_uri.path}.matches("\\.[^/.]+/?$"))`
			file /404.html
		}
		handle @notFoundPage {
			header Content-Type "text/html; charset=utf-8"
			rewrite * /404.html
			file_server {
				status 404
			}
		}

		handle @notFound {
			header Content-Type "text/plain; charset=utf-8"
			respond <<BODY
The page could not be found

NOT_FOUND

commonswarm::not-found

BODY 404
		}
	}
}
