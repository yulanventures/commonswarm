# site-staging.commonswarm.com follows the zone rule <service>-staging and lets the full path through Cloudflare
# be checked with parity-check.mjs before commonswarm.com and www move (HezLead approved the naming rule).
https://commonswarm.com, https://www.commonswarm.com, https://site-staging.commonswarm.com {
	tls /etc/caddy/certs/commonswarm.com.pem /etc/caddy/certs/commonswarm.com.key
	root * /srv/commonswarm/site/current

	route {
		header {
			Strict-Transport-Security "max-age=63072000"
			Cache-Control "public, max-age=0, must-revalidate"
		}

		# Vercel treats a slash after a file name as the file itself. Remove that
		# slash before MIME matching and file lookup. This also turns a missing
		# file-with-slash into the normal 404 path instead of Caddy's 400.
		@fileWithSlash path_regexp fileWithSlash ^(.+\.[^/]+)/$
		rewrite @fileWithSlash {re.fileWithSlash.1}

		@install path /install.sh
		header @install Content-Type "application/x-sh"

		@markdown path *.md
		header @markdown Content-Type "text/markdown; charset=utf-8"
		@javascript path *.js
		header @javascript Content-Type "application/javascript; charset=utf-8"
		@manifest path /site.webmanifest
		header @manifest Content-Type "application/manifest+json; charset=utf-8"
		@xml path *.xml
		header @xml Content-Type "application/xml"

		# Vercel returns 404 for dotfile-shaped paths. Never expose a file that was
		# copied into the release by mistake.
		@dotfile path_regexp dotfile (?:^|/)\.
		error @dotfile 404

		# Vercel serves /x from Astro's x/index.html without a redirect. A handle
		# applies the matcher to try_files; try_files itself takes file candidates only.
		@cleanUrl not path */
		handle @cleanUrl {
			try_files {path}/index.html {path}
			file_server {
				disable_canonical_uris
			}
		}

		# Vercel also serves /x/ without a redirect. Missing indexes stay 404.
		handle {
			rewrite * {path}index.html
			file_server {
				disable_canonical_uris
			}
		}
	}

	handle_errors {
		# Caddy reports ENOTDIR as 400 when a request adds a segment below a
		# real file. Vercel treats that path as missing, so normalize both cases.
		@notFound expression {http.error.status_code} == 404 || {http.error.status_code} == 400
		header @notFound Content-Type "text/plain; charset=utf-8"
		respond @notFound <<BODY
The page could not be found

NOT_FOUND

commonswarm::not-found

BODY 404
	}
}
