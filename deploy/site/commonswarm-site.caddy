https://commonswarm.com, https://www.commonswarm.com {
	tls /etc/caddy/certs/commonswarm.com.pem /etc/caddy/certs/commonswarm.com.key
	root * /srv/commonswarm/site/current

	route {
		header {
			Strict-Transport-Security "max-age=63072000"
			Cache-Control "public, max-age=0, must-revalidate"
		}

		@install path /install.sh
		header @install Content-Type "application/x-sh"

		@markdown path *.md
		header @markdown Content-Type "text/markdown; charset=utf-8"
		@javascript path *.js
		header @javascript Content-Type "application/javascript; charset=utf-8"
		@manifest path /site.webmanifest
		header @manifest Content-Type "application/manifest+json; charset=utf-8"
		@xml path *.xml
		header @xml Content-Type "application/xml"

		# Vercel serves both /x and /x/ from Astro's x/index.html without a redirect.
		@trailingSlash path */
		rewrite @trailingSlash {path}index.html

		@cleanUrl not path */
		try_files @cleanUrl {path}/index.html {path} =404

		file_server
	}

	handle_errors {
		@notFound expression {http.error.status_code} == 404
		header @notFound Content-Type "text/plain; charset=utf-8"
		respond @notFound "The page could not be found" 404
	}
}
