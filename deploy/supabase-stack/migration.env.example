# Render this separate migration-only file with mode 0600. Compose must never
# mount it into a long-running service.
SOURCE_DATABASE_URL=
# The source cluster's pg_control_system().system_identifier, read once by the lead before the window.
# Every source-side script refuses a database whose identifier differs. Not a secret; it pins the source.
SOURCE_SYSTEM_IDENTIFIER=
TARGET_DATABASE_URL=
CUTOVER_CONFIRM=
# Rehearsal and window: SOURCE_STORAGE_URL=https://ukezjcnxjvkpkeezxaew.supabase.co
# copy-storage.mjs appends /storage/v1/object/... to this base URL.
SOURCE_STORAGE_URL=
SOURCE_SERVICE_ROLE_KEY=
# Rehearsal and window: TARGET_STORAGE_URL=http://127.0.0.1:18004
# This reaches the box Storage API without api.commonswarm.com, whose POST requests return 503 in the window.
TARGET_STORAGE_URL=
TARGET_SERVICE_ROLE_KEY=

# Local rehearsal only. Leave both unset on the box.
COMMONSWARM_LOCAL_REHEARSAL=
COMMONSWARM_LOCAL_TARGET_HOSTS=
COMMONSWARM_LOCAL_TARGET_ADDRESS=
