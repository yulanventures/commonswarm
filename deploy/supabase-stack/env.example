# Copy only the names into the vault item "CommonSwarm self-hosted Supabase env".
# Write the rendered file to /home/commonswarm/.env with mode 0600.

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=supabase_admin
POSTGRES_HOST=/var/run/postgresql
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=scram-sha-256
JWT_SECRET=
JWT_EXP=3600
BACKUP_RO_PASSWORD=
COMMONSWARM_EDGE_DB_PASSWORD=

# GoTrue
API_EXTERNAL_URL=https://api.commonswarm.com/auth/v1
GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_DATABASE_URL=
GOTRUE_SITE_URL=https://commonswarm.com
GOTRUE_URI_ALLOW_LIST=https://commonswarm.com/app,https://www.commonswarm.com/app,http://127.0.0.1:*/callback
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_MAILER_SECURE_EMAIL_CHANGE_ENABLED=true
GOTRUE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED=true
GOTRUE_SECURITY_REFRESH_TOKEN_REUSE_INTERVAL=10
GOTRUE_JWT_SECRET=
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_VALID_METHODS=HS256
GOTRUE_EXTERNAL_GITHUB_ENABLED=true
GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=
GOTRUE_EXTERNAL_GITHUB_SECRET=
GOTRUE_EXTERNAL_GITHUB_REDIRECT_URI=https://api.commonswarm.com/auth/v1/callback
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://api.commonswarm.com/auth/v1/callback
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=
GOTRUE_SMTP_SENDER_NAME=CommonSwarm

# PostgREST
PGRST_DB_URI=
PGRST_DB_SCHEMAS=public,storage,graphql_public,swarm_read
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_ANON_ROLE=anon
PGRST_DB_MAX_ROWS=1000
PGRST_JWT_SECRET=
PGRST_ADMIN_SERVER_PORT=3001

# Realtime. setup-realtime.sh writes the matching tenant record once.
APP_NAME=realtime
PORT=4000
DB_HOST=db.commonswarm.internal
DB_PORT=5432
DB_USER=supabase_admin
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true
DB_SSL_CA_CERT=/etc/ssl/yulan-internal-ca.pem
DB_AFTER_CONNECT_QUERY=SET search_path TO _realtime
# Exactly 16 high-entropy ASCII characters; Realtime uses it as an AES-128 key.
DB_ENC_KEY=
API_JWT_SECRET=
# A valid JWKS JSON object, not an empty string.
API_JWT_JWKS=
METRICS_JWT_SECRET=
SECRET_KEY_BASE=
SEED_SELF_HOST=false
SELF_HOST_TENANT_NAME=realtime-dev
RUN_JANITOR=true
RLIMIT_NOFILE=10000
ERL_AFLAGS=-proto_dist inet_tcp
SLOT_NAME_SUFFIX=_commonswarm

# Storage API. R2 is the chosen production backend; see STORAGE-BACKEND.md.
ANON_KEY=
SERVICE_KEY=
AUTH_JWT_SECRET=
JWT_JWKS=
DATABASE_URL=
TENANT_ID=commonswarm
REGION=auto
STORAGE_BACKEND=s3
STORAGE_S3_BUCKET=commonswarm-files
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FILE_SIZE_LIMIT=26214400
UPLOAD_FILE_SIZE_LIMIT=26214400
UPLOAD_FILE_SIZE_LIMIT_STANDARD=26214400
SIGNED_UPLOAD_URL_EXPIRATION_TIME=7200
S3_PROTOCOL_ENABLED=false
ENABLE_IMAGE_TRANSFORMATION=false
SERVER_PORT=5000
SERVER_ADMIN_PORT=5001
NODE_EXTRA_CA_CERTS=/etc/ssl/yulan-internal-ca.pem

# The existing edge-runtime lane still reads these names from the same file.
SUPABASE_URL=https://api.commonswarm.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS=
SUPABASE_DB_URL=
SWARM_DATABASE_URL=
SWARM_SELF_SERVE=1
SWARM_COMMAND_ALLOWED_ORIGINS=https://commonswarm.com,https://www.commonswarm.com
SWARM_DATABASE_TLS_CA_B64=
