[Unit]
Description=CommonSwarm database and exact file-version backup
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/bin/bash /home/commonswarm/stack/current/deploy/supabase-stack/backup/run-backup.sh
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
