# Live API site file. Auth, REST, Storage, Realtime, and functions go to the
# containers on this server. There is no fallback to another host.
api.commonswarm.com {
	tls /etc/caddy/certs/commonswarm.com.pem /etc/caddy/certs/commonswarm.com.key

	log {
		output file /var/log/caddy/api.commonswarm.com.access.log {
			mode 0600
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			request>uri regexp "\?.*$" ""
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Set-Cookie delete
			request>headers>Proxy-Authorization delete
			request>headers>Apikey delete
			request>headers>apikey delete
			resp_headers>Authorization delete
			resp_headers>Cookie delete
			resp_headers>Set-Cookie delete
			resp_headers>Proxy-Authorization delete
			resp_headers>Apikey delete
			resp_headers>apikey delete
			wrap json
		}
	}

	@edge_functions path /functions/v1 /functions/v1/*
	handle @edge_functions {
		reverse_proxy 127.0.0.1:9000 {
			header_up X-Forwarded-For {http.request.client_ip}
			transport http {
				response_header_timeout 165s
			}
		}
	}

	handle_errors {
		@edge_function_error path /functions/v1 /functions/v1/*
		handle @edge_function_error {
			header Access-Control-Allow-Origin "*"
			respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
		}
	}

	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy 127.0.0.1:18001
	}

	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy 127.0.0.1:18002
	}

	handle /storage/v1/* {
		route {
			# Evaluate upload matchers before stripping the Storage prefix.
			@signed_upload {
				path /storage/v1/object/upload/sign/*
				method OPTIONS PUT
			}
			handle @signed_upload {
				@upload_preflight {
					method OPTIONS
					expression `{http.request.header.Origin} in ["https://commonswarm.com", "https://www.commonswarm.com", "https://site-staging.commonswarm.com"]`
					header Access-Control-Request-Method PUT
				}
				@upload_put {
					method PUT
					expression `{http.request.header.Origin} in ["https://commonswarm.com", "https://www.commonswarm.com", "https://site-staging.commonswarm.com"]`
				}
				# Overwrite at response time to avoid duplicate upstream values.
				# Vary also covers denied/no-Origin responses for shared caches.
				header >Vary Origin
				header @upload_put >Access-Control-Allow-Origin {http.request.header.Origin}
				header @upload_preflight {
					Access-Control-Allow-Origin {http.request.header.Origin}
					Access-Control-Allow-Methods "PUT, OPTIONS"
					Access-Control-Allow-Headers content-type
					Access-Control-Max-Age 600
					defer
				}
				respond @upload_preflight "" 204
				uri strip_prefix /storage/v1
				reverse_proxy 127.0.0.1:18004 {
					# Upstream CORS cannot bypass the allowlist or add credentials.
					header_down -Access-Control-*
				}
			}
			# Preserve every other Storage route and method.
			handle {
				uri strip_prefix /storage/v1
				reverse_proxy 127.0.0.1:18004
			}
		}
	}

	@supabase_realtime path /realtime/v1 /realtime/v1/*
	handle @supabase_realtime {
		uri replace /realtime/v1/websocket /socket/websocket
		uri strip_prefix /realtime/v1
		reverse_proxy 127.0.0.1:18003 {
			header_up Host realtime-dev
			header_up X-Forwarded-Host {host}
			flush_interval -1
			transport http {
				versions 1.1
			}
		}
	}

	handle {
		header Content-Type application/json
		respond "{\"error\":\"not_found\"}" 404
	}
}

# A later pause installs commonswarm-api-maintenance.caddy together with
# commonswarm-edge-staging-maintenance.caddy. The public site answers 503 and
# has no upstream.
