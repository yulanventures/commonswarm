# Maintenance site file. Install it for a recovery drill or a later pause.
# api.commonswarm.com answers every request except CORS preflight with 503.
# That site has no upstream.
# edge-staging.commonswarm.com imports box_routes, the containers on this server.

(box_routes) {
	@edge_functions path /functions/v1 /functions/v1/*
	handle @edge_functions {
		reverse_proxy 127.0.0.1:9000 {
			header_up X-Forwarded-For {http.request.client_ip}
			transport http {
				response_header_timeout 165s
			}
		}
	}

	handle_errors {
		@edge_function_error path /functions/v1 /functions/v1/*
		handle @edge_function_error {
			header Access-Control-Allow-Origin "*"
			respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
		}
	}

	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy 127.0.0.1:18001
	}

	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy 127.0.0.1:18002
	}

	handle /storage/v1/* {
		uri strip_prefix /storage/v1
		reverse_proxy 127.0.0.1:18004
	}

	@supabase_realtime path /realtime/v1 /realtime/v1/*
	handle @supabase_realtime {
		uri replace /realtime/v1/websocket /socket/websocket
		uri strip_prefix /realtime/v1
		reverse_proxy 127.0.0.1:18003 {
			header_up Host realtime-dev
			header_up X-Forwarded-Host {host}
			flush_interval -1
			transport http {
				versions 1.1
			}
		}
	}

	handle {
		header Content-Type application/json
		respond "{\"error\":\"not_found\"}" 404
	}
}

api.commonswarm.com {
	tls /etc/caddy/certs/commonswarm.com.pem /etc/caddy/certs/commonswarm.com.key

	@maintenance_preflight method OPTIONS
	handle @maintenance_preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Headers "authorization, apikey, content-type, x-client-info"
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS, POST, PUT, PATCH, DELETE"
		header Access-Control-Max-Age "300"
		respond "" 204
	}

	handle {
		header Access-Control-Allow-Origin "*"
		header Cache-Control "no-store"
		header Content-Type "application/json"
		header Retry-After "300"
		respond "{\"error\":\"maintenance\",\"message\":\"writes are paused for database migration\"}" 503
	}
}

edge-staging.commonswarm.com {
	tls /etc/caddy/certs/commonswarm.com.pem /etc/caddy/certs/commonswarm.com.key
	import box_routes
}
