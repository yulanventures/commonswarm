# Maintenance site file. Install it for a recovery drill or a later pause.
# api.commonswarm.com answers every request except CORS preflight with 503.
# That site has no upstream.
api.commonswarm.com {
	tls /etc/caddy/certs/commonswarm.com.pem /etc/caddy/certs/commonswarm.com.key

	log {
		output file /var/log/caddy/api.commonswarm.com.access.log {
			mode 0600
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			request>uri regexp "\?.*$" ""
			request>headers>Authorization delete
			request>headers>DPoP delete
			request>headers>Dpop delete
			request>headers>DPoP-Nonce delete
			request>headers>Dpop-Nonce delete
			request>headers>Cookie delete
			request>headers>Set-Cookie delete
			request>headers>Proxy-Authorization delete
			request>headers>Apikey delete
			request>headers>apikey delete
			resp_headers>Authorization delete
			resp_headers>DPoP delete
			resp_headers>Dpop delete
			resp_headers>DPoP-Nonce delete
			resp_headers>Dpop-Nonce delete
			resp_headers>Cookie delete
			resp_headers>Set-Cookie delete
			resp_headers>Proxy-Authorization delete
			resp_headers>Apikey delete
			resp_headers>apikey delete
			wrap json
		}
	}

	@maintenance_preflight method OPTIONS
	handle @maintenance_preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Headers "authorization, apikey, content-type, x-client-info"
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS, POST, PUT, PATCH, DELETE"
		header Access-Control-Max-Age "300"
		respond "" 204
	}

	handle {
		header Access-Control-Allow-Origin "*"
		header Cache-Control "no-store"
		header Content-Type "application/json"
		header Retry-After "300"
		respond "{\"error\":\"maintenance\",\"message\":\"writes are paused for database migration\"}" 503
	}
}
