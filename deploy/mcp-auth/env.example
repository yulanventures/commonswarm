MCP_OAUTH_UID=
MCP_OAUTH_GID=
MCP_OAUTH_HOST_PORT=
MCP_OAUTH_ENV_FILE=
MCP_OAUTH_PUBLIC_AUTHORIZATION_ENABLED=
