MCP_OAUTH_DATABASE_ADDRESS=
MCP_OAUTH_DATABASE_PORT=
MCP_OAUTH_DATABASE_NAME=
MCP_OAUTH_DATABASE_TLS_CA_FILE=
MCP_OAUTH_SIGNING_KEYS_FILE=
