MCP_OAUTH_RESOURCE=
MCP_OAUTH_PUBLIC_ORIGIN=
MCP_OAUTH_ALLOWED_ORIGINS=
MCP_OAUTH_GOTRUE_URL=
MCP_OAUTH_GOTRUE_PROVIDER=
SUPABASE_URL=
SUPABASE_ANON_KEY=
