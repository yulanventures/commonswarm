[Unit]
Description=CommonSwarm exact-SHA standalone nightly (no GitHub Actions dispatch)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=commonswarm-ci
Group=commonswarm-ci
SupplementaryGroups=docker
UMask=0077
Environment=COMMONSWARM_CI_CONFIG=/opt/commonswarm-ci/config.json
# box-dry-run and site only, at one resolved SHA; manual runs may still use --suite all.
ExecStart=/bin/bash /opt/commonswarm-ci/scripts/run.sh --ref main --suite nightly
# Queue wait plus two serial 30m bounds and owned-service cleanup.
TimeoutStartSec=7200
# 75 = deferred for contention (the host stayed busy): not a failure of the nightly.
SuccessExitStatus=75
TimeoutStopSec=900
# SIGTERM reaches the controller; SIGKILL still bounds the whole cgroup.
KillMode=mixed
Nice=10
IOSchedulingClass=idle

