[Unit]
Description=CommonSwarm exact-SHA standalone nightly (no GitHub Actions dispatch)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=commonswarm-ci
Group=commonswarm-ci
SupplementaryGroups=docker
UMask=0077
Environment=COMMONSWARM_CI_CONFIG=/opt/commonswarm-ci/config.json
ExecStart=/bin/bash /opt/commonswarm-ci/scripts/run.sh --ref main --suite all
# Queue wait plus five serial 30m bounds and owned-service cleanup.
TimeoutStartSec=14400
TimeoutStopSec=900
KillMode=control-group
Nice=10
IOSchedulingClass=idle

