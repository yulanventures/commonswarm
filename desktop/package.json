{
  "name": "commonswarm-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "CommonSwarm desktop shell for macOS",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "test": "node --import tsx --test src/policy.test.ts",
    "dist": "npm run build && electron-builder --mac --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
