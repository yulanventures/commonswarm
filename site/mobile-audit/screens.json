[
  {
    "id": "menu.account",
    "kind": "view",
    "path": "/app?w={workspace}",
    "setup": [
      {
        "media": "(width <= 52rem)",
        "click": "button[aria-label=\"Open navigation\"]"
      },
      {
        "click": "[data-user-menu-trigger]"
      }
    ],
    "ready": "live-dashboard:has([data-user-menu-trigger][aria-expanded=\"true\"]) [data-user-menu]:not([hidden])",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace"
    ]
  },
  {
    "id": "dialog.connected-apps",
    "kind": "dialog",
    "path": "/app?w={workspace}",
    "setup": [
      {
        "media": "(width <= 52rem)",
        "click": "button[aria-label=\"Open navigation\"]"
      },
      {
        "click": "[data-user-menu-trigger]"
      },
      {
        "click": "[data-connected-apps-open]"
      }
    ],
    "ready": "dialog[data-connected-apps-dialog][open] [data-connected-apps-list] > p:has-text(\"No apps are connected to this account.\")",
    "states": [
      "empty"
    ],
    "requiresSeed": [
      "create_workspace"
    ]
  },
  {
    "id": "dialog.signout-others",
    "kind": "dialog",
    "path": "/app?w={workspace}",
    "setup": [
      {
        "media": "(width <= 52rem)",
        "click": "button[aria-label=\"Open navigation\"]"
      },
      {
        "click": "[data-user-menu-trigger]"
      },
      {
        "click": "[data-signout-others-open]"
      }
    ],
    "ready": "dialog[data-signout-others-dialog][open] [data-signout-others-cancel]",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace"
    ]
  },
  {
    "id": "dialog.account-agents",
    "kind": "dialog",
    "path": "/app?w={workspace}",
    "setup": [
      {
        "media": "(width <= 52rem)",
        "click": "button[aria-label=\"Open navigation\"]"
      },
      {
        "click": "[data-user-menu-trigger]"
      },
      {
        "click": "[data-account-agents-open]"
      }
    ],
    "ready": "dialog[data-account-agents-dialog][open] .account-agents__agent",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace",
      "create_agent_principal Orbit"
    ]
  },
  {
    "id": "dialog.details-sheet",
    "kind": "dialog",
    "path": "/app?w={workspace}",
    "setup": [
      {
        "media": "(width <= 52rem)",
        "click": ".cs-org-phone-bar [data-channel-details-toggle]"
      },
      {
        "media": "(width <= 52rem)",
        "waitFor": "dialog#cs-channel-details-sheet[open] [data-channel-details-close]:focus"
      },
      {
        "media": "(width > 52rem)",
        "click": ".hm-ws-header [data-channel-details-toggle]"
      },
      {
        "media": "(width > 52rem)",
        "waitFor": ".hm-frame:not([data-channel-details-collapsed]) #cs-channel-details .hm-side"
      }
    ],
    "ready": "#cs-channel-details .hm-side",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace"
    ]
  },
  {
    "id": "menu.workspace",
    "kind": "view",
    "path": "/app?w={workspace}",
    "setup": [
      {
        "media": "(width <= 52rem)",
        "click": "button[aria-label=\"Open navigation\"]"
      },
      {
        "media": "(width <= 52rem)",
        "click": ".cs-kylon-workspace-menu .hm-menu__trigger"
      },
      {
        "media": "(width <= 52rem)",
        "waitFor": ".cs-kylon-workspace-menu .hm-menu__list:not([hidden])"
      },
      {
        "media": "(width > 52rem)",
        "click": ".hm-ws-header .hm-menu__trigger"
      },
      {
        "media": "(width > 52rem)",
        "waitFor": ".hm-ws-header .hm-menu__list:not([hidden])"
      }
    ],
    "ready": ":is(.cs-kylon-workspace-menu, .hm-ws-header) .hm-menu__list:not([hidden])",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace"
    ]
  },
  {
    "id": "dialog.password",
    "kind": "dialog",
    "path": "/app?w={workspace}",
    "setup": [
      {
        "media": "(width <= 52rem)",
        "click": "button[aria-label=\"Open navigation\"]"
      },
      {
        "click": "[data-user-menu-trigger]"
      },
      {
        "click": "[data-password-open]"
      }
    ],
    "ready": "dialog[data-password-dialog][open] [data-password-new]",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace"
    ]
  },
  {
    "id": "nav.workspace-picker",
    "kind": "view",
    "path": "/app?w={workspace}",
    "setup": [
      {
        "media": "(width <= 52rem)",
        "click": "button[aria-label=\"Open navigation\"]"
      },
      {
        "click": "[data-workspace-picker] summary"
      }
    ],
    "ready": "[data-workspace-picker][open] .cs-workspace-picker__item[aria-current=\"page\"]",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace"
    ]
  },
  {
    "id": "nav.workspace-switch",
    "kind": "view",
    "path": "/app?w={workspace}",
    "setup": [
      {
        "media": "(width <= 52rem)",
        "click": "button[aria-label=\"Open navigation\"]"
      },
      {
        "click": "[data-workspace-picker] summary"
      },
      {
        "click": ".cs-workspace-picker__item[value=\"{emptyWorkspace}\"]"
      },
      {
        "waitFor": "live-dashboard:has([data-home-workspace-header=\"{emptyWorkspace}\"]) :is(#hm-ws-title:focus, .cs-org-phone-title #hm-phone-title:focus)"
      },
      {
        "media": "(width <= 52rem)",
        "click": "button[aria-label=\"Open navigation\"]"
      },
      {
        "click": "[data-workspace-picker] summary"
      }
    ],
    "ready": "[data-workspace-picker][open] .cs-workspace-picker__item[value=\"{emptyWorkspace}\"][aria-current=\"page\"]",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace",
      "create_workspace empty",
      "household_permissions empty"
    ]
  },
  {
    "id": "nav.phone-header",
    "kind": "view",
    "path": "/app?w={workspace}",
    "setup": [
      {
        "media": "(width <= 52rem)",
        "waitFor": ".cs-org-phone-bar [aria-label=\"Open navigation\"]"
      },
      {
        "media": "(width > 52rem)",
        "waitFor": ".hm-ws-header"
      }
    ],
    "ready": "live-dashboard",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace"
    ]
  }
]
