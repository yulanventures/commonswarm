[
  {
    "id": "app.chat.general",
    "kind": "view",
    "path": "/app?w={workspace}&c={channel.general}",
    "setup": [],
    "ready": "[data-channel-view=\"feed\"]:not([hidden]) .dashboard__message[data-signal-id]",
    "states": [
      "dense"
    ]
  },
  {
    "id": "app.composer",
    "kind": "view",
    "path": "/app?w={workspace}&c={channel.general}",
    "setup": [
      {
        "waitFor": "[data-composer]:not([hidden]) [data-composer-input]"
      },
      {
        "type": "[data-composer-input]",
        "text": "Checking the boiler quote before Friday."
      }
    ],
    "ready": "[data-composer]:not([hidden]) [data-composer-send]:not([disabled])",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace",
      "seed_channels"
    ]
  },
  {
    "id": "app.chat.richtext.code",
    "kind": "view",
    "path": "/app?w={workspace}&c={channel.general}",
    "setup": [
      {
        "waitFor": ".dashboard__message[data-signal-id=\"{message.richtext.code}\"]",
        "scroll": ".dashboard__message[data-signal-id=\"{message.richtext.code}\"]"
      }
    ],
    "ready": ".dashboard__message[data-signal-id=\"{message.richtext.code}\"] .dashboard__message-markdown pre",
    "states": [
      "dense",
      "richtext"
    ],
    "requiresSeed": [
      "message.richtext.code"
    ]
  },
  {
    "id": "app.chat.day-divider",
    "kind": "view",
    "path": "/app?w={workspace}&c={channel.general}",
    "setup": [
      {
        "waitFor": ".dashboard__feed > .hm-day",
        "scroll": ".dashboard__feed > .hm-day"
      }
    ],
    "ready": ".dashboard__feed > .hm-day .hm-day__label",
    "states": [
      "dense",
      "day-divider"
    ],
    "requiresSeed": [
      "seed_channels"
    ]
  },
  {
    "id": "app.chat.tap-message",
    "kind": "view",
    "path": "/app?w={workspace}&c={channel.general}",
    "setup": [
      {
        "waitFor": ".dashboard__feed > .dashboard__message[data-signal-id=\"{message.richtext.code}\"] .dashboard__message-markdown pre",
        "click": ".dashboard__feed > .dashboard__message[data-signal-id=\"{message.richtext.code}\"] .dashboard__message-markdown pre"
      }
    ],
    "ready": ".dashboard__feed > .dashboard__message[data-signal-id=\"{message.richtext.code}\"]:focus",
    "states": [
      "dense",
      "tap-focus"
    ],
    "requiresSeed": [
      "message.richtext.code"
    ]
  },
  {
    "id": "app.chat.keyboard-secondary",
    "kind": "view",
    "path": "/app?w={workspace}&c={channel.general}",
    "setup": [
      {
        "waitFor": ".dashboard__feed > .dashboard__message[data-signal-id=\"{message.richtext.code}\"] .dashboard__message-markdown pre",
        "click": ".dashboard__feed > .dashboard__message[data-signal-id=\"{message.richtext.code}\"] .dashboard__message-markdown pre"
      },
      {
        "press": "Tab"
      },
      {
        "press": "Tab"
      }
    ],
    "ready": ".dashboard__feed > .dashboard__message[data-signal-id=\"{message.richtext.code}\"] .dashboard__message-body > :is(.dashboard__message-meta, .dashboard__message-tools):focus-within",
    "states": [
      "dense",
      "keyboard-focus"
    ],
    "requiresSeed": [
      "message.richtext.code"
    ]
  }
]
