[
  {
    "id": "dialog.navigation-drawer",
    "kind": "dialog",
    "path": "/app?w={workspace}",
    "setup": [
      {
        "tap": "button[aria-label=\"Open navigation\"]"
      },
      {
        "waitFor": "dialog.cs-org-drawer[open] [data-workspace-picker]"
      }
    ],
    "ready": "dialog.cs-org-drawer[open] [data-workspace-picker]",
    "states": [
      "dense",
      "touch-drawer"
    ],
    "requiresSeed": [
      "create_workspace"
    ]
  }
]
