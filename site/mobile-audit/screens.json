[
  {
    "id": "app.chat.tap-message",
    "kind": "view",
    "path": "/app?w={workspace}&c={channel.general}",
    "setup": [
      {
        "waitFor": ".dashboard__feed > .dashboard__message[data-signal-id=\"{message.richtext.code}\"] .dashboard__message-markdown pre",
        "tap": ".dashboard__feed > .dashboard__message[data-signal-id=\"{message.richtext.code}\"] .dashboard__message-markdown pre"
      }
    ],
    "ready": ".dashboard__feed > .dashboard__message[data-signal-id=\"{message.richtext.code}\"]:focus",
    "states": [
      "dense",
      "touch-focus"
    ],
    "requiresSeed": [
      "message.richtext.code"
    ]
  },
  {
    "id": "app.chat.keyboard-secondary",
    "kind": "view",
    "path": "/app?w={workspace}&c={channel.general}",
    "setup": [
      {
        "waitFor": ".dashboard__feed > .dashboard__message[data-signal-id=\"{message.richtext.code}\"] .dashboard__message-markdown pre",
        "tap": ".dashboard__feed > .dashboard__message[data-signal-id=\"{message.richtext.code}\"] .dashboard__message-markdown pre"
      },
      {
        "press": "Tab"
      },
      {
        "press": "Tab"
      }
    ],
    "ready": ".dashboard__feed > .dashboard__message[data-signal-id=\"{message.richtext.code}\"] .dashboard__message-body > :is(.dashboard__message-meta, .dashboard__message-tools):focus-within",
    "states": [
      "dense",
      "keyboard-focus"
    ],
    "requiresSeed": [
      "message.richtext.code"
    ]
  }
]
