[
  {
    "id": "app.chat.general",
    "kind": "view",
    "path": "/app?w={workspace}&c={channel.general}",
    "setup": [],
    "ready": "[data-channel-view=\"feed\"]:not([hidden]) .dashboard__message[data-signal-id]",
    "states": [
      "dense"
    ]
  },
  {
    "id": "app.people",
    "kind": "view",
    "path": "/app?w={workspace}&v=people",
    "setup": [],
    "ready": "dialog[data-roster-dialog][open] [data-agent-row=\"{agent}\"]",
    "states": [
      "dense"
    ]
  },
  {
    "id": "app.add-agent.existing",
    "kind": "view",
    "path": "/app?w={emptyWorkspace}&v=add-agent",
    "setup": [
      {
        "waitFor": "[data-channel-view=\"agent-choice\"]:not([hidden]) agent-host-picker [data-ahp-existing]"
      },
      {
        "settle": true
      },
      {
        "click": "[data-channel-view=\"agent-choice\"]:not([hidden]) agent-host-picker [data-ahp-existing]"
      },
      {
        "waitFor": "[data-channel-view=\"agent-choice\"]:not([hidden]) [data-ahp-existing-view]:not([hidden]) [data-ahp-existing-list][data-agent-picker-state=\"ready\"] .pd-agent-choice .pd-choice-add"
      }
    ],
    "ready": "[data-channel-view=\"agent-choice\"]:not([hidden]) [data-ahp-existing-view]:not([hidden]) [data-ahp-existing-list][data-agent-picker-state=\"ready\"] .pd-agent-choice .pd-choice-add",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace",
      "create_workspace empty",
      "create_agent_principal Atlas Research & Long-Running Investigations Agent"
    ]
  },
  {
    "id": "dialog.people-confirm",
    "kind": "dialog",
    "path": "/app?w={workspace}&v=people",
    "setup": [
      {
        "scroll": "[data-people-context] .pd-agent:has(button[data-pd-focus=\"row-remove-agent-{agent}\"])"
      },
      {
        "click": "[data-people-context] .pd-agent:has(button[data-pd-focus=\"row-remove-agent-{agent}\"]) summary.pd-actions-toggle"
      },
      {
        "scroll": "[data-people-context] .pd-agent:has(button[data-pd-focus=\"row-remove-agent-{agent}\"]) .pd-row-actions[open] .pd-agent-actions"
      },
      {
        "click": "[data-people-context] button[data-pd-focus=\"row-remove-agent-{agent}\"]"
      }
    ],
    "ready": "dialog[data-people-confirm][open] #pd-confirm-title",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace",
      "create_agent_principal Atlas Research & Long-Running Investigations Agent"
    ]
  },
  {
    "id": "dialog.admin-access",
    "kind": "dialog",
    "path": "/app?w={workspace}&agent={agent}",
    "setup": [
      {
        "waitFor": "[data-home-route-pane]:not([hidden]) [data-hm-agent=\"{agent}\"] [data-seat-admin-slot=\"{agent}\"][data-seat-admin-surface=\"agent\"]:not([hidden]) [data-seat-admin=\"ready\"] [data-seat-admin-toggle=\"workspace\"]:not([disabled])[aria-checked=\"false\"]"
      },
      {
        "settle": true
      },
      {
        "scroll": "[data-home-route-pane]:not([hidden]) [data-hm-agent=\"{agent}\"] [data-seat-admin-slot=\"{agent}\"][data-seat-admin-surface=\"agent\"]:not([hidden]) [data-seat-admin=\"ready\"] [data-seat-admin-toggle=\"workspace\"]:not([disabled])[aria-checked=\"false\"]"
      },
      {
        "click": "[data-home-route-pane]:not([hidden]) [data-hm-agent=\"{agent}\"] [data-seat-admin-slot=\"{agent}\"][data-seat-admin-surface=\"agent\"]:not([hidden]) [data-seat-admin=\"ready\"] [data-seat-admin-toggle=\"workspace\"]:not([disabled])[aria-checked=\"false\"]"
      }
    ],
    "ready": "dialog.sa-confirm[data-seat-admin-confirm=\"workspace\"][data-seat-admin-phase=\"confirm\"][open]:has([data-seat-admin-scope]:not([disabled])):has([data-seat-admin-duration]:not([disabled])):has([data-seat-admin-grant]:not([hidden]):not([disabled]))",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace",
      "create_agent_principal Atlas Research & Long-Running Investigations Agent"
    ]
  },
  {
    "id": "menu.member-actions",
    "kind": "view",
    "path": "/app?w={workspace}&v=people",
    "setup": [
      {
        "scroll": "[data-people-context] .pd-agent:has(button[data-pd-focus=\"row-remove-agent-{agent}\"])"
      },
      {
        "click": "[data-people-context] .pd-agent:has(button[data-pd-focus=\"row-remove-agent-{agent}\"]) summary.pd-actions-toggle"
      },
      {
        "scroll": "[data-people-context] .pd-agent:has(button[data-pd-focus=\"row-remove-agent-{agent}\"]) .pd-row-actions[open] .pd-agent-actions"
      }
    ],
    "ready": "[data-people-context] .pd-agent:has(button[data-pd-focus=\"row-remove-agent-{agent}\"]) .pd-row-actions[open] .pd-agent-actions",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace",
      "create_agent_principal Atlas Research & Long-Running Investigations Agent"
    ]
  },
  {
    "id": "dialog.people-detail",
    "kind": "dialog",
    "path": "/app?w={workspace}&v=people",
    "setup": [
      {
        "waitFor": "dialog[data-roster-dialog][open] #pd-agent-{agent}",
        "click": "#pd-agent-{agent}"
      }
    ],
    "ready": "dialog[data-roster-dialog][open] [data-people-detail]:not([hidden]) #pd-detail-title",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace",
      "create_agent_principal Atlas Research & Long-Running Investigations Agent"
    ]
  },
  {
    "id": "dialog.people-admin-access",
    "kind": "dialog",
    "path": "/app?w={workspace}&v=people",
    "setup": [
      {
        "waitFor": "dialog[data-roster-dialog][open] #pd-agent-{agent}",
        "click": "#pd-agent-{agent}"
      },
      {
        "waitFor": "[data-people-detail] [data-seat-admin-toggle=\"workspace\"]:not([disabled])",
        "click": "[data-people-detail] [data-seat-admin-toggle=\"workspace\"]"
      }
    ],
    "ready": "dialog.sa-confirm[data-seat-admin-confirm=\"workspace\"][open] [data-seat-admin-grant]",
    "states": [
      "dense"
    ],
    "requiresSeed": [
      "create_workspace",
      "create_agent_principal Atlas Research & Long-Running Investigations Agent"
    ]
  }
]
