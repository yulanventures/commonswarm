# build output
dist/
# Per-provider-state builds from scripts/provider-fixtures.ts. Rebuilt by the test suite in
# about two seconds each; never deployed.
dist-providers/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
.vercel

# Generated by `npm run sync:installer` from the repo-root install.sh, which is the
# single source of truth. Committing the copy invites the two drifting apart, and the
# one people actually run would be whichever was published last.
public/install.sh

# Generated by `npm run sync:auth-email` from emails/. Self-hosted GoTrue fetches these as its
# custom email templates (GOTRUE_MAILER_TEMPLATES_*), so the published copy is always the
# rendered source, never a hand-edited file.
public/auth-email/
