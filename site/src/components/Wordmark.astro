---
/* Shared app identity: a person circle and an outlined agent square.
 * The app header uses hm-rail__mark; preserve that geometry in the public lockup. */

interface Props {
  href?: string;
  markSize?: number;
  /** Accessible name for a mark-only placement. */
  label?: string;
  /** Render the mark alone (no visible word). */
  markOnly?: boolean;
  class?: string;
}

const { href, markSize, label, markOnly = false, class: klass = "" } = Astro.props;

const Tag = href ? "a" : "span";
const sized = typeof markSize === "number";
---

<Tag
  class:list={["wm", { "wm--sized": sized, "wm--mark-only": markOnly }, klass]}
  href={href}
  aria-label={markOnly ? (label ?? "CommonSwarm home") : undefined}
  style={sized ? `--wm-mark: ${markSize}px` : undefined}
>
  <span class="wm__mark hm-rail__mark" aria-hidden="true"></span>
  {!markOnly && <span class="wm__word">CommonSwarm</span>}
</Tag>

<style>
  .wm {
    --wm-mark: 32px;
    min-block-size: 44px;
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: opacity var(--dur-2) var(--ease-standard);
  }

  /* Only an <a> is interactive, so a plain <span> wordmark never picks up a hover. */
  a.wm:hover {
    color: var(--text);
    opacity: 0.8;
  }

  .wm__mark {
    flex: none;
    inline-size: var(--wm-mark);
    block-size: var(--wm-mark);
  }

  .wm__mark {
    position: relative;
  }

  .wm__mark::before,
  .wm__mark::after {
    content: "";
    position: absolute;
    inline-size: 56%;
    block-size: 56%;
  }

  .wm__mark::before {
    inset: 6% auto auto 6%;
    border-radius: 50%;
    background: var(--accent);
  }

  .wm__mark::after {
    inset: auto 6% 6% auto;
    border: 2px solid currentColor;
    border-radius: 30%;
    box-sizing: border-box;
  }

  .wm__word {
    white-space: nowrap;
  }

  /* Phone lockup. A fixed markSize (the footer) keeps its own size. */
  @media (max-width: 47.999rem) {
    .wm {
      gap: 8px;
      font-size: 1.125rem;
      line-height: 1.5rem;
    }

    .wm:not(.wm--sized) {
      --wm-mark: 26px;
    }
  }
</style>
