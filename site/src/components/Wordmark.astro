---
/* Shared wordmark. The original five-circle SVG and lockup remain the app default.
 * Public marketing explicitly opts into the person-circle / agent-square mark.
 * Mark-only non-links are named images; links retain their existing home label.
 * Explicit whitespace around the conditional preserves the app default HTML byte for byte. */

interface Props {
  /** Public-site mark; the app keeps the original default. */
  marketing?: boolean;
  href?: string;
  markSize?: number;
  /** Accessible name for a mark-only placement. */
  label?: string;
  /** Render the mark alone (no visible word). */
  markOnly?: boolean;
  class?: string;
}

const { marketing = false, href, markSize, label, markOnly = false, class: klass = "" } = Astro.props;

const Tag = href ? "a" : "span";
const sized = typeof markSize === "number";
---

<Tag
  class:list={["wm", { "wm--sized": sized, "wm--mark-only": markOnly, "wm--marketing": marketing }, klass]}
  href={href}
  role={!href && markOnly ? "img" : undefined}
  aria-label={markOnly ? (href ? (label ?? "CommonSwarm home") : "CommonSwarm") : undefined}
  style={sized ? `--wm-mark: ${markSize}px` : undefined}
>
  {'\n  '}{marketing ? (
    <span class="wm__mark" aria-hidden="true"></span>
  ) : (
  <svg class="wm__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <circle cx="24" cy="24" r="5.5" style="fill: var(--mark-center)"></circle>
    <circle cx="24" cy="8" r="5.5" fill="#B8ADF2"></circle>
    <circle cx="40" cy="24" r="5.5" fill="#F3B89D"></circle>
    <circle cx="24" cy="40" r="5.5" fill="#AACBB7"></circle>
    <circle cx="8" cy="24" r="5.5" style="fill: var(--mark-west)"></circle>
  </svg>
  )}{'\n  '}
  {!markOnly && <span class="wm__word">CommonSwarm</span>}
</Tag>

<style>
  .wm {
    --wm-mark: 32px;
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: opacity var(--dur-2) var(--ease-standard);
  }

  /* Only an <a> is interactive, so a plain <span> wordmark never picks up a hover. */
  a.wm:hover {
    color: var(--text);
    opacity: 0.8;
  }

  .wm__mark {
    flex: none;
    inline-size: var(--wm-mark);
    block-size: var(--wm-mark);
  }

  /* Marketing alone uses the person circle and outlined agent square.
     Keep the app's default lockup declarations and SVG unchanged. */
  .wm--marketing {
    min-block-size: 44px;
  }

  .wm--marketing .wm__mark {
    position: relative;
  }

  .wm--marketing .wm__mark::before,
  .wm--marketing .wm__mark::after {
    content: "";
    position: absolute;
    inline-size: 56%;
    block-size: 56%;
  }

  .wm--marketing .wm__mark::before {
    inset: 6% auto auto 6%;
    border-radius: 50%;
    background: var(--accent);
  }

  .wm--marketing .wm__mark::after {
    inset: auto 6% 6% auto;
    border: 2px solid currentColor;
    border-radius: 30%;
    box-sizing: border-box;
  }

  .wm__word {
    white-space: nowrap;
  }

  /* Phone lockup. A fixed markSize (the footer) keeps its own size. */
  @media (max-width: 47.999rem) {
    .wm {
      gap: 8px;
      font-size: 1.125rem;
      line-height: 1.5rem;
    }

    .wm:not(.wm--sized) {
      --wm-mark: 26px;
    }
  }
</style>
