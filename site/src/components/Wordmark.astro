---
/* Shared CommonSwarm wordmark. */

interface Props {
  /** Apply public-site spacing. */
  marketing?: boolean;
  href?: string;
  markSize?: number;
  /** Accessible name for a mark-only placement. */
  label?: string;
  /** Render the mark alone (no visible word). */
  markOnly?: boolean;
  class?: string;
}

const { marketing = false, href, markSize, label, markOnly = false, class: klass = "" } = Astro.props;

const Tag = href ? "a" : "span";
const sized = typeof markSize === "number";
---

<Tag
  class:list={["wm", { "wm--sized": sized, "wm--mark-only": markOnly, "wm--marketing": marketing }, klass]}
  href={href}
  role={!href && markOnly ? "img" : undefined}
  aria-label={markOnly ? (href ? (label ?? "CommonSwarm home") : "CommonSwarm") : undefined}
  style={sized ? `--wm-mark: ${markSize}px` : undefined}
>
  <svg class="wm__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M22.6 8.15a9.7 9.7 0 1 0 0 15.7" fill="none" stroke="currentColor" stroke-width="4.8" stroke-linecap="round"></path>
    <rect x="18.35" y="11.4" width="9.2" height="9.2" rx="2.35" fill="#BA3D23"></rect>
  </svg>
  {!markOnly && <span class="wm__word">CommonSwarm</span>}
</Tag>

<style>
  .wm {
    --wm-mark: 32px;
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: opacity var(--dur-2) var(--ease-standard);
  }

  /* Only an <a> is interactive, so a plain <span> wordmark never picks up a hover. */
  a.wm:hover {
    color: var(--text);
    opacity: 0.8;
  }

  .wm__mark {
    flex: none;
    inline-size: var(--wm-mark);
    block-size: var(--wm-mark);
  }

  .wm--marketing { min-block-size: 44px; }

  .wm__word {
    white-space: nowrap;
  }

  /* Phone lockup. A fixed markSize (the footer) keeps its own size. */
  @media (max-width: 47.999rem) {
    .wm {
      gap: 8px;
      font-size: 1.125rem;
      line-height: 1.5rem;
    }

    .wm:not(.wm--sized) {
      --wm-mark: 26px;
    }
  }
</style>
