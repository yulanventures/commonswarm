---
/*
 * Wordmark — the CommonSwarm mark and word, in one place (Daylight Orbs, 2026-10-01).
 *
 * The mark is five disjoint circles on a 48 x 48 grid, radius 5.5 each: an ink centre at
 * (24,24) and four satellites — lavender north, peach east, sage south, cobalt west — with a
 * 5-unit gap to the centre. It is drawn here and nowhere else; favicon.svg, the app icon and
 * the social card copy the same geometry, so change all four together.
 *
 * The four satellite hues are brand literals (they do not change by mode). The centre and
 * the west satellite read --mark-center and --mark-west, which tokens.css flips in dark mode
 * to the light ink and the pale cobalt, as the brand's monochrome rule asks. No outlines,
 * orbit lines or blur inside the mark, at any size.
 *
 * Lockups: 32px mark, 10px gap, 22/28 Plus Jakarta Sans 600 at -0.04em in the bar; 26px
 * mark, 8px gap, 18/24 on phones. `markSize` sets a fixed mark size for other placements.
 *
 * Accessible name: when this is a link, the visible word "CommonSwarm" names it and the SVG
 * is hidden. A mark-only link must pass `label` (e.g. "CommonSwarm home").
 *
 * 320px: the bar holds the lockup, a compact CTA and the menu button. SiteHeader drops the
 * CTA (it is repeated in the menu sheet) before this word is ever allowed to wrap or shrink
 * below the mobile lockup; `white-space: nowrap` keeps "CommonSwarm" one word.
 */

interface Props {
  href?: string;
  markSize?: number;
  /** Accessible name for a mark-only placement. */
  label?: string;
  /** Render the mark alone (no visible word). */
  markOnly?: boolean;
  class?: string;
}

const { href, markSize, label, markOnly = false, class: klass = "" } = Astro.props;

const Tag = href ? "a" : "span";
const sized = typeof markSize === "number";
---

<Tag
  class:list={["wm", { "wm--sized": sized, "wm--mark-only": markOnly }, klass]}
  href={href}
  aria-label={markOnly ? (label ?? "CommonSwarm home") : undefined}
  style={sized ? `--wm-mark: ${markSize}px` : undefined}
>
  <svg class="wm__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <circle cx="24" cy="24" r="5.5" style="fill: var(--mark-center)"></circle>
    <circle cx="24" cy="8" r="5.5" fill="#B8ADF2"></circle>
    <circle cx="40" cy="24" r="5.5" fill="#F3B89D"></circle>
    <circle cx="24" cy="40" r="5.5" fill="#AACBB7"></circle>
    <circle cx="8" cy="24" r="5.5" style="fill: var(--mark-west)"></circle>
  </svg>
  {!markOnly && <span class="wm__word">CommonSwarm</span>}
</Tag>

<style>
  .wm {
    --wm-mark: 32px;
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: opacity var(--dur-2) var(--ease-standard);
  }

  /* Only an <a> is interactive, so a plain <span> wordmark never picks up a hover. */
  a.wm:hover {
    color: var(--text);
    opacity: 0.8;
  }

  .wm__mark {
    flex: none;
    inline-size: var(--wm-mark);
    block-size: var(--wm-mark);
  }

  .wm__word {
    white-space: nowrap;
  }

  /* Phone lockup. A fixed markSize (the footer) keeps its own size. */
  @media (max-width: 47.999rem) {
    .wm {
      gap: 8px;
      font-size: 1.125rem;
      line-height: 1.5rem;
    }

    .wm:not(.wm--sized) {
      --wm-mark: 26px;
    }
  }
</style>
