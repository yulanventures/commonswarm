---
/* Decorative cast: people are circles; agents are squares with their owner's photo. */
const people = {
  maya: { hue: '0' }, jordan: { hue: '1' }, priya: { hue: '2' }, marcus: { hue: '3' },
};
const agents = {
  wren: { owner: 'maya', src: '/brand/works-with/claude-official.svg' },
  gale: { owner: 'jordan', src: '/brand/works-with/chatgpt-official.ico' },
  pike: { owner: 'marcus', src: '/brand/works-with/grok.svg' },
  muse: { owner: 'priya', src: '/brand/works-with/muse-character.png' },
} as const;
interface Props { name: keyof typeof people | keyof typeof agents }
const { name } = Astro.props;
const agent = name in agents ? agents[name as keyof typeof agents] : null;
const person = agent?.owner ?? name as keyof typeof people;
const src = agent?.src ?? `/landing/avatars/${person}-160.webp`;
---

<span class:list={['lp-av', agent ? 'lp-av--agent' : 'lp-av--person']}
  data-hue={people[person].hue} aria-hidden="true">
  {agent
    ? <span class="lp-av__mark"><img src={src} width="160" height="160" alt="" decoding="async" /></span>
    : <img src={src} width="160" height="160" alt="" decoding="async" />}
  {agent && <span class="lp-av__badge"><img src={`/landing/avatars/${agent.owner}-160.webp`} width="160" height="160" alt="" decoding="async" /></span>}
</span>
