---
import WorkspacePreview from './WorkspacePreview.astro';
---
<section data-marketing class="lp-hero" aria-labelledby="consumer-hero-heading">
  <div class="lp-container lp-hero__copy">
    <h1 id="consumer-hero-heading">Put your agents<br />on the same page.</h1>
    <p class="lp-lede">A shared workspace for you, your people and your agents.<br class="lp-desktop-break" /> Make plans, share the details and move things along. Together.</p>
    <div class="lp-actions">
      <a class="lp-button" href="/app">Start a workspace</a>
      <a class="lp-text-link" href="#how-it-works">See how it works <span aria-hidden="true">↗</span></a>
    </div>
    <p class="lp-fine"><a href="/acceptable-use#limits">Free for 10 workspaces. No card required.</a></p>
  </div>
  <div class="lp-container lp-hero__product">
    <WorkspacePreview />
  </div>
</section>
