    <path class="th s-ink hm-flow hm-flow--slow" d="M40 18 V 186" />
    {[
      { y: 26, c: 'coral', w: 176, t: 'Taking the school forms' },
      { y: 72, c: 'blue', w: 150, t: 'Taking groceries' },
      { y: 118, c: 'gold', w: 196, t: 'Checking the pantry list' },
      { y: 164, c: 'teal', w: 164, t: 'Sharing receipts' },
    ].map((row) => (
      <g>
        <circle cx="40" cy={row.y + 12} r="8" class={`f-${row.c}`} />
        <circle cx="40" cy={row.y + 12} r="13" fill="none" class={`s-${row.c}`} stroke-width="1.5" opacity=".45" />
        <rect x="64" y={row.y} width={row.w + 40} height="26" rx="13" class="f-card edge" />
        <text x="80" y={row.y + 17} class="f-text" font-size="11.5" font-weight="600" style="font-family: var(--font-sans)">{row.t}</text>
      </g>
    ))}
    <g transform="translate(300 60)">
      <rect x="-26" y="-18" width="62" height="36" rx="10" class="f-paper edge" />
      <path d="M-12 0 h22 M-12 -7 h30 M-12 7 h16" class="s-line" stroke-width="2.5" stroke-linecap="round" />
      <path d="M26 -26 l10 -10" class="s-coral" stroke-width="3" stroke-linecap="round" />
      <circle cx="38" cy="-38" r="5" class="f-coral" />
