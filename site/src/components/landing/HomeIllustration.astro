---
/*
 * Original homepage illustrations. Every drawing reuses the page motif: coloured threads
 * (one per agent), knots where they meet, and warm paper cards. They are decorative, so each
 * SVG is aria-hidden and the surrounding heading and paragraph carry the meaning.
 *
 * Colours come from the thread classes in src/styles/home.css (`s-*` strokes, `f-*` fills),
 * so light and dark mode follow the tokens with no second set of values here.
 *
 * SVG text is read by the homepage copy observer like any other text in <main>, so keep it
 * to short labels.
 */

interface Props {
  name:
    | 'open'
    | 'prompt'
    | 'steer'
    | 'signals'
    | 'files'
    | 'notes'
    | 'invite'
    | 'household'
    | 'books'
    | 'team'
    | 'weave'
    | 'knot'
    | 'icon-house'
    | 'icon-key'
    | 'icon-eye';
  class?: string;
}

const { name, class: extra } = Astro.props;
const cls = ['hm-illo', extra].filter(Boolean).join(' ');
---

{name === 'open' && (
  <svg class={cls} viewBox="0 0 320 190" aria-hidden="true">
    <path class="th s-coral hm-flow" d="M0 60 C 40 60, 50 92, 86 92" />
    <path class="th s-blue hm-flow hm-flow--rev" d="M320 128 C 280 128, 270 104, 234 104" />
    <rect x="86" y="22" width="148" height="150" rx="18" class="f-card edge" />
    <rect x="86" y="22" width="148" height="34" rx="18" class="f-line" />
    <rect x="86" y="44" width="148" height="12" class="f-line" />
    <circle cx="106" cy="39" r="5" class="f-coral" />
    <rect x="118" y="35" width="56" height="8" rx="4" class="f-muted" opacity=".55" />
    <g>
      <rect x="102" y="70" width="116" height="24" rx="12" class="f-paper edge" />
      <circle cx="116" cy="82" r="5" class="f-coral" />
      <text x="128" y="86.5" class="f-text" font-size="11" font-weight="600" style="font-family: var(--font-sans)">Home</text>
    </g>
    <g>
      <rect x="102" y="102" width="116" height="24" rx="12" class="f-paper edge" />
      <circle cx="116" cy="114" r="5" class="f-teal" />
      <text x="128" y="118.5" class="f-text" font-size="11" font-weight="600" style="font-family: var(--font-sans)">Work</text>
    </g>
    <g>
      <rect x="102" y="134" width="116" height="24" rx="12" class="f-paper edge" />
      <circle cx="116" cy="146" r="5" class="f-blue" />
      <text x="128" y="150.5" class="f-text" font-size="11" font-weight="600" style="font-family: var(--font-sans)">The trip</text>
    </g>
    <circle cx="234" cy="22" r="15" class="f-ink" />
    <path d="M234 15v14M227 22h14" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
  </svg>
)}

{name === 'prompt' && (
  <svg class={cls} viewBox="0 0 320 190" aria-hidden="true">
    <rect x="18" y="34" width="140" height="122" rx="16" class="f-card edge" />
    <rect x="34" y="52" width="58" height="8" rx="4" class="f-ink" />
    <rect x="34" y="70" width="106" height="6" rx="3" class="f-muted" opacity=".4" />
    <rect x="34" y="84" width="96" height="6" rx="3" class="f-muted" opacity=".4" />
    <rect x="34" y="98" width="102" height="6" rx="3" class="f-muted" opacity=".4" />
    <rect x="34" y="112" width="70" height="6" rx="3" class="f-muted" opacity=".4" />
    <rect x="34" y="130" width="52" height="14" rx="7" class="f-coral" />
    <path class="th th--fat s-coral hm-flow" d="M158 95 C 196 95, 196 60, 232 70" />
    <path class="th s-gold hm-flow hm-flow--slow" d="M158 112 C 200 112, 204 140, 236 128" />
    <circle cx="262" cy="96" r="44" class="f-paper edge" />
    <circle cx="262" cy="96" r="44" fill="none" class="s-coral" stroke-width="3" stroke-dasharray="4 7" />
    <path d="M262 74 l5 15 15 5 -15 5 -5 15 -5 -15 -15 -5 15 -5z" class="f-coral" />
    <circle cx="290" cy="64" r="6" class="f-teal hm-pulse" />
  </svg>
)}

{name === 'steer' && (
