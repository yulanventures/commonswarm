    <path d="M22 44 h66 v124 l-8 -6 -8 6 -8 -6 -8 6 -8 -6 -8 6 -8 -6 -8 6z" class="f-paper edge" transform="rotate(-6 55 106)" />
    <g transform="rotate(-6 55 106)">
      <rect x="32" y="58" width="36" height="6" rx="3" class="f-text" />
      <rect x="32" y="74" width="46" height="4" rx="2" class="f-muted" opacity=".45" />
      <rect x="32" y="84" width="38" height="4" rx="2" class="f-muted" opacity=".45" />
      <rect x="32" y="94" width="42" height="4" rx="2" class="f-muted" opacity=".45" />
      <rect x="32" y="116" width="44" height="8" rx="4" class="f-teal" />
