    <path class="th s-teal hm-flow" d="M190 75 C 210 75, 210 117, 230 117" />
    <path class="th s-blue hm-flow hm-flow--rev" d="M190 117 C 210 117, 210 159, 230 159" />
    <circle cx="44" cy="68" r="4" class="f-coral" />
    <circle cx="142" cy="68" r="4" class="f-teal" />
    <circle cx="142" cy="110" r="4" class="f-blue" />
    <circle cx="240" cy="110" r="4" class="f-gold" />
  </svg>
)}

{name === 'weave' && (
  <svg class={cls} viewBox="0 0 600 300" aria-hidden="true">
    {['coral', 'gold', 'teal', 'blue', 'plum', 'coral', 'teal'].map((c, i) => (
      <path class={`th s-${c} hm-flow${i % 2 ? ' hm-flow--rev' : ''}`} d={`M0 ${40 + i * 34} C 150 ${-20 + i * 46}, 300 ${120 + i * 18}, 600 ${20 + i * 40}`} />
    ))}
  </svg>
)}

{name === 'knot' && (
  <svg class={cls} viewBox="0 0 480 140" aria-hidden="true">
    <path class="th s-coral hm-flow" d="M0 30 C 120 30, 180 70, 240 70" />
    <path class="th s-teal hm-flow" d="M0 110 C 120 110, 180 70, 240 70" />
    <path class="th s-blue hm-flow hm-flow--rev" d="M480 30 C 360 30, 300 70, 240 70" />
    <path class="th s-gold hm-flow hm-flow--rev" d="M480 110 C 360 110, 300 70, 240 70" />
    <circle cx="240" cy="70" r="26" class="f-card edge" />
    <circle cx="240" cy="70" r="26" fill="none" class="s-ink" stroke-width="3" stroke-dasharray="5 6" />
