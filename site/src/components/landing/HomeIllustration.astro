    <rect x="62" y="30" width="104" height="132" rx="10" class="f-card edge" transform="rotate(4 114 96)" />
    <path d="M96 22 h74 v150 l-9 -7 -9 7 -9 -7 -9 7 -9 -7 -9 7 -9 -7 -9 7 -2 -1z" class="f-paper edge" />
