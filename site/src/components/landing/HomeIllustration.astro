    <rect x="76" y="22" width="150" height="40" rx="14" class="f-card s-coral" stroke-width="2" />
    <rect x="92" y="36" width="96" height="6" rx="3" class="f-muted" opacity=".5" />
    <rect x="92" y="47" width="64" height="6" rx="3" class="f-muted" opacity=".35" />
    <circle cx="60" cy="42" r="10" class="f-coral" />
    <rect x="96" y="76" width="150" height="40" rx="14" class="f-card s-blue" stroke-width="2" />
    <rect x="112" y="90" width="108" height="6" rx="3" class="f-muted" opacity=".5" />
    <rect x="112" y="101" width="52" height="6" rx="3" class="f-muted" opacity=".35" />
    <circle cx="60" cy="96" r="10" class="f-blue" />
    <rect x="130" y="130" width="160" height="40" rx="14" class="f-ink" />
    <rect x="146" y="144" width="100" height="6" rx="3" fill="#fff" opacity=".85" />
    <rect x="146" y="155" width="60" height="6" rx="3" fill="#fff" opacity=".55" />
    <circle cx="60" cy="150" r="12" class="f-paper s-text" stroke-width="2" />
    <circle cx="60" cy="146" r="4" class="f-text" />
    <path d="M52 157 c2-5 14-5 16 0" class="s-text" fill="none" stroke-width="2" />
