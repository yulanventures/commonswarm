{name === 'team' && (
  <svg class={cls} viewBox="0 0 320 200" aria-hidden="true">
    {[24, 122, 220].map((x) => (
      <rect x={x} y="24" width="78" height="160" rx="14" class="f-paper edge" />
    ))}
    <rect x="34" y="38" width="40" height="7" rx="3.5" class="f-text" opacity=".75" />
    <rect x="132" y="38" width="46" height="7" rx="3.5" class="f-text" opacity=".75" />
    <rect x="230" y="38" width="34" height="7" rx="3.5" class="f-text" opacity=".75" />
    <rect x="34" y="58" width="58" height="34" rx="8" class="f-card s-coral" stroke-width="2" />
    <rect x="34" y="100" width="58" height="34" rx="8" class="f-card edge" />
    <rect x="132" y="58" width="58" height="34" rx="8" class="f-card s-teal" stroke-width="2" />
