    <rect x="84" y="42" width="70" height="8" rx="4" class="f-text" />
    <rect x="84" y="62" width="96" height="5" rx="2.5" class="f-muted" opacity=".45" />
    <rect x="84" y="74" width="84" height="5" rx="2.5" class="f-muted" opacity=".45" />
    <rect x="84" y="86" width="92" height="5" rx="2.5" class="f-muted" opacity=".45" />
    <rect x="84" y="108" width="60" height="5" rx="2.5" class="f-muted" opacity=".45" />
