)}

{name === 'books' && (
  <svg class={cls} viewBox="0 0 320 200" aria-hidden="true">
    <rect x="96" y="22" width="190" height="160" rx="16" class="f-card edge" />
    <rect x="96" y="22" width="190" height="34" rx="16" class="f-line" />
    <rect x="96" y="44" width="190" height="12" class="f-line" />
    <rect x="112" y="34" width="60" height="8" rx="4" class="f-text" />
