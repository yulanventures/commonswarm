)}

{name === 'icon-house' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true">
    <path d="M4 11 12 4l8 7v9H4z" fill="none" class="s-coral" stroke-width="2" stroke-linejoin="round" />
    <path d="M10 20v-5h4v5" fill="none" class="s-coral" stroke-width="2" stroke-linejoin="round" />
  </svg>
)}

{name === 'icon-key' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="8" cy="12" r="4" fill="none" class="s-teal" stroke-width="2" />
    <path d="M12 12h9M18 12v3M21 12v2" fill="none" class="s-teal" stroke-width="2" stroke-linecap="round" />
  </svg>
)}

{name === 'icon-eye' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true">
    <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12z" fill="none" class="s-blue" stroke-width="2" stroke-linejoin="round" />
