      <g>
        <rect x="112" y={row.y} width={row.w} height="14" rx="7" class={`f-${row.c}`} opacity=".9" />
        <rect x={120 + row.w} y={row.y + 4} width="60" height="6" rx="3" class="f-muted" opacity=".4" />
