      <circle cx="244" cy="70" r="10" class="f-blue" />
      <circle cx="316" cy="70" r="10" class="f-gold" />
    </g>
    <path class="th th--fat s-ink hm-flow" d="M142 100 C 170 70, 190 130, 218 100" />
    <g transform="translate(180 100)">
      <rect x="-30" y="-15" width="60" height="30" rx="15" class="f-card edge" />
      <path d="M-12 0 a6 6 0 0 1 6 -6 h6 M12 0 a6 6 0 0 1 -6 6 h-6 M-6 0 h12" class="s-ink" fill="none" stroke-width="2.4" stroke-linecap="round" />
    </g>
  </svg>
