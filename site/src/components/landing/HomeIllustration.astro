{name === 'household' && (
  <svg class={cls} viewBox="0 0 320 200" aria-hidden="true">
    <path d="M70 92 L160 26 L250 92 V184 H70Z" class="f-paper edge" stroke-linejoin="round" />
    <path d="M58 98 L160 22 L262 98" class="s-coral" fill="none" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="212" y="40" width="18" height="34" rx="3" class="f-card edge" />
    <rect x="94" y="104" width="44" height="36" rx="8" class="f-card edge" />
    <rect x="182" y="104" width="44" height="36" rx="8" class="f-card edge" />
    <rect x="140" y="140" width="40" height="44" rx="10" class="f-ink" />
    <circle cx="170" cy="164" r="3" fill="#fff" />
    <circle cx="116" cy="122" r="8" class="f-coral" />
    <circle cx="204" cy="122" r="8" class="f-blue" />
    <circle cx="160" cy="70" r="12" class="f-card edge" />
    <circle cx="160" cy="70" r="5" class="f-gold hm-pulse" />
    <path class="th th--thin s-coral hm-flow" d="M116 114 C 116 90, 140 76, 152 72" />
    <path class="th th--thin s-blue hm-flow" d="M204 114 C 204 90, 180 76, 168 72" />
    <path class="th s-teal hm-flow hm-flow--slow" d="M10 184 C 40 150, 52 196, 70 170" />
    <path class="th s-gold hm-flow hm-flow--slow" d="M310 184 C 280 150, 268 196, 250 170" />
