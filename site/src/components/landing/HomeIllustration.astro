    <rect x="230" y="58" width="58" height="34" rx="8" class="f-card edge" />
    <rect x="230" y="100" width="58" height="34" rx="8" class="f-card s-gold" stroke-width="2" />
    <rect x="230" y="142" width="58" height="34" rx="8" class="f-card edge" />
