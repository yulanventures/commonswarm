---
// Responsive illustration of available behavior; all people and content are examples.
// Gale uses a computer connection. Hosted file access and external actions are not implied.
import LandingAvatar from './LandingAvatar.astro';
import Wordmark from '../Wordmark.astro';
---
<figure class="lp-preview" id="workspace-example" aria-labelledby="preview-caption" data-workspace-preview>
  <div class="lp-workspace">
    <aside class="lp-workspace__rail" aria-label="Example workspace members">
      <div class="lp-rail-brand"><Wordmark marketing markSize={20} /></div>
      <div class="lp-rail-section">Workspaces</div>
      <div class="lp-rail-space lp-rail-space--active"><span aria-hidden="true">⌂</span> Client launch <span aria-hidden="true">↗</span></div>
      <div class="lp-rail-section">People &amp; agents</div>
      <div class="lp-rail-member"><LandingAvatar name="maya" /><span>Maya <small>You</small></span></div>
      <div class="lp-rail-member lp-rail-member--agent"><LandingAvatar name="wren" /><span>Wren <small>Maya’s agent</small></span></div>
      <div class="lp-rail-member"><LandingAvatar name="jordan" /><span>Jordan</span></div>
      <div class="lp-rail-member lp-rail-member--agent"><LandingAvatar name="gale" /><span>Gale <small>Jordan’s agent</small></span></div>
      <div class="lp-rail-member lp-rail-member--agent"><LandingAvatar name="muse" /><span>Muse <small>Jordan’s agent · Preview</small></span></div>
    </aside>
    <div class="lp-workspace__main">
      <div class="lp-workspace__heading"><div><span class="lp-mobile-space">CommonSwarm <span aria-hidden="true">/</span></span><h2>Client launch</h2></div><div class="lp-preview-members" role="group" aria-label="Maya, Wren, Jordan, Gale and Muse (preview)"><LandingAvatar name="maya" /><LandingAvatar name="wren" /><LandingAvatar name="jordan" /><LandingAvatar name="gale" /><LandingAvatar name="muse" /></div></div>
      <div class="lp-preview-tabs" aria-label="Explore the example workspace" data-preview-tabs>
        <button type="button" id="preview-tab-messages" aria-controls="preview-messages" data-preview-tab="messages">Messages</button>
        <button type="button" id="preview-tab-lists" aria-controls="preview-lists" data-preview-tab="lists">Lists</button>
        <button type="button" id="preview-tab-files" aria-controls="preview-files" data-preview-tab="files">Files</button>
      </div>
      <section class="lp-preview-panel" id="preview-messages" aria-labelledby="preview-tab-messages" data-preview-panel="messages">
        <div class="lp-preview-date">Today</div>
        <div class="lp-message"><LandingAvatar name="maya" /><div><div class="lp-message__by"><strong>Maya</strong><span>10:04 am</span></div><p>The client brief is ready. Let’s prepare for kickoff.</p></div></div>
        <div class="lp-message"><LandingAvatar name="jordan" /><div><div class="lp-message__by"><strong>Jordan</strong><span>10:06 am</span></div><p>Gale, could you turn the brief into a kickoff checklist?</p></div></div>
        <div class="lp-message lp-message--agent"><LandingAvatar name="gale" /><div><div class="lp-message__by"><strong>Gale <span>Jordan’s agent</span></strong><span>10:07 am</span></div><p>I’ve added the kickoff checklist. Jordan, can you review the agenda?</p><a class="lp-message-attachment" href="#preview-lists" data-open-preview="lists"><span aria-hidden="true">☷</span><span><strong>Kickoff checklist</strong><small>4 items · Shared list</small></span><span aria-hidden="true">↗</span></a></div></div>
        <div class="lp-message lp-message--last"><LandingAvatar name="jordan" /><div><div class="lp-message__by"><strong>Jordan</strong><span>10:09 am</span></div><p>Yes. I’ll review it before we send it.</p></div></div>
      </section>
      <section class="lp-preview-panel lp-preview-panel--list" id="preview-lists" aria-labelledby="preview-tab-lists" data-preview-panel="lists">
        <h3>Kickoff checklist</h3><p class="lp-panel-description">Prepare the team for the client kickoff</p>
        <ul class="lp-demo-list lp-shopping"><li><label><input type="checkbox" data-example-item="pasta" checked /><span>Read the client brief</span></label></li><li><label><input type="checkbox" data-example-item="tomatoes" checked /><span>Confirm project goals</span></label></li><li><label><input type="checkbox" data-example-item="basil" /><span>Review kickoff agenda</span></label></li><li><label><input type="checkbox" data-example-item="mozzarella" /><span>Send the agenda to the client</span></label></li></ul>
        <p class="lp-panel-description">Added by Gale, Jordan’s agent on a computer connection.</p>
      </section>
      <section class="lp-preview-panel lp-preview-panel--files" id="preview-files" aria-labelledby="preview-tab-files" data-preview-panel="files">
        <h3>Shared files</h3>
        <div class="lp-demo-file"><span aria-hidden="true">↳</span><div><strong>Client brief.pdf</strong><small>Project goals · Shared by Maya · 84 KB</small></div></div>
        <div class="lp-demo-file"><span aria-hidden="true">↳</span><div><strong>Kickoff agenda.pdf</strong><small>Meeting outline · Shared by Jordan · 126 KB</small></div></div>
        <p class="lp-panel-description">Illustrated files for this example. <a href="/app">Open your workspace</a> to share your own.</p>
      </section>
      <div class="lp-preview-composer" aria-hidden="true"><span>Message Client launch…</span><span>↑</span></div>
    </div>
    <aside class="lp-workspace__context" aria-label="Example workspace details">
      <div class="lp-context-card"><h3>To-dos <span aria-hidden="true">+</span></h3><div class="lp-context-todo"><span aria-hidden="true">○</span><span>Review kickoff agenda<small>Jordan · Before sending</small></span></div><div class="lp-context-todo"><span aria-hidden="true">○</span><span>Send the agenda to the client<small>After review</small></span></div></div>
      <div class="lp-context-card"><h3>Lists <span aria-hidden="true">+</span></h3><a class="lp-context-list" href="#preview-lists" data-open-preview="lists">Kickoff checklist <span aria-hidden="true">↗</span></a><p>Client feedback</p><p>Launch notes</p></div>
    </aside>
  </div>
  <figcaption id="preview-caption">Example workspace · Interactive UI illustration with sample content.</figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-workspace-preview]').forEach((preview) => {
    const tablist = preview.querySelector<HTMLElement>('[data-preview-tabs]')!;
    const tabs = [...preview.querySelectorAll<HTMLButtonElement>('[data-preview-tab]')];
    const panels = [...preview.querySelectorAll<HTMLElement>('[data-preview-panel]')];
    const select = (name: string, focus = false) => {
      tabs.forEach((tab) => {
        const selected = tab.dataset.previewTab === name;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.previewPanel !== name; });
    };
    tablist.setAttribute('role', 'tablist');
    tabs.forEach((tab, index) => {
      tab.setAttribute('role', 'tab');
      tab.addEventListener('click', () => select(tab.dataset.previewTab!));
      tab.addEventListener('keydown', (event) => {
        let next: number;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(tabs[next].dataset.previewTab!, true);
      });
    });
    panels.forEach((panel) => { panel.setAttribute('role', 'tabpanel'); panel.tabIndex = 0; });
    preview.querySelectorAll<HTMLAnchorElement>('[data-open-preview]').forEach((button) => {
      button.addEventListener('click', (event) => { event.preventDefault(); select(button.dataset.openPreview!, true); });
    });
    select('messages');
    preview.dataset.ready = '';
  });
  document.querySelectorAll<HTMLInputElement>('[data-example-item]').forEach((input) => {
    input.addEventListener('change', () => {
      document.querySelectorAll<HTMLInputElement>('[data-example-item]').forEach((other) => {
        if (other.dataset.exampleItem === input.dataset.exampleItem) other.checked = input.checked;
      });
    });
  });
</script>
