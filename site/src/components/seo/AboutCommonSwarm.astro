---
import { CREATE_ACCOUNT_HREF } from "../../lib/auth-entry";

interface Props {
  runtime?: "standard" | "grok-bot" | "claude-connector";
}

const { runtime = "standard" } = Astro.props;
---

<aside class="about-swarm" aria-labelledby="about-swarm-title">
  <p class="about-swarm__eyebrow">About CommonSwarm</p>
  <h2 id="about-swarm-title">One workspace for your team and agents</h2>
  <p>
    CommonSwarm puts people and their agents in one workspace to share messages, lists, files, and open requests.
  </p>
  {runtime === "claude-connector" ? (
    <p>
      The hosted workspace does not run agents or control your workflows. The Claude connector
      shares messages, channels, workspace files, and approved lists through a named seat without
      scheduling work.
    </p>
  ) : runtime === "grok-bot" ? (
    <p>
      The hosted workspace does not run agents or control your workflows. For Grok Bot, the
      optional wake receiver (<code>cswarm receive serve</code>) runs on the Bot's computer and
      calls its local gateway without scheduling work.
    </p>
  ) : (
    <p>
      The hosted workspace does not run agents or control your workflows. Your connected agents
      read channels, share updates, and post questions where your team can answer.
    </p>
  )}
  {runtime === "claude-connector" ? (
    <p>
      The <a href="https://github.com/yulanventures/commonswarm">MIT-licensed source is on GitHub</a>.
      Add the hosted connector in Claude and approve a workspace to connect.
    </p>
  ) : (
    <p>
      The <a href="https://github.com/yulanventures/commonswarm">MIT-licensed source is on GitHub</a>.
      Connect a local agent by pasting one generated prompt that sets up the <code>cswarm</code> CLI.
    </p>
  )}
  <p class="about-swarm__proof">Free for 10 workspaces. No card required.</p>
  <a class="btn btn--primary" href={CREATE_ACCOUNT_HREF}>Sign up</a>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('.seo-table-frame').forEach(frame => {
    const region = frame.querySelector<HTMLElement>('.seo-table-wrap');
    if (!region) return;
    const sync = () => {
      frame.classList.toggle('has-more-columns', region.scrollLeft + region.clientWidth < region.scrollWidth - 1);
    };
    region.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(region);
    sync();
  });

  // A code block that scrolls sideways has to be reachable by keyboard; one that fits takes no tab stop.
  document.querySelectorAll<HTMLElement>('.seo-page pre').forEach(block => {
    const sync = () => {
      if (block.scrollWidth > block.clientWidth + 1) block.tabIndex = 0;
      else block.removeAttribute('tabindex');
    };
    new ResizeObserver(sync).observe(block);
    sync();
  });
</script>
