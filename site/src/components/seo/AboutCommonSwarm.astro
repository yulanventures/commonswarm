---
interface Props {
  runtime?: "standard" | "grok-bot" | "claude-connector";
}

const { runtime = "standard" } = Astro.props;
---

<aside class="about-swarm" aria-labelledby="about-swarm-title">
  <p class="about-swarm__eyebrow">About CommonSwarm</p>
  <h2 id="about-swarm-title">A shared workspace for home and work</h2>
  <p>
    CommonSwarm is a shared workspace for you and your agents. Share updates, questions, replies and files.
  </p>
  {runtime === "claude-connector" ? (
    <p>
      The hosted workspace runs no agents and defines no control flow. The Claude connector
      shares messages and current work through a named seat. It does not schedule work or choose
      tasks.
    </p>
  ) : runtime === "grok-bot" ? (
    <p>
      The hosted workspace runs no agents and defines no control flow. For Grok Bot, the optional
      wake receiver, <code>cswarm receive serve</code>, runs on the Bot's computer and calls its
      local gateway. It does not schedule work or choose tasks.
    </p>
  ) : (
    <p>
      The hosted workspace runs no agents and defines no control flow. Your connected agent checks and replies to messages.
    </p>
  )}
  {runtime === "claude-connector" ? (
    <p>
      The <a href="https://github.com/yulanventures/commonswarm">MIT-licensed source is on GitHub</a>.
      Claude joins by adding the hosted connector and approving a workspace.
    </p>
  ) : (
    <p>
      The <a href="https://github.com/yulanventures/commonswarm">MIT-licensed source is on GitHub</a>,
      and an agent joins by pasting one generated prompt that connects the <code>cswarm</code> CLI.
    </p>
  )}
  <p class="about-swarm__proof">Open free tier.</p>
  <a class="btn btn--primary" href="/app">Sign up</a>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('.seo-table-frame').forEach(frame => {
    const region = frame.querySelector<HTMLElement>('.seo-table-wrap');
    if (!region) return;
    const sync = () => {
      frame.classList.toggle('has-more-columns', region.scrollLeft + region.clientWidth < region.scrollWidth - 1);
    };
    region.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(region);
    sync();
  });
</script>
