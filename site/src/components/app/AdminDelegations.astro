---
import { ADMIN_AVAILABILITY, ADMIN_REGISTRY_VERSION, adminAvailabilityDigest } from "../../../../src/protocol/admin-policy";
import "../../styles/kylon-account-dialogs.css";
import "../../styles/kylon-seat-admin.css";
const policy = { version: ADMIN_REGISTRY_VERSION, digest: adminAvailabilityDigest(ADMIN_REGISTRY_VERSION), definitions: ADMIN_AVAILABILITY[ADMIN_REGISTRY_VERSION] };
---
<admin-delegations hidden data-kylon-account data-admin-policy={JSON.stringify(policy)}>
  <button type="button" class="admin-indicator" data-admin-indicator hidden aria-haspopup="dialog">
    <strong data-admin-indicator-title>Admin access</strong>
    <span data-admin-indicator-detail>View actions or revoke</span>
  </button>
  <dialog aria-labelledby="admin-access-title">
    <header>
      <h2 id="admin-access-title">Admin access</h2>
      <button type="button" data-admin-close aria-label="Close admin access">Close</button>
    </header>
    <nav aria-label="Admin access views">
      <button type="button" data-admin-pane="access" aria-pressed="true">Access</button>
      <button type="button" data-admin-pane="history" aria-pressed="false">History</button>
      <button type="button" data-admin-pane="clients" aria-pressed="false">Client approvals</button>
    </nav>
    <p data-admin-scope><strong data-admin-scope-name>Your account</strong> <button type="button" data-admin-scope-switch hidden>Show this workspace</button></p>
    <p role="status" aria-live="polite" data-admin-status></p>
    <p role="status" aria-live="polite" data-admin-seat-status hidden></p>
    <div data-admin-pane-body="access">
      <p data-admin-empty hidden>No active admin access is visible here.</p>
      <section aria-label="Agents with admin access" data-admin-seat-section hidden>
        <div data-admin-seat-grants></div>
        <button type="button" data-admin-seat-retry hidden>Retry</button>
      </section>
      <section aria-label="Connected clients with admin access">
        <div data-admin-grants></div>
        <button type="button" data-admin-more-grants hidden>More grants</button>
      </section>
    </div>
    <div data-admin-pane-body="history" hidden>
      <section aria-labelledby="admin-past-title">
        <h3 id="admin-past-title">Past grants</h3>
        <p data-admin-past-empty hidden>No past grants are visible here.</p>
        <div data-admin-past-seat-grants></div><div data-admin-past-grants></div>
      </section>
      <section aria-labelledby="admin-history-title">
        <h3 id="admin-history-title">Recorded actions</h3><ol data-admin-actions></ol>
        <button type="button" data-admin-more-actions hidden>Older actions</button>
      </section>
    </div>
    <div data-admin-pane-body="clients" hidden>
      <p data-admin-clients-account hidden>Client approvals belong to your whole account.</p>
      <section aria-labelledby="admin-clients-title" data-admin-client-section>
        <h3 id="admin-clients-title">Verified clients and your approvals</h3>
        <p data-admin-gate role="status">Checking admin connection availability…</p>
        <div data-admin-clients></div><button type="button" data-admin-more-clients hidden>More clients</button>
      </section>
    </div>
    <details data-admin-foot>
      <summary>More</summary>
      <button type="button" data-admin-refresh>Refresh</button>
      <section aria-labelledby="admin-dependencies-title">
        <h3 id="admin-dependencies-title">Workspace coverage and workers</h3>
        <div data-admin-dependencies></div>
        <button type="button" data-admin-more-workers hidden>More workers</button>
        <button type="button" data-admin-more-coverage hidden>More coverage</button>
      </section>
    </details>
  </dialog>
</admin-delegations>

<script>
  import type { Session } from "@supabase/supabase-js";
  import {
    bootstrapMultiAccountAuth,
    client,
    currentSession,
    isMultiAccountEnabled,
    onAccountForcedTeardown,
    onAuthChange,
    uuid,
    CommandOutcomeUnknown,
    myOrganizations,
    myWorkspaces,
  } from "../../lib/commonswarm";
  import { loadAdminRecovery, revokeAdminGrant, changeAdminClientApproval, readAdminIssuanceGate, AdminGrantRevokeRefused, AdminRecoveryReadError, type AdminGrantView, type AdminActionView, type AdminClientView, type AdminWorkerView, type AdminCoverageView } from "../../lib/admin-delegations";
  import { readSeatAdminStatus, readMySeatAdminGrants, endSeatAdmin, renderSeatAdminHistoryList, seatAdminGrantLive } from "../../lib/seat-admin";

  import { adminGateNotice, adminApprovalParts, adminClientAction, adminGrantLines, adminGrantSummary, adminRenewalDiff, ADMIN_SITE_RENEWAL_GUIDANCE, type AdminSitePolicy } from "../../lib/admin-delegations-view";
  const root = document.querySelector<HTMLElement>("admin-delegations");
  if (root) {
    const one = <T extends Element>(selector: string): T => root.querySelector<T>(selector)!;
    const policy: AdminSitePolicy = JSON.parse(root.dataset.adminPolicy!);
    const dialog = one<HTMLDialogElement>("dialog");
    let session: Session | null = null, workspaceId: string | null = document.querySelector("live-dashboard")?.getAttribute("data-admin-workspace") ?? null;
    let scope: "account" | "workspace" = "account", generation = 0;
    // The opening view answers "who has admin access now". History and client approvals are their own views.
    type Pane = "access" | "history" | "clients";
    let pane: Pane = "access";
    // True once a read has answered, so "nothing here" is never said while loading or after a refusal.
    let loaded = false, seatActive = 0, seatPast = 0;
    let workspaceNames = new Map<string, string>();
    // Each agent read and each names read carries a ticket. A refused or foreign read, or a change of person, takes a
    // new ticket, so a result still on its way is dropped and never redraws rows that were just cleared.
    let seatEpoch = 0, namesTicket = 0;
    const openMore = new Set<string>();
    const forgetNames = (): void => { ++namesTicket; workspaceNames = new Map(); };
    const clearSeats = (): void => {
      ++seatEpoch; seatBusy = false;
      one("[data-admin-seat-grants]").replaceChildren(); one("[data-admin-past-seat-grants]").replaceChildren();
      one<HTMLElement>("[data-admin-seat-section]").hidden = true; one<HTMLElement>("[data-admin-seat-retry]").hidden = true;
    };
    let grants: AdminGrantView[] = [], actions: AdminActionView[] = [];
    let clients: AdminClientView[] = [], workers: AdminWorkerView[] = [], coverage: AdminCoverageView[] = [];
    let clientsBefore: string | null = null, workersBefore: string | null = null, coverageBefore: string | null = null;
    let grantsBefore: string | null = null, actionsBefore: string | null = null;
    let busy = false;
    let seatBusy = false;
    let indicatorView: "account" | "workspace" = "account";
    const requestIds = new Map<string, string>();
    const seatEndRequestIds = new Map<string, string>();
    // A message that tells the person to refresh opens the foot More, where Refresh is, so the way out is on screen.
    const status = (message: string): void => {
      one<HTMLElement>("[data-admin-status]").textContent = message;
      if (/refresh/i.test(message)) one<HTMLDetailsElement>("[data-admin-foot]").open = true;
    };
    const seatStatus = (message: string): void => {
      const el = one<HTMLElement>("[data-admin-seat-status]");
      el.textContent = message;
      el.hidden = !message;
    };
    const clear = (): void => {
      ++generation; grants = []; actions = []; clients = []; workers = []; coverage = [];
      grantsBefore = actionsBefore = clientsBefore = workersBefore = coverageBefore = null; busy = false; seatBusy = false;
      loaded = false; seatActive = seatPast = 0; openMore.clear(); dialog.dataset.adminState = "loading";
      for (const selector of ["[data-admin-grants]", "[data-admin-past-grants]", "[data-admin-actions]", "[data-admin-clients]", "[data-admin-dependencies]", "[data-admin-seat-grants]", "[data-admin-past-seat-grants]"]) one(selector).replaceChildren();
      one<HTMLElement>("[data-admin-empty]").hidden = true; one<HTMLElement>("[data-admin-past-empty]").hidden = true;
      for (const selector of ["[data-admin-more-clients]", "[data-admin-more-workers]", "[data-admin-more-coverage]"]) one<HTMLElement>(selector).hidden = true;
      one<HTMLElement>("[data-admin-more-grants]").hidden = true; one<HTMLElement>("[data-admin-more-actions]").hidden = true;
      one<HTMLElement>("[data-admin-seat-section]").hidden = true;
      one<HTMLElement>("[data-admin-seat-retry]").hidden = true;
      seatStatus("");
      one<HTMLElement>("[data-admin-gate]").textContent = "Checking admin connection availability…";
      status("");
    };
    const text = (tag: string, content: string): HTMLElement => {
      // Server labels remain literal text, including markup supplied by users or agents.
      const element = document.createElement(tag); element.textContent = content; return element;
    };
    const gate = async (): Promise<void> => {
      const at = generation;
      one<HTMLElement>("[data-admin-gate]").textContent = "Checking admin connection availability…";
      const result = await readAdminIssuanceGate();
      if (generation === at) {
        one<HTMLElement>("[data-admin-gate]").textContent = adminGateNotice(result.state);
        if (result.state === "unavailable") one<HTMLDetailsElement>("[data-admin-foot]").open = true;
      }
    };
    const renderDiff = (g: AdminGrantView): HTMLElement => {
      const diff = adminRenewalDiff(g, policy), section = document.createElement("section");
      section.append(text("h5", diff.changed ? "Permission changes to review on renewal" : "Renewal"));
      if (diff.changed) {
        const table = document.createElement("table"), body = document.createElement("tbody");
        const header = document.createElement("tr");
        for (const label of ["Consent snapshot", "Current registry options"]) { const th = text("th", label); th.setAttribute("scope", "col"); header.append(th); }
        const head = document.createElement("thead"); head.append(header); table.append(head);
        for (const pair of [[`Registry version ${diff.priorVersion ?? "unavailable"}`, `Registry version ${diff.currentVersion}`],
          [diff.prior.join(", ") || "Snapshot unavailable", diff.current.join(", ") || "None"]]) {
          const row = document.createElement("tr"); for (const value of pair) row.append(text("td", value)); body.append(row);
        }
        table.append(body); section.append(table);
        section.append(text("p", `Added operations: ${diff.added.join(", ") || "none"}. Removed or unavailable: ${diff.removed.join(", ") || "none"}.`));
        section.append(text("p", "These current options are a comparison. They do not change this grant's approved permissions."));
        if (g.availability_digest !== policy.digest) section.append(text("p", "The permission definitions differ from this consent snapshot. Review the current options in your assistant."));
      }
      section.append(text("p", ADMIN_SITE_RENEWAL_GUIDANCE)); return section;
    };
    const render = (): void => {
      const grantRoot = one<HTMLElement>("[data-admin-grants]"); grantRoot.replaceChildren();
      const pastRoot = one<HTMLElement>("[data-admin-past-grants]"); pastRoot.replaceChildren();
      const perClient = new Map<string, number>();
      for (const g of grants) perClient.set(g.client_id, (perClient.get(g.client_id) ?? 0) + 1);
      for (const g of grants) {
        const summary = adminGrantSummary(g, policy, workspaceNames, Date.now(), (perClient.get(g.client_id) ?? 0) > 1);
        const card = document.createElement("article"); card.dataset.mode = g.mode;
        // The row carries the decision: who holds the grant, whether it is active, its reach, what it may do, when it ends.
        card.append(text("h4", g.client_id));
        for (const line of summary.lines) card.append(text("p", line));
        // Every line this card printed before stays, in the same words, one press away.
        const more = document.createElement("details"); more.dataset.adminGrantMore = g.grant_id; more.open = openMore.has(g.grant_id);
        more.addEventListener("toggle", () => { if (more.open) openMore.add(g.grant_id); else openMore.delete(g.grant_id); });
        more.append(text("summary", "More"));
        for (const line of adminGrantLines(g, policy)) more.append(text("p", line));
        more.append(renderDiff(g));
        // A revoked or expired grant is history: it is listed under Past grants and has no action.
        if (scope === "account" && g.owner_user_id === session?.user.id && !summary.past) {
          const button = document.createElement("button"); button.type = "button"; button.textContent = "Revoke grant"; button.dataset.tone = "danger"; button.disabled = busy;
          button.addEventListener("click", async () => {
            if (!session || busy) return;
            const ownSession = session, at = generation;
            const requestId = requestIds.get(g.grant_id) ?? uuid(); requestIds.set(g.grant_id, requestId);
            busy = true; render(); status("Revoking grant…");
            try {
              await revokeAdminGrant(ownSession, g.grant_id, requestId);
              if (generation !== at) return;
              // An accepted account command is a durable revoke, even if a later read fails.
              g.state = "revoked"; if (g.family) g.family.state = "revoked";
              requestIds.delete(g.grant_id); busy = false; render();
              status("The grant is revoked. Refresh to review its recorded actions.");
              await indicator();
            } catch (error) {
              if (generation !== at) return;
              if (error instanceof AdminGrantRevokeRefused) requestIds.delete(g.grant_id);
              busy = false; render(); status(error instanceof CommandOutcomeUnknown || error instanceof AdminGrantRevokeRefused ? error.message : `The revocation result is unavailable. Refresh or retry. Retry ID: ${requestId}.`);
            }
          });
          // What the action does sits beside it, and says that it ends the whole grant.
          card.append(button, text("small", "Revoking ends this whole grant and stops its dependent access. Prior actions and data already read remain."));
        }
        // Revoking is offered in the account view only, as before; a workspace view says where to find it.
        else if (scope === "workspace" && g.owner_user_id === session?.user.id && !summary.past) card.append(text("small", "To revoke this grant, show your whole account."));
        card.append(more);
        (summary.past ? pastRoot : grantRoot).append(card);
      }
      const clientRoot = one<HTMLElement>("[data-admin-clients]"); clientRoot.replaceChildren();
      one<HTMLElement>("[data-admin-client-section]").hidden = scope !== "account";
      one<HTMLElement>("[data-admin-clients-account]").hidden = scope === "account";
      const answered = loaded && !busy;
      if (answered && scope === "account" && !clients.length && clientsBefore === null) clientRoot.append(text("p", "No verified clients are visible in this view."));
      for (const c of clients) {
        const card = document.createElement("article"); card.append(text("h4", c.client_id));
        const approval = adminApprovalParts(c);
        for (const line of approval.lines) card.append(text("p", line));
        const action = session ? adminClientAction(c, session.user.id) : null;
        if (action && scope === "account") {
          const button = document.createElement("button"); button.type = "button";
          button.textContent = action === "approve" ? `Approve client version ${c.verification_version}` : "Withdraw client approval";
          if (action !== "approve") button.dataset.tone = "danger";
          button.disabled = busy;
          button.addEventListener("click", async () => {
            if (!session || busy) return;
            const ownSession = session, at = generation;
            const key = `client:${c.client_id}:${c.verification_version}:${action}`;
            const requestId = requestIds.get(key) ?? uuid(); requestIds.set(key, requestId);
            busy = true; render(); status(action === "approve" ? "Recording your client approval…" : "Withdrawing client approval…");
            try {
              await changeAdminClientApproval(ownSession, c, action, requestId);
              if (generation !== at) return;
              requestIds.delete(key);
              if (action === "withdraw") {
                for (const g of grants) if (g.client_id === c.client_id) { g.state = "revoked"; if (g.family) g.family.state = "revoked"; }
              }
              // Re-read provenance instead of inventing an approval event locally.
              clients = []; busy = false; render();
              const committed = action === "approve" ? "Your client approval was recorded." : "Your client approval was withdrawn. Linked grants and dependent access are stopped.";
              await load();
              if (generation === at + 1) status(`${committed} ${one<HTMLElement>("[data-admin-status]").textContent}`);
              void indicator();
            } catch (error) {
              if (generation !== at) return;
              if (error instanceof AdminGrantRevokeRefused) requestIds.delete(key);
              busy = false; render(); status(error instanceof CommandOutcomeUnknown || error instanceof AdminGrantRevokeRefused ? error.message : `The result is unavailable. Refresh or retry. Retry ID: ${requestId}.`);
            }
          }); card.append(button, text("small", action === "approve"
            ? "Approving lets you review this client's permission request in your assistant. Each grant still needs your consent."
            : "Withdrawing stops this client's linked grants and their dependent access."));
        }
        if (approval.more.length) {
          const key = `client:${c.client_id}`, more = document.createElement("details"); more.open = openMore.has(key);
          more.addEventListener("toggle", () => { if (more.open) openMore.add(key); else openMore.delete(key); });
          more.append(text("summary", "More"));
          for (const line of approval.more) more.append(text("p", line));
          card.append(more);
        }
        clientRoot.append(card);
      }
      const dependencies = one<HTMLElement>("[data-admin-dependencies]"); dependencies.replaceChildren();
      if (answered && !workers.length && !coverage.length) dependencies.append(text("p", "No workspace coverage or worker dependencies are visible in this page."));
      for (const row of coverage) {
        const parent = grants.find(g => g.grant_id === row.grant_id);
        dependencies.append(text("p", `Workspace ${row.workspace_id} · Grant ${row.grant_id}${parent?.state === "revoked" ? " · stopped" : " · effective at last read"}.`));
      }
      for (const row of workers) {
        const parent = grants.find(g => g.grant_id === row.grant_id);
        dependencies.append(text("p", `Worker ${row.principal_id} · Workspace ${row.workspace_id} · Grant ${row.grant_id} · ${parent?.state === "revoked" ? "stopped" : row.state}${row.revoked_at ? ` · stopped ${row.revoked_at}` : ""}.`));
      }
      const actionRoot = one<HTMLOListElement>("[data-admin-actions]"); actionRoot.replaceChildren();
      if (answered && !actions.length) actionRoot.append(text("li", "No admin actions are visible in this view."));
      for (const a of actions) {
        const card = document.createElement("li"); card.dataset.outcome = a.outcome;
        card.append(text("strong", `${a.action.replaceAll("_", " ")} · ${a.outcome}`));
        card.append(text("p", `${a.occurred_at_server} · ${a.actor_user ? "Person" : "Connection or system"} ${a.actor_user ?? a.admin_identity_id ?? ""}`));
        card.append(text("p", `${a.target_kind}: ${a.target_id ?? "none"}${a.reason_code ? ` · ${a.reason_code}` : ""}`));
        if (a.next_action !== "none") card.append(text("p", `Next: ${a.next_action}`));
        if (a.owner_user_id) card.append(text("p", `Account owner ${a.owner_user_id}${a.provider_grant_id ? ` · OAuth family ${a.provider_grant_id}` : ""}.`));
        if (a.related_event_ids.length) card.append(text("p", `Related events: ${a.related_event_ids.join(", ")}.`));
        card.append(text("small", `Event ${a.event_id}${a.grant_id ? ` · Grant ${a.grant_id}` : ""}`));
        actionRoot.append(card);
      }
      one<HTMLElement>("[data-admin-more-clients]").hidden = scope !== "account" || clientsBefore === null;
      one<HTMLElement>("[data-admin-more-workers]").hidden = workersBefore === null;
      one<HTMLElement>("[data-admin-more-coverage]").hidden = coverageBefore === null;
      for (const button of root.querySelectorAll<HTMLButtonElement>("[data-admin-refresh], [data-admin-more-grants], [data-admin-more-actions], [data-admin-more-clients], [data-admin-more-workers], [data-admin-more-coverage]")) button.disabled = busy;
      one<HTMLElement>("[data-admin-more-grants]").hidden = grantsBefore === null;
      one<HTMLElement>("[data-admin-more-actions]").hidden = actionsBefore === null;
      syncEmpty();
    };
    /* "Nothing here" is said once per view, only after a read has answered and only when no further page is waiting.
       It speaks of what this view can see, because the read reports the grants visible to this person. */
    const syncEmpty = (): void => {
      const settled = loaded && !busy && grantsBefore === null;
      one<HTMLElement>("[data-admin-empty]").hidden = !(settled && one<HTMLElement>("[data-admin-grants]").children.length === 0 && seatActive === 0);
      one<HTMLElement>("[data-admin-past-empty]").hidden = !(settled && one<HTMLElement>("[data-admin-past-grants]").children.length === 0 && seatPast === 0);
    };
    const showPane = (next: Pane): void => {
      pane = next;
      for (const name of ["access", "history", "clients"] as const) one<HTMLElement>(`[data-admin-pane-body=${name}]`).hidden = name !== pane;
      for (const button of root.querySelectorAll<HTMLButtonElement>("[data-admin-pane]")) button.setAttribute("aria-pressed", String(button.dataset.adminPane === pane));
    };
    /* One line above every view says which scope is showing, by name, and offers the other. */
    const scopeLine = (): void => {
      one<HTMLElement>("[data-admin-scope-name]").textContent = scope === "workspace" ? workspaceNames.get(workspaceId?.toLowerCase() ?? "") ?? "This workspace" : "Your account";
      const other = one<HTMLButtonElement>("[data-admin-scope-switch]");
      other.textContent = scope === "workspace" ? "Show my whole account" : "Show this workspace";
      other.hidden = scope === "account" && !workspaceId;
    };
    let indicatorGeneration = 0;
    const indicator = async (): Promise<void> => {
      if (!session) return;
      const ownSession = session, at = generation, ticket = ++indicatorGeneration;
      const button = one<HTMLButtonElement>("[data-admin-indicator]");
      try {
        const account = await loadAdminRecovery(ownSession, "admin_grants");
        const workspace = workspaceId ? await loadAdminRecovery(ownSession, "admin_grants", workspaceId).catch(error => {
          if (error instanceof AdminRecoveryReadError && error.status === 403) return null;
          throw error;
        }) : null;
        if (generation !== at || ticket !== indicatorGeneration) return;
        const full = account.active.full_account_count;
        const count = account.active.grant_count, workspaceCount = workspace?.active.grant_count ?? 0;
        indicatorView = count > 0 || workspaceCount === 0 ? "account" : "workspace";
        button.hidden = true; button.dataset.fullAccount = String(full > 0);
        one<HTMLElement>("[data-admin-indicator-title]").textContent = full ? `${full} full-account admin ${full === 1 ? "grant" : "grants"} active` :
          count > 0 ? `${count} active admin ${count === 1 ? "grant" : "grants"} in your account` : workspaceCount > 0 ? `${workspaceCount} active admin ${workspaceCount === 1 ? "grant" : "grants"} in this workspace` : "Admin clients and history";
        const expiry = full ? account.active.full_account_expires_at : account.active.expires_at ?? workspace?.active.expires_at;
        one<HTMLElement>("[data-admin-indicator-detail]").textContent = count === 0 && workspaceCount === 0 ? "Review client approvals, previous grants or history." : `${full ? "Full-account grants: earliest expiry" : "Earliest expiry"} ${expiry ?? "unavailable"}.${count > 0 && workspaceCount > 0 ? ` This workspace: ${workspaceCount} active grants.` : ""} View actions or revoke.`;
      } catch {
        if (generation !== at || ticket !== indicatorGeneration) return;
        button.hidden = true;
        one<HTMLElement>("[data-admin-indicator-title]").textContent = "Admin access status unavailable";
        one<HTMLElement>("[data-admin-indicator-detail]").textContent = "Review access or try again.";
      }
    };
    /* Any read that says this person may not see this view, the main one or an agent one, clears everything the view
       drew: client grants, approvals, history, coverage, agent rows and the workspace names. It also takes a new
       generation, so a read or a Remove still on its way finds itself out of date and draws nothing. The view then
       stays cleared until a full refresh succeeds. */
    const refuseView = (message: string): void => {
      ++generation;
      grants = []; actions = []; clients = []; workers = []; coverage = [];
      grantsBefore = actionsBefore = clientsBefore = workersBefore = coverageBefore = null;
      clearSeats(); seatActive = seatPast = -1; forgetNames(); scopeLine();
      busy = false; loaded = false; dialog.dataset.adminState = "refused"; render(); status(message);
    };
    const denied = (result: { httpStatus?: number }): boolean => result.httpStatus === 401 || result.httpStatus === 403;
    /* The agent rows are read only after the main read has answered yes, so nothing of theirs is drawn beside a
       refusal, not even for a moment. */
    const refresh = async (): Promise<void> => {
      await load();
      if (dialog.dataset.adminState === "ready") await loadSeatAdmin();
    };
    type Collection = "grants" | "actions" | "clients" | "workers" | "coverage";
    const load = async (more?: Collection): Promise<void> => {
      if (!session || busy) return;
      const ownSession = session, at = ++generation, selected = scope === "workspace" ? workspaceId : null;
      busy = true; dialog.dataset.adminState = "loading"; render(); status("Loading admin access and recorded actions…"); void gate();
      try {
        const [grantPage, actionPage, clientPage, workerPage, coveragePage] = await Promise.all([
          more && more !== "grants" ? null : loadAdminRecovery(ownSession, "admin_grants", selected, more ? grantsBefore : null),
          more && more !== "actions" ? null : loadAdminRecovery(ownSession, "admin_history", selected, more ? actionsBefore : null),
          scope !== "account" || more && more !== "clients" ? null : loadAdminRecovery(ownSession, "admin_clients", null, more ? clientsBefore : null),
          more && more !== "workers" ? null : loadAdminRecovery(ownSession, "admin_workers", selected, more ? workersBefore : null),
          more && more !== "coverage" ? null : loadAdminRecovery(ownSession, "admin_coverage", selected, more ? coverageBefore : null),
        ]);
        if (generation !== at) return;
        if (grantPage) { grants = more ? [...grants, ...grantPage.grants] : grantPage.grants; grantsBefore = grantPage.next_before; }
        if (actionPage) { actions = more ? [...actions, ...actionPage.actions] : actionPage.actions; actionsBefore = actionPage.next_before; }
        if (clientPage) { clients = more ? [...clients, ...clientPage.clients] : clientPage.clients; clientsBefore = clientPage.next_before; }
        if (workerPage) { workers = more ? [...workers, ...workerPage.workers] : workerPage.workers; workersBefore = workerPage.next_before; }
        if (coveragePage) { coverage = more ? [...coverage, ...coveragePage.coverage] : coveragePage.coverage; coverageBefore = coveragePage.next_before; }
        // The lists are the answer; the state is also on the dialog for tools and tests.
        busy = false; loaded = true; dialog.dataset.adminState = "ready"; render(); status("");
      } catch (error) {
        if (generation !== at) return;
        refuseView(error instanceof AdminRecoveryReadError ? error.message : "Admin access could not be verified for your account. Refresh or sign in again.");
      }
    };
    const loadSeatAdmin = async (): Promise<void> => {
      if (!session) return;
      const ownSession = session, at = generation, epoch = ++seatEpoch, selected = scope === "workspace" ? workspaceId : null;
      const stale = (): boolean => generation !== at || seatEpoch !== epoch || session?.user.id !== ownSession.user.id;
      const section = one<HTMLElement>("[data-admin-seat-section]");
      const retry = one<HTMLElement>("[data-admin-seat-retry]");
      const container = one<HTMLElement>("[data-admin-seat-grants]");
      const pastContainer = one<HTMLElement>("[data-admin-past-seat-grants]");
      // Not known until this read answers, so neither view says "nothing here" meanwhile.
      seatActive = seatPast = -1; syncEmpty();
      const statusResult = await readSeatAdminStatus(ownSession);
      if (stale()) return;
      if (!statusResult.ok) {
        if (denied(statusResult)) { refuseView("Admin access could not be verified for your account. Refresh or sign in again."); return; }
        // A read that failed in passing is not an answer of "none": say what happened and offer Retry.
        container.replaceChildren(text("p", statusResult.message)); pastContainer.replaceChildren();
        section.hidden = false; retry.hidden = false;
        return;
      }
      if (!statusResult.status.enabled) {
        section.hidden = true;
        retry.hidden = true;
        container.replaceChildren(); pastContainer.replaceChildren();
        seatActive = seatPast = 0; syncEmpty();
        return;
      }
      const agentsByPrincipalId = new Map(statusResult.status.agents.map(a => [a.principalId, a.name]));
      const [grantsResult, orgs, workspaces] = await Promise.all([
        readMySeatAdminGrants(ownSession),
        myOrganizations().catch(() => []),
        myWorkspaces().catch(() => []),
      ]);
      if (stale()) return;
      if (!grantsResult.ok) {
        if (denied(grantsResult)) { refuseView("Admin access could not be verified for your account. Refresh or sign in again."); return; }
        container.replaceChildren(text("p", grantsResult.message)); pastContainer.replaceChildren();
        section.hidden = false;
        retry.hidden = false;
        return;
      }
      retry.hidden = true;
      const organizationsById = new Map<string, string>();
      for (const org of orgs) {
        if (org.id && org.name?.trim()) organizationsById.set(org.id.toLowerCase(), org.name.trim());
      }
      const workspacesById = new Map<string, string>();
      for (const ws of workspaces) {
        if (ws.id && ws.name?.trim()) workspacesById.set(ws.id.toLowerCase(), ws.name.trim());
        if (ws.orgId && ws.orgName?.trim()) organizationsById.set(ws.orgId.toLowerCase(), ws.orgName.trim());
      }
      // A workspace view lists the grants that reach this workspace: its own, and those of the organization it is in.
      // An organization grant for some other organization does not belong here.
      const selectedId = selected?.toLowerCase() ?? null;
      const selectedOrg = selectedId ? workspaces.find(ws => ws.id?.toLowerCase() === selectedId)?.orgId?.toLowerCase() ?? null : null;
      const filtered = selectedId
        ? grantsResult.grants.filter(g => g.workspaceIds.includes(selectedId) || (g.level === "organization" && selectedOrg !== null && g.organizationId === selectedOrg))
        : grantsResult.grants;
      // Placement follows the server's state, never this device's clock: what the server calls active is in the opening
      // list with its action; ended and expired grants are under Past grants.
      const current = filtered.filter(seatAdminGrantLive), past = filtered.filter(g => !seatAdminGrantLive(g));
      const options: Parameters<typeof renderSeatAdminHistoryList>[2] = {
        agentsByPrincipalId,
        workspacesById,
        organizationsById,
        busy: seatBusy,
        viewerUserId: ownSession.user.id,
        // Runs only after the person confirms End access for this row.
        onRemove: async (g, button) => {
          if (!session || seatBusy) return;
          const activeSession = session, callGen = generation;
          const requestId = seatEndRequestIds.get(g.grantId) ?? uuid();
          seatEndRequestIds.set(g.grantId, requestId);
          seatBusy = true;
          for (const btn of container.querySelectorAll<HTMLButtonElement>("[data-admin-seat-remove]")) {
            btn.disabled = true;
          }
          seatStatus("Removing agent admin access…");
          const outcome = await endSeatAdmin(activeSession, requestId, g.grantId);
          if (session?.user.id !== activeSession.user.id) return;
          if (generation !== callGen) {
            /* The view was refreshed or refused while this was on its way, so this result may not be drawn into it.
               After a refusal nothing is read or drawn until a full refresh succeeds. If the view has since been read
               again in full, its agent rows are read again so the list shows what is true now. */
            seatBusy = false;
            if (dialog.dataset.adminState === "ready") void loadSeatAdmin();
            return;
          }
          seatBusy = false;
          if (outcome.kind === "accepted") {
            seatEndRequestIds.delete(g.grantId);
            seatStatus("Agent admin access removed.");
            window.dispatchEvent(new CustomEvent("commonswarm:seat-admin-changed"));
            await loadSeatAdmin();
            return;
          }
          if (outcome.kind === "refused") {
            seatEndRequestIds.delete(g.grantId);
          }
          for (const btn of container.querySelectorAll<HTMLButtonElement>("[data-admin-seat-remove]")) {
            btn.disabled = false;
          }
          button.disabled = false;
          seatStatus(outcome.message);
        },
      };
      renderSeatAdminHistoryList(container, current, options);
      renderSeatAdminHistoryList(pastContainer, past, options);
      // The list says "nothing here" once for the whole view, not once per kind of holder.
      if (!current.length) container.replaceChildren();
      if (!past.length) pastContainer.replaceChildren();
      section.hidden = current.length === 0;
      seatActive = current.length; seatPast = past.length; syncEmpty();
    };
    const open = (view: "account" | "workspace" = "account", wanted?: Pane): void => {
      if (!session) return;
      scope = view === "workspace" && workspaceId ? "workspace" : "account";
      clear();
      // A fresh opening starts on who has access now; changing scope keeps the view the person is reading.
      // The history link asks for History; every other door starts on Access.
      if (wanted) showPane(wanted); else if (!dialog.open) showPane("access");
      if (!dialog.open) dialog.showModal();
      scopeLine();
      const ownerId = session.user.id, ticket = ++namesTicket;
      // Names for the scope line and for each grant's reach; ids are shown until they arrive, and if they never do.
      void myWorkspaces().then(rows => {
        if (ticket !== namesTicket || session?.user.id !== ownerId) return;
        workspaceNames = new Map(rows.filter(row => row.id && row.name?.trim()).map(row => [row.id.toLowerCase(), row.name.trim()]));
        scopeLine(); if (!busy) render();
      }).catch(() => {});
      void refresh();
    };
    one("[data-admin-indicator]").addEventListener("click", () => open(indicatorView));
    one("[data-admin-close]").addEventListener("click", () => dialog.close());
    one("[data-admin-refresh]").addEventListener("click", () => { void refresh(); void indicator(); });
    one("[data-admin-seat-retry]").addEventListener("click", () => { void loadSeatAdmin(); });
    one("[data-admin-more-grants]").addEventListener("click", () => { void load("grants"); });
    one("[data-admin-more-actions]").addEventListener("click", () => { void load("actions"); });
    for (const collection of ["clients", "workers", "coverage"] as const) one(`[data-admin-more-${collection}]`).addEventListener("click", () => { void load(collection); });
    for (const button of root.querySelectorAll<HTMLButtonElement>("[data-admin-pane]")) button.addEventListener("click", () => showPane(button.dataset.adminPane === "history" ? "history" : button.dataset.adminPane === "clients" ? "clients" : "access"));
    one("[data-admin-scope-switch]").addEventListener("click", () => open(scope === "account" ? "workspace" : "account"));
    document.addEventListener("click", event => {
      const button = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-admin-access-open]") : null;
      if (button) {
        // Close the launching dialog so Escape/focus belong to this view.
        button.closest("dialog")?.close();
        open(button.dataset.adminAccessScope === "workspace" ? "workspace" : "account");
      }
    });
    window.addEventListener("commonswarm:admin-access-open", event => {
      const detail = (event as CustomEvent<{ scope?: "account" | "workspace"; view?: "history" } | undefined>).detail;
      open(detail?.scope === "workspace" ? "workspace" : "account", detail?.view === "history" ? "history" : undefined);
    });
    window.addEventListener("commonswarm:workspace-selected", event => {
      const detail = (event as CustomEvent<{ workspaceId: string | null; sample?: boolean }>).detail;
      workspaceId = detail.sample ? null : detail.workspaceId;
      clear(); if (dialog.open) open(scope); else scopeLine(); void indicator();
    });
    // A link to ?admin=history opens History for the whole account, once, as soon as the person's session is known.
    let wantsHistory = false;
    try { wantsHistory = new URLSearchParams(window.location.search).get("admin") === "history"; } catch { /* ignore */ }
    const openFromLink = (): void => { if (wantsHistory && session) { wantsHistory = false; open("account", "history"); } };
    const applyAuthChange = (next: Session | null): void => {
      const changed = session?.user.id !== next?.user.id || session?.access_token !== next?.access_token;
      session = next; root.hidden = !session;
      if (changed) { clear(); forgetNames(); requestIds.clear(); seatEndRequestIds.clear(); dialog.close(); one<HTMLElement>("[data-admin-indicator]").hidden = true; }
      if (session) window.setTimeout(() => { void indicator(); openFromLink(); }, 0);
    };
    onAuthChange((_event, next) => applyAuthChange(next));
    onAccountForcedTeardown(() => applyAuthChange(null));
    const initialGeneration = generation;
    void (async () => {
      if (isMultiAccountEnabled()) await bootstrapMultiAccountAuth();
      const next = await currentSession();
      if (generation !== initialGeneration) return;
      session = next; root.hidden = !next;
      if (next) {
        void indicator();
        openFromLink();
      }
    })().catch(() => { if (generation === initialGeneration) root.hidden = true; });
    // Human-facing status refresh, independent of the delegated runtime being online.
    window.setInterval(() => { if (!document.hidden) void indicator(); }, 30_000);
    document.addEventListener("visibilitychange", () => { if (!document.hidden) void indicator(); });
  }
</script>

<style>
  admin-delegations[hidden], [hidden] { display: none !important; }
  .admin-indicator { display: none !important; }
  admin-delegations :global(button) { font: inherit; color: var(--text-primary); background: var(--surface); border: 1px solid var(--border-interactive); border-radius: .5rem; padding: .6rem .85rem; cursor: pointer; }
  /* Contrast on --surface: --danger text on --danger-dim 5.02:1 light, 7.11:1 dark;
     hover fill --danger-ink on --danger 5.82:1 light, 11.58:1 dark. */
  admin-delegations :global(button[data-tone=danger]) { color: var(--danger); background: var(--danger-dim); border-color: color-mix(in oklab, var(--danger) 45%, var(--border)); }
  admin-delegations :global(button[data-tone=danger]:hover:not(:disabled)) { color: var(--danger-ink); background: var(--danger); border-color: var(--danger); }
  admin-delegations :global(button:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  admin-delegations :global(button:disabled) { opacity: .6; cursor: wait; }
  .admin-indicator[data-full-account=true], admin-delegations :global(article[data-mode=full_account]) { border: 2px solid var(--warning); background: var(--surface-2); }
  .admin-indicator span, small { color: var(--text-muted); font-size: .8rem; }
  dialog { color: var(--text-primary); background: var(--surface); border: 1px solid var(--border-interactive); border-radius: .8rem; padding: 1.5rem; width: min(46rem, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); overflow: auto; }
  dialog::backdrop { background: rgba(0,0,0,.45); }
  header { display: flex; justify-content: space-between; align-items: start; gap: 1rem; }
  h2, h3, admin-delegations :global(h4), admin-delegations :global(h5) { margin: 0 0 .6rem; }
  admin-delegations :global(p) { margin: .5rem 0; }
  nav { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1rem 0; }
  nav [aria-pressed=true] { border-color: var(--text-primary); font-weight: 700; }
  admin-delegations :global(section) { margin-top: 1.5rem; }
  admin-delegations :global(article), admin-delegations :global(li) { border: 1px solid var(--border); padding: 1rem; margin: .75rem 0; border-radius: .6rem; overflow-wrap: anywhere; }
  ol { padding: 0; list-style: none; }
  admin-delegations :global([data-outcome=refused]), admin-delegations :global([data-outcome=failed]) { border-inline-start: 3px solid var(--warning); }
  [data-admin-gate] { border-inline-start: 3px solid var(--warning); padding-inline-start: .75rem; }
  admin-delegations :global(table) { width: 100%; border-collapse: collapse; table-layout: fixed; }
  admin-delegations :global(th), admin-delegations :global(td) { text-align: left; vertical-align: top; padding: .6rem; border: 1px solid var(--border); overflow-wrap: anywhere; }
  admin-delegations :global(th) { background: var(--surface-2); }
  [data-admin-status] { min-height: 1.5em; }
</style>
