---
/*
 * WhatHappens: concise security and filesystem facts verified against root install.sh.
 */

const facts = [
  "Checks Node 22+ before downloading.",
  "Downloads cswarm and cswarm.sha256, then verifies SHA-256.",
  "Installs ~/.local/bin/cswarm with no sudo, no shell profile edits, and no background service.",
];
---

<section class="wh section section--tight" id="what-happens" aria-labelledby="wh-title">
  <div class="page">
    <div class="wh__card">
      <h2 class="wh__h" id="wh-title">What the script does</h2>
      <ul class="wh__list">
        {
          facts.map((item) => (
            <li class="wh__item">
              <svg
                class="wh__tick"
                viewBox="0 0 16 16"
                width="13"
                height="13"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M2.5 8.5l3.5 3.5 7.5-8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="wh__uninstall">
        Uninstall: <code class="mono">rm ~/.local/bin/cswarm &amp;&amp; rm -rf ~/.cswarm</code>
      </p>
    </div>
  </div>
</section>

<style>
  .wh__card {
    max-width: 46rem;
    margin-inline: auto;
    padding: var(--pad-card-lg);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }

  .wh__h {
    margin: 0 0 var(--s-4);
    font-size: var(--t-lg);
    line-height: var(--lh-lg);
    letter-spacing: var(--track-head);
    font-weight: var(--weight-head);
    color: var(--text);
  }

  .wh__list {
    display: grid;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wh__item {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-size: var(--t-sm);
    line-height: var(--lh-base);
    color: var(--text);
  }

  .wh__tick {
    flex: none;
    color: var(--success);
    transform: translateY(1px);
  }

  .wh__uninstall {
    margin: var(--s-5) 0 0;
    padding-top: var(--s-4);
    border-top: 1px solid var(--border);
    font-size: var(--t-sm);
    line-height: var(--lh-base);
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .wh__uninstall code {
    color: var(--text);
  }

  @media (max-width: 40rem) {
    .wh__card {
      padding: var(--s-5);
    }
  }
</style>
