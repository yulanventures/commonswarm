---
/*
 * OtherWays: command-first alternative install paths for /download.
 * Pinned version derives from lib/release.ts (INSTALL_CMD_PINNED); install directory command
 * derives from lib/install.ts (INSTALL_CMD_DIR); clone directory derives from SOURCE_REPO.
 */

import Card from "../ui/Card.astro";
import CodeBlock from "../ui/CodeBlock.astro";
import { INSTALL_CMD_DIR } from "../../lib/install.ts";
import { INSTALL_CMD_PINNED } from "../../lib/release.ts";

interface Props {
  /** The same install command shown at the top of the page. */
  cmd: string;
}

const { cmd } = Astro.props;

const readCmd = cmd.replace(/\|\s*sh$/, "| less");
const pinCmd = INSTALL_CMD_PINNED;
const dirCmd = INSTALL_CMD_DIR;
const SOURCE_REPO = "https://github.com/yulanventures/commonswarm.git";
const sourceDir = SOURCE_REPO.replace(/^.*\//, "").replace(/\.git$/, "");
const sourceCmd = `git clone ${SOURCE_REPO}
cd ${sourceDir}
npm install
npm run build
node dist/cli.js --version`;

const npmCmd = `npm install -g commonswarm
cswarm --version`;
---

<section class="ow section--tight" id="other-ways" aria-labelledby="ow-title">
  <div class="page">
    <div class="ow__head">
      <h2 class="h-section" id="ow-title">Other ways to install</h2>
    </div>

    <div class="ow__grid reveal-stagger">
      <Card as="article" title="Inspect script" headingLevel={3} class="ow__card">
        <CodeBlock code={readCmd} label="read" prompt="$" wrap />
      </Card>

      <Card as="article" title="npm" headingLevel={3} class="ow__card">
        <CodeBlock code={npmCmd} label="npm" prompt="$" wrap />
      </Card>

      <Card as="article" title="Pin version or path" headingLevel={3} class="ow__card">
        <p class="ow__p">Set variables on <span class="mono">sh</span>, not <span class="mono">curl</span>.</p>
        <CodeBlock code={pinCmd} label="pin version" prompt="$" wrap />
        <CodeBlock code={dirCmd} label="install path" prompt="$" wrap class="ow__second" />
      </Card>

      <Card as="article" title="From source" headingLevel={3} class="ow__card">
        <CodeBlock code={sourceCmd} label="source" prompt="$" wrap />
      </Card>
    </div>
  </div>
</section>

<style>
  .ow__head {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .ow__head .h-section {
    margin: 0;
  }

  .ow__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-grid);
    max-width: 46rem;
    margin: var(--s-8) auto 0;
    align-items: stretch;
  }

  .ow__p {
    margin: 0 0 var(--s-3);
    font-size: var(--t-sm);
    line-height: var(--lh-base);
    color: var(--text-muted);
  }

  .ow__second {
    margin-top: var(--s-3);
  }

  @media (max-width: 56rem) {
    .ow__grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 42rem;
    }
  }
</style>
