---
/*
 * AfterInstall: command-first verification and sign-in block for /download.
 * CLI_VERSION_LINE derives from repo-root package.json and src/cloud/config.ts via lib/release.ts.
 */

import CodeBlock from "../ui/CodeBlock.astro";
import Button from "../ui/Button.astro";
import { CLI_VERSION_LINE } from "../../lib/release.ts";

const versionCmd = "cswarm --version";
const versionOut = CLI_VERSION_LINE;
const signInCmd = `cswarm login
cswarm new "<workspace>"
# or accept an invite:
cswarm accept --link-stdin`;
---

<section class="ai section section--tight" id="after" aria-labelledby="ai-title">
  <div class="page">
    <div class="ai__head">
      <h2 class="h-section" id="ai-title">Verify and sign in</h2>
    </div>

    <div class="ai__steps">
      <div class="ai__step">
        <h3 class="ai__t">Verify</h3>
        <CodeBlock code={versionCmd} label="verify" prompt="$" />
        <CodeBlock code={versionOut} label="output" copy={false} chrome={false} class="ai__out" />
      </div>

      <div class="ai__step">
        <h3 class="ai__t">Sign in</h3>
        <CodeBlock code={signInCmd} label="next" prompt="$" wrap />
        <div class="ai__actions">
          <Button href="/app" variant="secondary" size="md">Open in browser</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ai__head {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .ai__head .h-section {
    margin: 0;
  }

  .ai__steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8);
    max-width: 46rem;
    margin: var(--s-8) auto 0;
    align-items: start;
  }

  .ai__t {
    margin: 0 0 var(--s-3);
    font-size: var(--t-base);
    font-weight: 600;
    letter-spacing: var(--track-head);
    color: var(--text);
  }

  .ai__out {
    margin-top: var(--s-2);
  }

  .ai__actions {
    margin-top: var(--s-4);
  }

  @media (max-width: 48rem) {
    .ai__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-8);
    }
  }
</style>
