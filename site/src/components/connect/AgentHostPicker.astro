---
/*
 * ADD AN AGENT: ONE PANEL (panel consensus, 2026-11-16). Every door opens it: the setup checklist,
 * the empty channel, Lists & docs, the command palette and People & agents (the add-agent route).
 * Host copy, steps and sentences come from agent-hosts.ts. Styles: styles/home/onboarding.css,
 * skinned by styles/kylon-onboarding.css.
 *
 * TOP TO BOTTOM. Already yours (the person's agents that can join here, each with Add; shown only
 * when there are any). The app pills, More apps for coding tools, ChatGPT and Terminal; an app an
 * agent joined through from this browser carries a mark, and the last app used is chosen again.
 * An optional name, checked live against this workspace's agents. One sentence to paste, which
 * follows the name as it is typed. "First time with {App}? Set it up": the numbered steps,
 * collapsed, and gone once the app is connected. Then the waiting line for this attempt.
 *
 * KEY ROUTES. Terminal and Grok Bot have no connector: the same name field (required there, since
 * the person creates the identity) and Copy setup prompt, which mints through <agent-connect>.
 *
 * NOT BUILT HERE. Renaming the agent from the joined card, and the nudge to rename an agent that
 * took its app's name, wait for the server's rename command.
 */
import "../../styles/home/onboarding.css";
import { h0LinkJoinEnabled } from "../../lib/h0-link-join-flag";
import {
  AGENT_CONNECTOR_ADDRESS,
  AGENT_HOST_STATUS_LABELS,
  DESKTOP_SIGN_IN_NOTE,
  TURN_ONLY_NOTE,
  agentHostsFor,
  hostSayName,
  privacyNote,
  type AgentHost,
} from "../../lib/agent-hosts";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const hosts = agentHostsFor("setter");
const primaryHosts = hosts.filter((host) => host.joiner === "primary");
const moreHosts = hosts.filter((host) => host.joiner !== "primary");
const setupHosts = hosts.filter((host) => host.steps.length > 0);

const route = (host: AgentHost): "connector" | "waiting" | "key" =>
  host.status === null ? "key" : host.status === "waiting" ? "waiting" : "connector";
const pieces = (text: string): Array<{ kind: "text" | "workspace" | "email"; value: string }> =>
  text.split(/(\{workspace\}|\{email\})/u).filter(Boolean).map((part) =>
    part === "{workspace}" ? { kind: "workspace", value: "this workspace" }
      : part === "{email}" ? { kind: "email", value: "your account" }
        : { kind: "text", value: part });
/* What the script reads off a pill: the route, the app name a sentence warns against, a status
   other than Ready, and the app's own address where its status was measured there. */
const chipData = (host: AgentHost): Record<string, string> => ({
  "data-ahp-host": host.id,
  "data-ahp-route": route(host),
  "data-ahp-say": hostSayName(host) ?? "",
  ...(host.status && host.status !== "ready" ? { "data-ahp-status-label": AGENT_HOST_STATUS_LABELS[host.status] } : {}),
  ...(host.open ? { "data-ahp-open-href": host.open.href, "data-ahp-open-label": host.open.label } : {}),
});
const connects = (host: AgentHost): boolean => route(host) === "connector" || Boolean(host.testing);
const notesOf = (host: AgentHost): string[] => [
  ...(connects(host) ? [TURN_ONLY_NOTE, privacyNote(host.id === "other-app" ? "that app" : host.name)] : []),
  ...(host.desktopSignIn ? [DESKTOP_SIGN_IN_NOTE.setter] : []),
  ...host.notes,
];
---

<agent-host-picker class:list={["hm-ahp", className]}>
  <div class="hm-ahp__view" data-ahp-view="form">
    <header class="hm-ahp__head">
      <button class="hm-ahp__crumb" type="button" data-ahp-home-back>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5"></path></svg>
        <span>Home</span>
      </button>
      <h1 class="hm-ahp__title" tabindex="-1" data-ahp-grid-title>
        Add an agent to <span data-ahp-slot="workspace-plain">this workspace</span>
      </h1>
    </header>

    <section class="hm-ahp__section hm-ahp__yours" data-ahp-yours aria-labelledby="ahp-yours-title" hidden>
      <h2 class="hm-ahp__step-title" id="ahp-yours-title">Already yours</h2>
      <div data-ahp-existing-list></div>
    </section>

    <section class="hm-ahp__section" aria-label="App">
      <div class="hm-ahp__chip-row">
        <ul class="hm-ahp__chips" role="list">
          {primaryHosts.map((host) => (
            <li>
              <button class="hm-ahp__chip-btn" type="button" aria-pressed="false" {...chipData(host)}>
                <span data-ahp-host-name>{host.name}</span>
                <span class="hm-ahp__chip-mark" data-ahp-connected hidden>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7"></path></svg>
                  <span class="visually-hidden">, connected</span>
                </span>
              </button>
            </li>
          ))}
        </ul>
        <details class="hm-ahp__more" data-ahp-more>
          <summary>More apps</summary>
          <ul class="hm-ahp__chips" role="list">
            {moreHosts.map((host) => (
              <li>
                <button class="hm-ahp__chip-btn" type="button" aria-pressed="false" {...chipData(host)}>
                  <span data-ahp-host-name>{host.name}</span>
                  <span class="hm-ahp__chip-mark" data-ahp-connected hidden>
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7"></path></svg>
                    <span class="visually-hidden">, connected</span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </details>
      </div>
    </section>

    <div class="hm-ahp__compose" data-ahp-compose hidden>
      <div class="hm-ahp__field" data-ahp-name-field>
        <label class="hm-ahp__step-title" for="ahp-name">Name<span data-ahp-optional> (optional)</span></label>
        <input
          class="hm-ahp__input"
          id="ahp-name"
          type="text"
          maxlength="80"
          autocomplete="off"
          spellcheck="false"
          placeholder="Leave blank so it names itself (e.g. RidgeHQ Lead)"
          aria-describedby="ahp-name-note"
          data-ahp-name
        />
        <p class="hm-ahp__field-note" id="ahp-name-note" aria-live="polite" data-ahp-name-note hidden></p>
      </div>

      <div class="hm-ahp__prompt" data-ahp-paste hidden>
        <div class="hm-ahp__prompt-head">
          <h2 class="hm-ahp__step-title">Paste this into <span data-ahp-slot="app">your app</span></h2>
          <span class="hm-ahp__status-note" data-ahp-status-note hidden></span>
        </div>
        <div class="hm-ahp__copyable hm-ahp__copyable--prompt">
          <p class="hm-ahp__value" data-ahp-sentence></p>
          <button class="hm-ahp__copy" type="button" data-ahp-copy-sentence aria-label="Copy the sentence">Copy</button>
        </div>
        <a class="hm-ahp__link" target="_blank" rel="noopener noreferrer" data-ahp-open hidden></a>
      </div>

      <div class="hm-ahp__mint" data-ahp-mint-wrap hidden>
        <button class="hm-ahp__button" type="button" data-ahp-mint>Copy setup prompt</button>
        {/* The invite route lets the joining agent choose its name; it lives in <agent-connect>. */}
        {h0LinkJoinEnabled && (
          <button class="hm-ahp__button hm-ahp__button--quiet" type="button" data-agent-owner-self>Create an invite</button>
        )}
        <p class="hm-ahp__field-note hm-ahp__field-note--error" role="alert" data-ahp-error hidden></p>
      </div>

      {setupHosts.map((host) => (
        <details class="hm-ahp__how" data-ahp-setup={host.id} open={route(host) === "waiting" ? true : undefined} hidden>
          <summary>First time with {host.name}? Set it up</summary>
          <ol class="hm-ahp__steps">
            {host.steps.map((step) => (
              <li class="hm-ahp__step">
                <p>
                  {pieces(step.text).map((piece) =>
                    piece.kind === "workspace" ? <strong data-ahp-slot="workspace">{piece.value}</strong>
                      : piece.kind === "email" ? <span data-ahp-slot="email">{piece.value}</span>
                        : piece.value)}
                </p>
                {step.address && (
                  <div class="hm-ahp__copyable">
                    <code class="hm-ahp__value">{AGENT_CONNECTOR_ADDRESS}</code>
                    <button class="hm-ahp__copy" type="button" data-ahp-copy={AGENT_CONNECTOR_ADDRESS} aria-label="Copy the connector address">Copy</button>
                  </div>
                )}
                {step.code && (
                  <div class="hm-ahp__copyable">
                    <pre class="hm-ahp__value">{step.code}</pre>
                    <button class="hm-ahp__copy" type="button" data-ahp-copy={step.code} aria-label="Copy the command">Copy</button>
                  </div>
                )}
                {step.say && (
                  <div class="hm-ahp__copyable">
                    <p class="hm-ahp__value">{step.say}</p>
                    <button class="hm-ahp__copy" type="button" data-ahp-copy={step.say} aria-label="Copy the request">Copy</button>
                  </div>
                )}
                {step.link && (
                  <a
                    class="hm-ahp__button"
                    href={step.link.href}
                    target={host.id === "claude" ? "_blank" : undefined}
                    rel="nofollow noopener noreferrer"
                    aria-label={host.id === "claude" ? `${step.link.label} (opens in a new tab)` : undefined}
                  >{step.link.label}</a>
                )}
              </li>
            ))}
          </ol>
          {host.testing && (
            <details class="hm-ahp__testing">
              <summary>{host.testing.heading}</summary>
              <ol class="hm-ahp__steps">
                {host.testing.steps.map((step) => (
                  <li class="hm-ahp__step">
                    <p>
                      {pieces(step.text).map((piece) =>
                        piece.kind === "workspace" ? <strong data-ahp-slot="workspace">{piece.value}</strong>
                          : piece.kind === "email" ? <span data-ahp-slot="email">{piece.value}</span>
                            : piece.value)}
                    </p>
                    {step.address && (
                      <div class="hm-ahp__copyable">
                        <code class="hm-ahp__value">{AGENT_CONNECTOR_ADDRESS}</code>
                        <button class="hm-ahp__copy" type="button" data-ahp-copy={AGENT_CONNECTOR_ADDRESS} aria-label="Copy the connector address">Copy</button>
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            </details>
          )}
          {notesOf(host).length > 0 && (
            <ul class="hm-ahp__notes" role="list">
              {notesOf(host).map((note) => <li>{note}</li>)}
            </ul>
          )}
        </details>
      ))}

      <p class="hm-ahp__waiting" data-ahp-waiting role="status" aria-live="polite" hidden>
        <span class="hm-ahp__pulse" aria-hidden="true"></span>
        <span data-ahp-waiting-text></span>
      </p>
    </div>
  </div>

  <section class="hm-ahp__view hm-ahp__joined" data-ahp-joined aria-labelledby="ahp-joined-title" hidden>
    <h2 class="hm-ahp__joined-title" id="ahp-joined-title" tabindex="-1" data-ahp-joined-title></h2>
    <div class="hm-ahp__actions">
      <button class="hm-ahp__button hm-ahp__button--done" type="button" data-ahp-done>Done</button>
      <button class="hm-ahp__button hm-ahp__button--quiet" type="button" data-ahp-approve hidden>Allow Lists &amp; docs</button>
      <button class="hm-ahp__button hm-ahp__button--text" type="button" data-ahp-another>Add another</button>
    </div>
    <p class="hm-ahp__field-note" role="status" aria-live="polite" data-ahp-approve-status></p>
  </section>

  <p class="hm-ahp__footer">
    Someone else's agent? Invite the person; they connect it themselves.
    <button class="hm-ahp__link" type="button" data-agent-owner-teammate>Invite someone</button>
  </p>

  <p class="hm-ahp__status" role="status" aria-live="polite" data-ahp-status></p>
</agent-host-picker>

<script>
  import { agentJoinedSentence, joinPrompt, joinedListsOffer, takenAgentName } from "../../lib/agent-hosts";
  import { addAgentStore, lastHost, rememberLastHost } from "../../lib/add-agent";
  const WAITING_HINT_MS = 120_000;

  class AgentHostPickerElement extends HTMLElement {
    static observedAttributes = ["workspace-name", "account-email"];

    #hostId = "";
    #joinedPrincipalId = "";
    #agentNames: string[] = [];
    #connected = new Set<string>();
    #minting = false;
    #waitingTimer: number | undefined;
    #copyTimer: number | undefined;

    connectedCallback(): void {
      if (this.dataset.wired === "true") return;
      this.dataset.wired = "true";
      for (const chip of this.querySelectorAll<HTMLButtonElement>("[data-ahp-host]")) {
        chip.addEventListener("click", () => this.showHost(chip.dataset.ahpHost ?? ""));
      }
      this.#nameInput()?.addEventListener("input", () => {
        this.#error("");
        this.#render();
      });
      this.querySelector<HTMLButtonElement>("[data-ahp-home-back]")?.addEventListener("click", () => {
        this.dispatchEvent(new CustomEvent("agent-host-home", { bubbles: true }));
      });
      this.querySelector<HTMLButtonElement>("[data-ahp-done]")?.addEventListener("click", () => {
        this.dispatchEvent(new CustomEvent("agent-host-done", {
          bubbles: true,
          detail: { principalId: this.#joinedPrincipalId },
        }));
      });
      for (const button of this.querySelectorAll<HTMLButtonElement>("[data-ahp-copy]")) {
        button.addEventListener("click", () => void this.#copy(button, button.dataset.ahpCopy ?? ""));
      }
      const copySentence = this.querySelector<HTMLButtonElement>("[data-ahp-copy-sentence]");
      copySentence?.addEventListener("click", () =>
        void this.#copy(copySentence, this.querySelector("[data-ahp-sentence]")?.textContent ?? ""));
      this.querySelector<HTMLButtonElement>("[data-ahp-mint]")?.addEventListener("click", () => this.#mint());
      const approve = this.querySelector<HTMLButtonElement>("[data-ahp-approve]");
      approve?.addEventListener("click", () => {
        this.dispatchEvent(new CustomEvent("agent-host-approve", {
          bubbles: true,
          detail: {
            principalId: this.#joinedPrincipalId,
            button: approve,
            status: this.querySelector<HTMLElement>("[data-ahp-approve-status]"),
          },
        }));
      });
      this.querySelector<HTMLButtonElement>("[data-ahp-another]")?.addEventListener("click", () => {
        const host = this.#hostId;
        this.reset(host);
        this.#nameInput()?.focus({ preventScroll: true });
      });
      this.#render();
    }

    disconnectedCallback(): void {
      window.clearTimeout(this.#waitingTimer);
      window.clearTimeout(this.#copyTimer);
    }

    attributeChangedCallback(): void {
      this.#render();
    }

    get hostId(): string {
      return this.#hostId;
    }

    /** The name typed for this attempt; blank means the agent names itself. */
    get agentName(): string {
      return this.#nameInput()?.value.trim() ?? "";
    }

    /** Whether the chosen app joins over a connector, so its agent is watched for. */
    get watchable(): boolean {
      return this.#chip(this.#hostId)?.dataset.ahpRoute === "connector";
    }

    setContext(context: { workspaceName?: string; accountEmail?: string }): void {
      if (context.workspaceName !== undefined) this.setAttribute("workspace-name", context.workspaceName);
      if (context.accountEmail !== undefined) this.setAttribute("account-email", context.accountEmail);
    }

    /** The names of the agents already in this workspace, for the duplicate check. */
    setRoster(names: readonly string[]): void {
      this.#agentNames = [...names];
      this.#render();
    }

    /** Apps an agent in this workspace joined through; their setup help is not needed again. */
    setConnected(hostIds: readonly string[]): void {
      this.#connected = new Set(hostIds);
      this.#render();
    }

    /** Back to the form. With no app given, the last app used is chosen again. */
    reset(hostId?: string): void {
      window.clearTimeout(this.#waitingTimer);
      this.#joinedPrincipalId = "";
      this.#minting = false;
      const name = this.#nameInput();
      if (name) name.value = "";
      this.#error("");
      this.#show("form");
      const approveStatus = this.querySelector<HTMLElement>("[data-ahp-approve-status]");
      if (approveStatus) approveStatus.textContent = "";
      const next = hostId ?? lastHost(addAgentStore());
      this.#hostId = "";
      if (next && this.#chip(next)) this.showHost(next);
      else this.#render();
    }

    showHost(id: string): void {
      const chip = this.#chip(id);
      if (!chip) return;
      this.#hostId = id;
      rememberLastHost(addAgentStore(), id);
      if (chip.closest("[data-ahp-more]")) this.querySelector<HTMLDetailsElement>("[data-ahp-more]")!.open = true;
      this.#error("");
      this.#show("form");
      this.#render();
      this.#restartWaitingHint();
      this.dispatchEvent(new CustomEvent("agent-host-selected", { bubbles: true, detail: { host: id } }));
    }

    /** A key route's mint failed; the reason belongs beside the name it was for. */
    mintFailed(message: string): void {
      this.#minting = false;
      this.#show("form");
      this.#error(message);
      this.#render();
      this.#nameInput()?.focus({ preventScroll: true });
    }

    mintSettled(): void {
      this.#minting = false;
      this.#render();
    }

    showJoined(agent: { name: string; principalId: string; canApprove: boolean; hosted?: boolean; joinedAt?: string }): void {
      window.clearTimeout(this.#waitingTimer);
      this.#joinedPrincipalId = agent.principalId;
      const workspace = this.getAttribute("workspace-name")?.trim() || "this workspace";
      const title = this.querySelector<HTMLElement>("[data-ahp-joined-title]");
      if (title) title.textContent = agentJoinedSentence(agent.name, workspace, agent.joinedAt);
      const approve = this.querySelector<HTMLButtonElement>("[data-ahp-approve]");
      if (approve) {
        approve.hidden = !joinedListsOffer({ hosted: agent.hosted === true, canApprove: agent.canApprove }).showApprove;
        approve.disabled = false;
        approve.textContent = "Allow Lists & docs";
      }
      this.#show("joined");
      title?.focus({ preventScroll: true });
    }

    #chip(id: string): HTMLButtonElement | null {
      return id ? this.querySelector<HTMLButtonElement>(`[data-ahp-host="${CSS.escape(id)}"]`) : null;
    }

    #nameInput(): HTMLInputElement | null {
      return this.querySelector<HTMLInputElement>("[data-ahp-name]");
    }

    #show(view: "form" | "joined"): void {
      const form = this.querySelector<HTMLElement>("[data-ahp-view='form']");
      const joined = this.querySelector<HTMLElement>("[data-ahp-joined]");
      if (form) form.hidden = view !== "form";
      if (joined) joined.hidden = view !== "joined";
    }

    #error(message: string): void {
      const node = this.querySelector<HTMLElement>("[data-ahp-error]");
      if (!node) return;
      node.textContent = message;
      node.hidden = message === "";
    }

    #mint(): void {
      if (this.#minting) return;
      const chip = this.#chip(this.#hostId);
      if (chip?.dataset.ahpRoute !== "key") return;
      const name = this.agentName;
      const input = this.#nameInput();
      if (!name) {
        this.#error("Give it a name first.");
        input?.focus({ preventScroll: true });
        return;
      }
      if (takenAgentName(name, this.#agentNames)) {
        input?.focus({ preventScroll: true });
        return;
      }
      this.#minting = true;
      this.#error("");
      this.#render();
      this.dispatchEvent(new CustomEvent("agent-host-mint", { bubbles: true, detail: { host: this.#hostId, name } }));
    }

    #restartWaitingHint(): void {
      window.clearTimeout(this.#waitingTimer);
      this.querySelector<HTMLElement>("[data-ahp-waiting-hint]")?.remove();
      if (this.#chip(this.#hostId)?.dataset.ahpRoute !== "connector") return;
      this.#waitingTimer = window.setTimeout(() => {
        const text = this.querySelector<HTMLElement>("[data-ahp-waiting-text]");
        if (!text) return;
        const workspace = this.getAttribute("workspace-name")?.trim() || "this workspace";
        const extra = document.createElement("span");
        extra.dataset.ahpWaitingHint = "";
        extra.className = "hm-ahp__waiting-hint";
        extra.textContent = ` Not there yet? Check that you allowed ${workspace} on the approval page, then paste the sentence again.`;
        text.after(extra);
      }, WAITING_HINT_MS);
    }

    #render(): void {
      const workspace = this.getAttribute("workspace-name")?.trim() || "";
      const email = this.getAttribute("account-email")?.trim() || "your account";
      for (const node of this.querySelectorAll<HTMLElement>("[data-ahp-slot='workspace'], [data-ahp-slot='workspace-plain']")) {
        node.textContent = workspace || "this workspace";
      }
      for (const node of this.querySelectorAll<HTMLElement>("[data-ahp-slot='email']")) node.textContent = email;

      const chip = this.#chip(this.#hostId);
      const route = chip?.dataset.ahpRoute ?? "";
      const appName = chip?.querySelector("[data-ahp-host-name]")?.textContent?.trim() ?? "";
      for (const other of this.querySelectorAll<HTMLButtonElement>("[data-ahp-host]")) {
        const id = other.dataset.ahpHost ?? "";
        other.setAttribute("aria-pressed", String(id === this.#hostId));
        const mark = other.querySelector<HTMLElement>("[data-ahp-connected]");
        if (mark) mark.hidden = !this.#connected.has(id);
      }

      const compose = this.querySelector<HTMLElement>("[data-ahp-compose]");
      if (compose) compose.hidden = !chip;
      const nameField = this.querySelector<HTMLElement>("[data-ahp-name-field]");
      const input = this.#nameInput();
      if (nameField) nameField.hidden = route === "waiting";
      if (input) {
        input.required = route === "key";
        input.placeholder = route === "key" ? "e.g. RidgeHQ Lead" : "Leave blank so it names itself (e.g. RidgeHQ Lead)";
      }
      const optional = this.querySelector<HTMLElement>("[data-ahp-optional]");
      if (optional) optional.hidden = route === "key";

      const name = this.agentName;
      const taken = takenAgentName(name, this.#agentNames);
      const note = this.querySelector<HTMLElement>("[data-ahp-name-note]");
      if (note) {
        note.textContent = taken ? `“${taken}” is already in ${workspace || "this workspace"}.` : "";
        note.hidden = !taken;
      }
      input?.setAttribute("aria-invalid", String(Boolean(taken)));

      const paste = this.querySelector<HTMLElement>("[data-ahp-paste]");
      if (paste) paste.hidden = route !== "connector";
      for (const node of this.querySelectorAll<HTMLElement>("[data-ahp-slot='app']")) node.textContent = appName || "your app";
      const sentence = this.querySelector<HTMLElement>("[data-ahp-sentence]");
      if (sentence && route === "connector") {
        sentence.textContent = joinPrompt({ workspace, app: chip?.dataset.ahpSay || null, name });
      }
      const status = this.querySelector<HTMLElement>("[data-ahp-status-note]");
      if (status) {
        status.textContent = chip?.dataset.ahpStatusLabel ?? "";
        status.hidden = !chip?.dataset.ahpStatusLabel;
      }
      const open = this.querySelector<HTMLAnchorElement>("[data-ahp-open]");
      if (open) {
        const href = chip?.dataset.ahpOpenHref ?? "";
        open.hidden = !href;
        if (href) {
          open.href = href;
          open.textContent = chip?.dataset.ahpOpenLabel ?? "";
        }
      }

      const mintWrap = this.querySelector<HTMLElement>("[data-ahp-mint-wrap]");
      if (mintWrap) mintWrap.hidden = route !== "key";
      const mint = this.querySelector<HTMLButtonElement>("[data-ahp-mint]");
      if (mint) {
        mint.disabled = this.#minting || Boolean(taken);
        mint.textContent = this.#minting ? "Creating…" : "Copy setup prompt";
      }

      for (const setup of this.querySelectorAll<HTMLDetailsElement>("[data-ahp-setup]")) {
        const id = setup.dataset.ahpSetup ?? "";
        setup.hidden = id !== this.#hostId || this.#connected.has(id);
      }

      const waiting = this.querySelector<HTMLElement>("[data-ahp-waiting]");
      const waitingText = this.querySelector<HTMLElement>("[data-ahp-waiting-text]");
      if (waiting) waiting.hidden = route !== "connector";
      if (waitingText) waitingText.textContent = `Waiting for ${name || "your agent"}…`;
    }

    async #copy(button: HTMLButtonElement, value: string): Promise<void> {
      let copied = false;
      try {
        await navigator.clipboard.writeText(value);
        copied = true;
      } catch {
        const target = button.previousElementSibling;
        if (target) {
          const range = document.createRange();
          range.selectNodeContents(target);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
      }
      window.clearTimeout(this.#copyTimer);
      for (const other of this.querySelectorAll<HTMLButtonElement>("[data-ahp-copy], [data-ahp-copy-sentence]")) other.textContent = "Copy";
      button.textContent = copied ? "Copied" : "Selected";
      const status = this.querySelector<HTMLElement>("[data-ahp-status]");
      if (status) status.textContent = copied ? "Copied." : "Copy is blocked here. The text is selected; press Command or Control and C.";
      this.#copyTimer = window.setTimeout(() => {
        button.textContent = "Copy";
      }, 2_000);
    }
  }

  if (!customElements.get("agent-host-picker")) {
    customElements.define("agent-host-picker", AgentHostPickerElement);
  }
</script>
