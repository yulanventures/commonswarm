---
/*
 * ADD AN AGENT, BY THE APP IT LIVES IN (UI-SPEC 3.7; canvas Add-Agent artboard).
 *
 * Setter: /app add-agent pane. Joiner: legacy embed; /invite uses its own connect step.
 * Host copy and steps come from agent-hosts.ts. Styles live in styles/home/onboarding.css.
 *
 * ONE PAGE. The breadcrumb, the title, the app pills and the chosen app's connection stay on
 * screen together: choosing a pill fills in the panel under it (the pills stay, the chosen one
 * ink-filled). The panel is the canvas one: a short summary with an action pill only when the
 * app has a real address (Claude's web app, Cursor's install link); "How to connect, step by
 * step" is a compact toggle on the step title's line that opens every numbered step, the testing
 * steps and the notes under that title; then the one sentence to copy and the waiting line. A host
 * status other than Ready is quiet text beside the step title. The person invite is a quiet line
 * at the foot of the page, so the header is the canvas title and lead only.
 *
 * NOT BUILT (RULINGS.md 5). The canvas "Name its seat" field: on the hosted route the agent names
 * itself when it joins (the sentence it is told to say); no command lets this page name or hold
 * a place for it first. The lime "Add to Home" footer: there is nothing to submit before the
 * agent joins, so the lime action is the joined step's Done, which opens the agent that joined.
 */
import "../../styles/home/onboarding.css";
import {
  AGENT_CONNECTOR_ADDRESS,
  AGENT_HOST_STATUS_LABELS,
  DESKTOP_SIGN_IN_NOTE,
  MENU_LABELS_NOTE,
  TURN_ONLY_NOTE,
  JOIN_NOTE_RESULT,
  agentHostsFor,
  hostConnectLine,
  hostJoinPrompt,
  privacyNote,
  type AgentHost,
  type AgentHostGroup,
  type AgentHostStep,
} from "../../lib/agent-hosts";

interface Props {
  audience?: "setter" | "joiner";
  class?: string;
}

const { audience = "setter", class: className } = Astro.props;
const hosts = agentHostsFor(audience);
const primaryHosts = hosts.filter((host) => host.joiner === "primary");
const more = hosts.filter(
  (host) => host.joiner === "more" || (audience === "setter" && host.id === "terminal"),
);
const detailHosts = hosts.filter((host) => host.id !== "terminal");

const pieces = (text: string): Array<{ kind: "text" | "workspace" | "email"; value: string }> =>
  text.split(/(\{workspace\}|\{email\})/u).filter(Boolean).map((part) =>
    part === "{workspace}" ? { kind: "workspace", value: "this workspace" }
      : part === "{email}" ? { kind: "email", value: "your account" }
        : { kind: "text", value: part });

const stepsOf = (host: AgentHost): readonly AgentHostStep[] => host.steps;
const connects = (host: AgentHost): boolean => (host.status !== null && host.status !== "waiting") || Boolean(host.testing);
const notesOf = (host: AgentHost): string[] => [
  ...(connects(host) ? [TURN_ONLY_NOTE, privacyNote(host.id === "other-app" ? "that app" : host.name)] : []),
  ...(host.desktopSignIn ? [DESKTOP_SIGN_IN_NOTE[audience]] : []),
  ...host.notes,
  MENU_LABELS_NOTE,
];
const linkOf = (host: AgentHost) => host.steps.find((step) => step.link)?.link ?? null;
/* The panel's pill: the app's own web address, else the step link (Cursor's install link). */
const actionOf = (host: AgentHost) => host.open ?? linkOf(host);
const sayTo = (host: AgentHost): string => host.id === "other-app" ? "your agent" : host.name;
---

<agent-host-picker class:list={["hm-ahp", className]} data-audience={audience}>
  <div class="hm-ahp__view hm-ahp__grid" data-ahp-view="grid">
    <header class="hm-ahp__head">
      <button class="hm-ahp__crumb" type="button" data-ahp-home-back hidden={audience === "joiner"}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5"></path></svg>
        <span>Home</span>
      </button>
      <h1 class="hm-ahp__title" tabindex="-1" data-ahp-grid-title>
        Add one of your agents to <span data-ahp-slot="workspace-plain">this workspace</span>
      </h1>
      <p class="hm-ahp__lead" data-ahp-ownership-line></p>
    </header>

    <section class="hm-ahp__section" aria-labelledby={`hm-ahp-${audience}-which`}>
      <h2 class="hm-ahp__step-title" id={`hm-ahp-${audience}-which`}>1. Which app?</h2>
      <div class="hm-ahp__chip-row">
        <ul class="hm-ahp__chips" role="list">
          {primaryHosts.map((host) => (
            <li>
              <button
                class="hm-ahp__chip-btn"
                type="button"
                data-ahp-host={host.id}
                data-agent-owner-self={host.id === "terminal" ? "" : undefined}
                aria-pressed="false"
              >
                <span data-ahp-host-name>{host.name}</span>
              </button>
            </li>
          ))}
        </ul>
        {more.length > 0 && (
          <details class="hm-ahp__more">
            <summary>More apps</summary>
            <ul class="hm-ahp__chips" role="list">
              {more.map((host) => (
                <li>
                  <button
                    class="hm-ahp__chip-btn"
                    type="button"
                    data-ahp-host={host.id}
                    data-agent-owner-self={host.id === "terminal" ? "" : undefined}
                    aria-pressed="false"
                  >
                    <span data-ahp-host-name>{host.name}</span>
                  </button>
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>
    </section>
  </div>

  {detailHosts.map((host) => (
    <section class="hm-ahp__view hm-ahp__section hm-ahp__detail" data-ahp-detail={host.id} aria-labelledby={`ahp-${audience}-${host.id}-title`} hidden>
      <button class="hm-ahp__back" type="button" data-ahp-back>
        <span aria-hidden="true">←</span> Which app?
      </button>
      <div class="hm-ahp__detail-title">
        <h2 class="hm-ahp__step-title hm-ahp__title-anchor" id={`ahp-${audience}-${host.id}-title`} tabindex="-1">2. Connect {host.name}</h2>
        {host.status && host.status !== "ready" && (
          <span class="hm-ahp__status-note" data-status={host.status}>{AGENT_HOST_STATUS_LABELS[host.status]}</span>
        )}
        <details class="hm-ahp__how" open={host.status === "waiting" ? true : undefined}>
          <summary>How to connect, step by step</summary>
          <ol class="hm-ahp__steps">
            {stepsOf(host).map((step) => (
              <li class="hm-ahp__step">
                <p>
                  {pieces(step.text).map((piece) =>
                    piece.kind === "workspace" ? <strong data-ahp-slot="workspace">{piece.value}</strong>
                      : piece.kind === "email" ? <span data-ahp-slot="email">{piece.value}</span>
                        : piece.value)}
                </p>
                {step.address && (
                  <div class="hm-ahp__copyable">
                    <code class="hm-ahp__value">{AGENT_CONNECTOR_ADDRESS}</code>
                    <button class="hm-ahp__copy" type="button" data-ahp-copy={AGENT_CONNECTOR_ADDRESS} aria-label="Copy the connector address">Copy</button>
                  </div>
                )}
                {step.code && (
                  <div class="hm-ahp__copyable">
                    <pre class="hm-ahp__value">{step.code}</pre>
                    <button class="hm-ahp__copy" type="button" data-ahp-copy={step.code} aria-label="Copy the command">Copy</button>
                  </div>
                )}
                {step.say && (
                  <div class="hm-ahp__copyable">
                    <p class="hm-ahp__value">{step.say}</p>
                    <button class="hm-ahp__copy" type="button" data-ahp-copy={step.say} aria-label="Copy the sentence">Copy</button>
                  </div>
                )}
                {step.link && (
                  <a class="hm-ahp__button" href={step.link.href} rel="nofollow">{step.link.label}</a>
                )}
              </li>
            ))}
          </ol>

          {host.testing && (
            <details class="hm-ahp__testing">
              <summary>{host.testing.heading}</summary>
              <ol class="hm-ahp__steps">
                {host.testing.steps.map((step) => (
                  <li class="hm-ahp__step">
                    <p>
                      {pieces(step.text).map((piece) =>
                        piece.kind === "workspace" ? <strong data-ahp-slot="workspace">{piece.value}</strong>
                          : piece.kind === "email" ? <span data-ahp-slot="email">{piece.value}</span>
                            : piece.value)}
                    </p>
                    {step.address && (
                      <div class="hm-ahp__copyable">
                        <code class="hm-ahp__value">{AGENT_CONNECTOR_ADDRESS}</code>
                        <button class="hm-ahp__copy" type="button" data-ahp-copy={AGENT_CONNECTOR_ADDRESS} aria-label="Copy the connector address">Copy</button>
                      </div>
                    )}
                    {step.say && (
                      <div class="hm-ahp__copyable">
                        <p class="hm-ahp__value">{step.say}</p>
                        <button class="hm-ahp__copy" type="button" data-ahp-copy={step.say} aria-label="Copy the sentence">Copy</button>
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            </details>
          )}

          <ul class="hm-ahp__notes" role="list">
            {notesOf(host).map((note) => <li>{note}</li>)}
          </ul>
        </details>
      </div>

      <div class="hm-ahp__connect">
        <p class="hm-ahp__connect-line">{hostConnectLine(host)}</p>
        {actionOf(host) && (
          host.open
            ? <a class="hm-ahp__connect-action" href={host.open.href} target="_blank" rel="noopener noreferrer">{host.open.label}</a>
            : <a class="hm-ahp__connect-action" href={linkOf(host)!.href} rel="nofollow">{linkOf(host)!.label}</a>
        )}
      </div>

      {hostJoinPrompt(host) && (
        <div class="hm-ahp__prompt">
          <p class="hm-ahp__caption">Then say this to {sayTo(host)}</p>
          <div class="hm-ahp__copyable hm-ahp__copyable--prompt">
            <p class="hm-ahp__value">{hostJoinPrompt(host)}</p>
            <button class="hm-ahp__copy" type="button" data-ahp-copy={hostJoinPrompt(host)!} aria-label="Copy the sentence">Copy</button>
          </div>
          <p class="hm-ahp__caption">{JOIN_NOTE_RESULT}</p>
        </div>
      )}

      {host.status && host.status !== "waiting" && audience === "setter" && (
        <p class="hm-ahp__waiting" data-ahp-waiting role="status" aria-live="polite" hidden>
          <span class="hm-ahp__pulse" aria-hidden="true"></span>
          <span data-ahp-waiting-text></span>
        </p>
      )}
      <p class="hm-ahp__waiting hm-ahp__waiting--done" data-ahp-joined-line role="status" aria-live="polite" hidden></p>
    </section>
  ))}

  <section class="hm-ahp__view hm-ahp__joined" data-ahp-joined aria-labelledby={`ahp-${audience}-joined-title`} hidden>
    <h2 class="hm-ahp__joined-title visually-hidden" id={`ahp-${audience}-joined-title`} tabindex="-1" data-ahp-joined-title></h2>
    <div class="hm-ahp__actions">
      <button class="hm-ahp__button hm-ahp__button--done" type="button" data-ahp-done hidden={audience === "joiner"}>Done</button>
      <button class="hm-ahp__button hm-ahp__button--quiet" type="button" data-ahp-approve>Let it use Lists &amp; docs</button>
      <button class="hm-ahp__button hm-ahp__button--text" type="button" data-ahp-another>Add another agent</button>
    </div>
    <p class="hm-ahp__joined-lead" data-ahp-joined-lead>Let it use Lists &amp; docs here, or skip for now.</p>
  </section>


  {audience === "setter" && (
    <p class="hm-ahp__footer">
      Someone else's agent? Invite the person; they connect it themselves.
      <button class="hm-ahp__link" type="button" data-agent-owner-teammate>Invite someone</button>
    </p>
  )}

  <p class="hm-ahp__status" role="status" aria-live="polite" data-ahp-status></p>
</agent-host-picker>

<script>
  import { addAgentOwnershipLine } from "../../lib/home-names";
  import { agentJoinedSentence, joinedListsOffer } from "../../lib/agent-hosts";
  const WAITING_HINT_MS = 120_000;
  const JOIN_POLL_MS = 5_000;

  class AgentHostPickerElement extends HTMLElement {
    static observedAttributes = ["workspace-name", "account-email", "viewer-first-name"];

    #hostId = "";
    /* The app whose panel is on screen; it stays on screen after its agent joins. */
    #shownHost = "";
    #joinedPrincipalId = "";
    #waitingTimer: number | undefined;
    #copyTimer: number | undefined;

    connectedCallback(): void {
      if (this.dataset.wired === "true") return;
      this.dataset.wired = "true";
      for (const tile of this.querySelectorAll<HTMLButtonElement>("[data-ahp-host]")) {
        const id = tile.dataset.ahpHost ?? "";
        if (id === "terminal") continue;
        tile.addEventListener("click", () => this.showHost(id));
      }
      for (const back of this.querySelectorAll<HTMLButtonElement>("[data-ahp-back]")) {
        back.addEventListener("click", () => {
          const from = this.#hostId;
          this.reset();
          this.#focusGrid(from);
          this.dispatchEvent(new CustomEvent("agent-host-back", { bubbles: true }));
        });
      }
      this.querySelector<HTMLButtonElement>("[data-ahp-home-back]")?.addEventListener("click", () => {
        this.dispatchEvent(new CustomEvent("agent-host-home", { bubbles: true }));
      });
      this.querySelector<HTMLButtonElement>("[data-ahp-done]")?.addEventListener("click", () => {
        this.dispatchEvent(new CustomEvent("agent-host-done", {
          bubbles: true,
          detail: { principalId: this.#joinedPrincipalId },
        }));
      });
      for (const button of this.querySelectorAll<HTMLButtonElement>("[data-ahp-copy]")) {
        button.addEventListener("click", () => void this.#copy(button));
      }
      this.querySelector<HTMLButtonElement>("[data-ahp-approve]")?.addEventListener("click", () => {
        this.dispatchEvent(new CustomEvent("agent-host-approve", {
          bubbles: true,
          detail: { principalId: this.#joinedPrincipalId },
        }));
      });
      this.querySelector<HTMLButtonElement>("[data-ahp-another]")?.addEventListener("click", () => {
        this.reset();
        this.#focusGrid("");
        this.dispatchEvent(new CustomEvent("agent-host-another", { bubbles: true }));
      });
      this.#render();
    }

    disconnectedCallback(): void {
      window.clearTimeout(this.#waitingTimer);
      window.clearTimeout(this.#copyTimer);
    }

    attributeChangedCallback(): void {
      this.#render();
    }

    get hostId(): string {
      return this.#hostId;
    }

    setContext(context: { workspaceName?: string; accountEmail?: string; viewerFirstName?: string }): void {
      if (context.workspaceName !== undefined) this.setAttribute("workspace-name", context.workspaceName);
      if (context.accountEmail !== undefined) this.setAttribute("account-email", context.accountEmail);
      if (context.viewerFirstName !== undefined) this.setAttribute("viewer-first-name", context.viewerFirstName);
    }

    reset(): void {
      this.#hostId = "";
      this.#shownHost = "";
      this.#joinedPrincipalId = "";
      window.clearTimeout(this.#waitingTimer);
      this.#show("grid");
      this.#status("");
      for (const chip of this.querySelectorAll<HTMLButtonElement>("[data-ahp-host]")) {
        chip.setAttribute("aria-pressed", "false");
      }
      for (const line of this.querySelectorAll<HTMLElement>("[data-ahp-waiting], [data-ahp-joined-line]")) {
        line.hidden = true;
      }
    }

    showHost(id: string): void {
      const panel = this.querySelector<HTMLElement>(`[data-ahp-detail="${CSS.escape(id)}"]`);
      if (!panel) return;
      this.#hostId = id;
      this.#shownHost = id;
      for (const chip of this.querySelectorAll<HTMLButtonElement>("[data-ahp-host]")) {
        chip.setAttribute("aria-pressed", chip.dataset.ahpHost === id ? "true" : "false");
      }
      this.#show(id);
      this.#resetWaiting(panel, id);
      this.#render();
      panel.querySelector<HTMLElement>(".hm-ahp__title-anchor")?.focus({ preventScroll: true });
      this.#scrollToTop(panel);
      this.dispatchEvent(new CustomEvent("agent-host-selected", { bubbles: true, detail: { host: id } }));
    }

    showJoined(agent: { name: string; principalId: string; canApprove: boolean; hosted?: boolean; joinedAt?: string }): void {
      window.clearTimeout(this.#waitingTimer);
      this.#joinedPrincipalId = agent.principalId;
      const workspace = this.getAttribute("workspace-name")?.trim() || "Home";
      const joinedText = agentJoinedSentence(agent.name, workspace, agent.joinedAt);
      const title = this.querySelector<HTMLElement>("[data-ahp-joined-title]");
      const lead = this.querySelector<HTMLElement>("[data-ahp-joined-lead]");
      const approve = this.querySelector<HTMLButtonElement>("[data-ahp-approve]");
      const panel = this.#shownHost
        ? this.querySelector<HTMLElement>(`[data-ahp-detail="${CSS.escape(this.#shownHost)}"]`)
        : null;
      const joinedLine = panel?.querySelector<HTMLElement>("[data-ahp-joined-line]") ?? null;
      if (title) title.textContent = joinedText;
      const offer = joinedListsOffer({ hosted: agent.hosted === true, canApprove: agent.canApprove });
      if (lead) lead.textContent = offer.lead;
      if (approve) {
        approve.textContent = `Let ${agent.name} use Lists & docs`;
        approve.hidden = !offer.showApprove;
      }
      if (joinedLine) {
        joinedLine.textContent = joinedText;
        joinedLine.hidden = false;
      }
      for (const waiting of this.querySelectorAll<HTMLElement>("[data-ahp-waiting]")) waiting.hidden = true;
      this.#hostId = "";
      this.#show("joined");
      title?.focus({ preventScroll: true });
    }

    #focusGrid(fromHost: string): void {
      const tile = fromHost
        ? this.querySelector<HTMLElement>(`[data-ahp-host="${CSS.escape(fromHost)}"]`)
        : null;
      const target = tile && tile.offsetParent !== null
        ? tile
        : this.querySelector<HTMLElement>("[data-ahp-grid-title]");
      target?.focus({ preventScroll: true });
      if (target) this.#scrollToTop(target === tile ? tile : this);
    }

    #scrollToTop(node: HTMLElement): void {
      let scroller: HTMLElement | null = this.parentElement;
      while (scroller) {
        const overflow = getComputedStyle(scroller).overflowY;
        if ((overflow === "auto" || overflow === "scroll") && scroller.scrollHeight > scroller.clientHeight) break;
        scroller = scroller.parentElement;
      }
      const top = node.getBoundingClientRect().top;
      if (scroller) {
        const delta = top - scroller.getBoundingClientRect().top - 16;
        if (delta < 0 || delta > scroller.clientHeight / 2) scroller.scrollTop += delta;
      } else if (top < 0 || top > window.innerHeight / 2) {
        window.scrollTo({ top: Math.max(0, top + window.scrollY - 16) });
      }
    }

    /* One page: the title and the app pills never leave; the chosen app's panel sits under them,
       and stays there with the lime joined line once its agent joins. */
    #show(view: string): void {
      this.querySelector<HTMLElement>("[data-ahp-view='grid']")!.hidden = false;
      const panelId = view === "joined" ? this.#shownHost : view;
      for (const panel of this.querySelectorAll<HTMLElement>("[data-ahp-detail]")) {
        panel.hidden = panel.dataset.ahpDetail !== panelId;
      }
      const joined = this.querySelector<HTMLElement>("[data-ahp-joined]");
      if (joined) joined.hidden = view !== "joined";
    }

    #hostName(id: string): string {
      const chip = this.querySelector<HTMLButtonElement>(`[data-ahp-host="${CSS.escape(id)}"]`);
      const label = chip?.querySelector("[data-ahp-host-name]")?.textContent?.trim();
      return label && label.length > 0 ? label : "your agent";
    }

    #resetWaiting(panel: HTMLElement, hostId: string): void {
      window.clearTimeout(this.#waitingTimer);
      const waiting = panel.querySelector<HTMLElement>("[data-ahp-waiting]");
      const text = panel.querySelector<HTMLElement>("[data-ahp-waiting-text]");
      const joinedLine = panel.querySelector<HTMLElement>("[data-ahp-joined-line]");
      panel.querySelector<HTMLElement>("[data-ahp-waiting-hint]")?.remove();
      if (joinedLine) joinedLine.hidden = true;
      if (!waiting || !text) return;
      const hostName = this.#hostName(hostId);
      const workspace = this.getAttribute("workspace-name")?.trim() || "Home";
      text.textContent =
        `Waiting for an agent from ${hostName} to join ${workspace}. Checking every ${JOIN_POLL_MS / 1000} seconds.`;
      waiting.hidden = false;
      this.#waitingTimer = window.setTimeout(() => {
        const extra = document.createElement("span");
        extra.dataset.ahpWaitingHint = "";
        extra.className = "hm-ahp__waiting-hint";
        extra.textContent =
          ` Not there yet? Check that you allowed ${workspace} on the approval page, then say the sentence again.`;
        text.after(extra);
      }, WAITING_HINT_MS);
    }

    #render(): void {
      const workspace = this.getAttribute("workspace-name")?.trim() || "this workspace";
      const email = this.getAttribute("account-email")?.trim() || "your account";
      const first = this.getAttribute("viewer-first-name")?.trim() || "";
      for (const node of this.querySelectorAll<HTMLElement>("[data-ahp-slot='workspace'], [data-ahp-slot='workspace-plain']")) {
        node.textContent = workspace;
      }
      for (const node of this.querySelectorAll<HTMLElement>("[data-ahp-slot='email']")) {
        node.textContent = email;
      }
      const ownership = this.querySelector<HTMLElement>("[data-ahp-ownership-line]");
      if (ownership) {
        const agentName = this.#hostId ? this.#hostName(this.#hostId) : "agent";
        ownership.textContent = addAgentOwnershipLine(workspace, first, agentName);
      }
    }

    #status(message: string): void {
      const status = this.querySelector<HTMLElement>("[data-ahp-status]");
      if (status) status.textContent = message;
    }

    async #copy(button: HTMLButtonElement): Promise<void> {
      const value = button.dataset.ahpCopy ?? "";
      let copied = false;
      try {
        await navigator.clipboard.writeText(value);
        copied = true;
      } catch {
        const target = button.previousElementSibling;
        if (target) {
          const range = document.createRange();
          range.selectNodeContents(target);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
      }
      window.clearTimeout(this.#copyTimer);
      for (const other of this.querySelectorAll<HTMLButtonElement>("[data-ahp-copy]")) other.textContent = "Copy";
      button.textContent = copied ? "Copied" : "Selected";
      this.#status(copied ? "Copied." : "Copy is blocked here. The text is selected; press Command or Control and C.");
      this.#copyTimer = window.setTimeout(() => {
        button.textContent = "Copy";
      }, 2_000);
    }
  }

  if (!customElements.get("agent-host-picker")) {
    customElements.define("agent-host-picker", AgentHostPickerElement);
  }
</script>
