---
/*
 * ADD AN AGENT, BY THE APP IT LIVES IN.
 *
 * The person picks the app their agent already lives in (Claude, Muse, ChatGPT, Codex...) and
 * gets that app's steps, the one connector address and one sentence to say to the agent. Every
 * host, step and status comes from site/src/lib/agent-hosts.ts; this file only lays them out.
 *
 * Two audiences. "setter" is the person setting up a workspace in /app: every host, plus the
 * terminal key flow under Other and a way to invite a person instead. "joiner" is the person who
 * just accepted an invitation on /invite: chat apps first, coding tools folded under "More apps",
 * no key flow, no invite link. The joiner never sees a command she has to run unless she opens
 * "More apps" herself.
 *
 * NO STATE IN THE MARKUP. Every view (the grid, each host, the joined receipt) is rendered here at
 * build time and switched with `hidden`, for the same reason AgentConnect does it: Astro scopes
 * styles to elements present in this template. Script writes only text.
 *
 * HOOKS THE HOST PAGE USES. The terminal tile carries `data-agent-owner-self` and the invite link
 * `data-agent-owner-teammate`, so /app's existing listeners open the key flow and the person
 * invite exactly as before. The element also emits `agent-host-selected`, `agent-host-back`,
 * `agent-host-approve` and `agent-host-another` (bubbling), and exposes `reset()`,
 * `showJoined(agent)` and `setContext({ workspaceName, accountEmail })`.
 */
import {
  AGENT_CONNECTOR_ADDRESS,
  AGENT_HOST_GROUP_LABELS,
  AGENT_HOST_STATUS_LABELS,
  DESKTOP_SIGN_IN_NOTE,
  MENU_LABELS_NOTE,
  TURN_ONLY_NOTE,
  agentHostsFor,
  privacyNote,
  type AgentHost,
  type AgentHostGroup,
  type AgentHostStep,
} from "../../lib/agent-hosts";

interface Props {
  audience?: "setter" | "joiner";
  class?: string;
}

const { audience = "setter", class: className } = Astro.props;
const hosts = agentHostsFor(audience);
const groupOrder: AgentHostGroup[] = ["chat", "coding", "other"];
const primary = (host: AgentHost) => audience === "setter" || host.joiner === "primary";
const groups = groupOrder
  .map((group) => ({ group, label: AGENT_HOST_GROUP_LABELS[group], hosts: hosts.filter((host) => host.group === group && primary(host)) }))
  .filter((entry) => entry.hosts.length > 0);
const more = audience === "joiner" ? hosts.filter((host) => !primary(host)) : [];
const detailHosts = hosts.filter((host) => host.id !== "terminal");

/** Split step text on its two live slots so the template can render them as elements. */
const pieces = (text: string): Array<{ kind: "text" | "workspace" | "email"; value: string }> =>
  text.split(/(\{workspace\}|\{email\})/u).filter(Boolean).map((part) =>
    part === "{workspace}" ? { kind: "workspace", value: "this workspace" }
      : part === "{email}" ? { kind: "email", value: "your account" }
        : { kind: "text", value: part });

const orbLetters = (host: AgentHost): string =>
  host.id === "terminal" ? ">_" : host.id === "other-app" ? "+" : host.id === "claude-code" ? "CC" : host.name.slice(0, 1);

const orbHue: Record<string, string> = {
  claude: "peach",
  "claude-code": "peach",
  codex: "sky",
  chatgpt: "sky",
  "other-app": "sage",
  terminal: "lavender",
};

const stepsOf = (host: AgentHost): readonly AgentHostStep[] => host.steps;
const notesOf = (host: AgentHost): string[] => [
  ...(host.status && host.status !== "waiting" ? [TURN_ONLY_NOTE, privacyNote(host.id === "other-app" ? "that app" : host.name)] : []),
  ...(host.desktopSignIn ? [DESKTOP_SIGN_IN_NOTE] : []),
  ...host.notes,
  MENU_LABELS_NOTE,
];
---

<agent-host-picker class:list={["ahp", className]} data-audience={audience}>
  <div class="ahp__view" data-ahp-view="grid">
    <header class="ahp__head">
      <p class="ahp__eyebrow">{audience === "joiner" ? "Your agents" : "Add an agent"}</p>
      <h2 class="ahp__title" tabindex="-1" data-ahp-grid-title>
        {audience === "joiner" ? "Connect your own agents." : "Which app does your agent live in?"}
      </h2>
      <p class="ahp__lead">
        {audience === "joiner"
          ? "Each one asks you to sign in as yourself and approve. No keys and no commands."
          : "Each person connects their own agents. Pick the app, follow its steps, then say one sentence to the agent."}
      </p>
    </header>

    {groups.map(({ group, label, hosts: groupHosts }) => (
      <section class="ahp__group" aria-labelledby={`ahp-${audience}-group-${group}`}>
        <h3 class="ahp__group-title" id={`ahp-${audience}-group-${group}`}>{label}</h3>
        <ul class="ahp__tiles" role="list">
          {groupHosts.map((host) => (
            <li>
              <button
                class="ahp__tile"
                type="button"
                data-ahp-host={host.id}
                data-agent-owner-self={host.id === "terminal" ? "" : undefined}
              >
                <span class:list={["ahp__orb", host.logo ? "ahp__orb--logo" : `ahp__orb--${orbHue[host.id] ?? "lavender"}`]} aria-hidden="true">
                  {host.logo
                    ? <img src={host.logo.src} alt="" width="22" height="22" loading="lazy" class:list={[{ "ahp__logo--tile": host.logo.tile }]} />
                    : <span>{orbLetters(host)}</span>}
                </span>
                <span class="ahp__tile-copy">
                  <strong>{host.name}</strong>
                  <small>{host.maker}</small>
                  {host.status && (
                    <span class="ahp__chip" data-status={host.status}>{AGENT_HOST_STATUS_LABELS[host.status]}</span>
                  )}
                </span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {more.length > 0 && (
      <details class="ahp__more">
        <summary>More apps</summary>
        <ul class="ahp__tiles" role="list">
          {more.map((host) => (
            <li>
              <button class="ahp__tile" type="button" data-ahp-host={host.id}>
                <span class:list={["ahp__orb", host.logo ? "ahp__orb--logo" : `ahp__orb--${orbHue[host.id] ?? "lavender"}`]} aria-hidden="true">
                  {host.logo
                    ? <img src={host.logo.src} alt="" width="22" height="22" loading="lazy" class:list={[{ "ahp__logo--tile": host.logo.tile }]} />
                    : <span>{orbLetters(host)}</span>}
                </span>
                <span class="ahp__tile-copy">
                  <strong>{host.name}</strong>
                  <small>{host.maker}</small>
                  {host.status && (
                    <span class="ahp__chip" data-status={host.status}>{AGENT_HOST_STATUS_LABELS[host.status]}</span>
                  )}
                </span>
              </button>
            </li>
          ))}
        </ul>
      </details>
    )}

    {audience === "setter" && (
      <p class="ahp__footer">
        Someone else's agent? Invite the person; they connect it themselves.
        <button class="ahp__link" type="button" data-agent-owner-teammate>Invite someone</button>
      </p>
    )}
  </div>

  {detailHosts.map((host) => (
    <section class="ahp__view ahp__detail" data-ahp-detail={host.id} aria-labelledby={`ahp-${audience}-${host.id}-title`} hidden>
      <button class="ahp__back" type="button" data-ahp-back>
        <span aria-hidden="true">←</span> All apps
      </button>
      <header class="ahp__detail-head">
        <span class:list={["ahp__orb", "ahp__orb--large", host.logo ? "ahp__orb--logo" : `ahp__orb--${orbHue[host.id] ?? "lavender"}`]} aria-hidden="true">
          {host.logo
            ? <img src={host.logo.src} alt="" width="28" height="28" loading="lazy" class:list={[{ "ahp__logo--tile": host.logo.tile }]} />
            : <span>{orbLetters(host)}</span>}
        </span>
        <div>
          <h2 class="ahp__title" id={`ahp-${audience}-${host.id}-title`} tabindex="-1">Connect {host.name}</h2>
          {host.status && (
            <span class="ahp__chip" data-status={host.status}>{AGENT_HOST_STATUS_LABELS[host.status]}</span>
          )}
        </div>
      </header>

      <ol class="ahp__steps">
        {stepsOf(host).map((step) => (
          <li class="ahp__step">
            <p>
              {pieces(step.text).map((piece) =>
                piece.kind === "workspace" ? <strong data-ahp-slot="workspace">{piece.value}</strong>
                  : piece.kind === "email" ? <span data-ahp-slot="email">{piece.value}</span>
                    : piece.value)}
            </p>
            {step.address && (
              <div class="ahp__copyable">
                <code class="ahp__value">{AGENT_CONNECTOR_ADDRESS}</code>
                <button class="ahp__copy" type="button" data-ahp-copy={AGENT_CONNECTOR_ADDRESS} aria-label="Copy the connector address">Copy</button>
              </div>
            )}
            {step.code && (
              <div class="ahp__copyable ahp__copyable--code">
                <pre class="ahp__value">{step.code}</pre>
                <button class="ahp__copy" type="button" data-ahp-copy={step.code} aria-label="Copy the command">Copy</button>
              </div>
            )}
            {step.say && (
              <div class="ahp__copyable ahp__copyable--say">
                <q class="ahp__value">{step.say}</q>
                <button class="ahp__copy" type="button" data-ahp-copy={step.say} aria-label="Copy the sentence">Copy</button>
              </div>
            )}
            {step.link && (
              <a class="ahp__button" href={step.link.href} rel="nofollow">{step.link.label}</a>
            )}
          </li>
        ))}
      </ol>

      {host.testing && (
        <details class="ahp__testing">
          <summary>{host.testing.heading}</summary>
          <ol class="ahp__steps">
            {host.testing.steps.map((step) => (
              <li class="ahp__step">
                <p>
                  {pieces(step.text).map((piece) =>
                    piece.kind === "workspace" ? <strong data-ahp-slot="workspace">{piece.value}</strong>
                      : piece.kind === "email" ? <span data-ahp-slot="email">{piece.value}</span>
                        : piece.value)}
                </p>
                {step.address && (
                  <div class="ahp__copyable">
                    <code class="ahp__value">{AGENT_CONNECTOR_ADDRESS}</code>
                    <button class="ahp__copy" type="button" data-ahp-copy={AGENT_CONNECTOR_ADDRESS} aria-label="Copy the connector address">Copy</button>
                  </div>
                )}
                {step.say && (
                  <div class="ahp__copyable ahp__copyable--say">
                    <q class="ahp__value">{step.say}</q>
                    <button class="ahp__copy" type="button" data-ahp-copy={step.say} aria-label="Copy the sentence">Copy</button>
                  </div>
                )}
              </li>
            ))}
          </ol>
        </details>
      )}

      <ul class="ahp__notes" role="list">
        {notesOf(host).map((note) => <li>{note}</li>)}
      </ul>

      {/* Only /app watches the roster while a host page is open, so only the setter sees a
          live "waiting" line; on /invite nothing polls, and a pulse there would never end. */}
      {host.status && host.status !== "waiting" && audience === "setter" && (
        <p class="ahp__waiting" data-ahp-waiting role="status" aria-live="polite">
          <span class="ahp__pulse" aria-hidden="true"></span>
          <span data-ahp-waiting-text>Waiting for {host.name} to join <span data-ahp-slot="workspace-plain">this workspace</span>.</span>
        </p>
      )}
      {host.status && host.status !== "waiting" && audience === "joiner" && (
        <p class="ahp__waiting">
          When {host.name} has joined, it shows up in <span data-ahp-slot="workspace-plain">this workspace</span> under your name.
        </p>
      )}
    </section>
  ))}

  <section class="ahp__view ahp__joined" data-ahp-joined aria-labelledby={`ahp-${audience}-joined-title`} hidden>
    <span class="ahp__orb ahp__orb--large ahp__orb--sage" aria-hidden="true"><span>✓</span></span>
    <h2 class="ahp__title" id={`ahp-${audience}-joined-title`} tabindex="-1" data-ahp-joined-title>Your agent joined.</h2>
    <p class="ahp__lead" data-ahp-joined-lead>It checks messages when you chat with it.</p>
    <div class="ahp__actions">
      <button class="ahp__button" type="button" data-ahp-approve>Let it use Lists &amp; docs</button>
      <button class="ahp__button ahp__button--quiet" type="button" data-ahp-another>Add another agent</button>
    </div>
  </section>

  <p class="ahp__status" role="status" aria-live="polite" data-ahp-status></p>
</agent-host-picker>

<script>
  /** How long the waiting line stays plain before it adds the "not there yet" hint. */
  const WAITING_HINT_MS = 120_000;

  class AgentHostPickerElement extends HTMLElement {
    static observedAttributes = ["workspace-name", "account-email"];

    #hostId = "";
    #joinedPrincipalId = "";
    #waitingTimer: number | undefined;
    #copyTimer: number | undefined;

    connectedCallback(): void {
      if (this.dataset.wired === "true") return;
      this.dataset.wired = "true";
      for (const tile of this.querySelectorAll<HTMLButtonElement>("[data-ahp-host]")) {
        const id = tile.dataset.ahpHost ?? "";
        // The terminal tile belongs to the host page's key flow (data-agent-owner-self).
        if (id === "terminal") continue;
        tile.addEventListener("click", () => this.showHost(id));
      }
      for (const back of this.querySelectorAll<HTMLButtonElement>("[data-ahp-back]")) {
        back.addEventListener("click", () => {
          this.reset();
          this.dispatchEvent(new CustomEvent("agent-host-back", { bubbles: true }));
        });
      }
      for (const button of this.querySelectorAll<HTMLButtonElement>("[data-ahp-copy]")) {
        button.addEventListener("click", () => void this.#copy(button));
      }
      this.querySelector<HTMLButtonElement>("[data-ahp-approve]")?.addEventListener("click", () => {
        this.dispatchEvent(new CustomEvent("agent-host-approve", {
          bubbles: true,
          detail: { principalId: this.#joinedPrincipalId },
        }));
      });
      this.querySelector<HTMLButtonElement>("[data-ahp-another]")?.addEventListener("click", () => {
        this.reset();
        this.dispatchEvent(new CustomEvent("agent-host-another", { bubbles: true }));
      });
      this.#render();
    }

    disconnectedCallback(): void {
      window.clearTimeout(this.#waitingTimer);
      window.clearTimeout(this.#copyTimer);
    }

    attributeChangedCallback(): void {
      this.#render();
    }

    /** The host currently shown, or "" on the grid and the joined receipt. */
    get hostId(): string {
      return this.#hostId;
    }

    setContext(context: { workspaceName?: string; accountEmail?: string }): void {
      if (context.workspaceName !== undefined) this.setAttribute("workspace-name", context.workspaceName);
      if (context.accountEmail !== undefined) this.setAttribute("account-email", context.accountEmail);
    }

    /** Back to the grid. Clears the waiting line and any copy status. */
    reset(): void {
      this.#hostId = "";
      this.#joinedPrincipalId = "";
      window.clearTimeout(this.#waitingTimer);
      this.#show("grid");
      this.#status("");
    }

    showHost(id: string): void {
      const panel = this.querySelector<HTMLElement>(`[data-ahp-detail="${CSS.escape(id)}"]`);
      if (!panel) return;
      this.#hostId = id;
      this.#show(id);
      this.#resetWaiting(panel);
      panel.querySelector<HTMLElement>(".ahp__title")?.focus({ preventScroll: true });
      panel.scrollIntoView?.({ block: "start" });
      this.dispatchEvent(new CustomEvent("agent-host-selected", { bubbles: true, detail: { host: id } }));
    }

    /** Called by the host page when an agent owned by this person appears in the workspace. */
    showJoined(agent: { name: string; principalId: string; canApprove: boolean }): void {
      window.clearTimeout(this.#waitingTimer);
      this.#joinedPrincipalId = agent.principalId;
      const workspace = this.getAttribute("workspace-name")?.trim() || "this workspace";
      const title = this.querySelector<HTMLElement>("[data-ahp-joined-title]");
      const lead = this.querySelector<HTMLElement>("[data-ahp-joined-lead]");
      const approve = this.querySelector<HTMLButtonElement>("[data-ahp-approve]");
      if (title) title.textContent = `${agent.name} joined ${workspace}.`;
      if (lead) lead.textContent = `${agent.name} checks messages when you chat with it.`;
      if (approve) {
        approve.textContent = `Let ${agent.name} use Lists & docs`;
        approve.hidden = !agent.canApprove;
      }
      this.#hostId = "";
      this.#show("joined");
      title?.focus({ preventScroll: true });
    }

    #show(view: string): void {
      this.querySelector<HTMLElement>("[data-ahp-view='grid']")!.hidden = view !== "grid";
      for (const panel of this.querySelectorAll<HTMLElement>("[data-ahp-detail]")) {
        panel.hidden = panel.dataset.ahpDetail !== view;
      }
      const joined = this.querySelector<HTMLElement>("[data-ahp-joined]");
      if (joined) joined.hidden = view !== "joined";
    }

    #resetWaiting(panel: HTMLElement): void {
      window.clearTimeout(this.#waitingTimer);
      const text = panel.querySelector<HTMLElement>("[data-ahp-waiting-text]");
      const hint = panel.querySelector<HTMLElement>("[data-ahp-waiting-hint]");
      hint?.remove();
      if (!text) return;
      this.#waitingTimer = window.setTimeout(() => {
        const workspace = this.getAttribute("workspace-name")?.trim() || "this workspace";
        const extra = document.createElement("span");
        extra.dataset.ahpWaitingHint = "";
        extra.className = "ahp__waiting-hint";
        extra.textContent =
          ` Not there yet? Check that you allowed ${workspace} on the approval page, then say the sentence again.`;
        text.after(extra);
      }, WAITING_HINT_MS);
    }

    #render(): void {
      const workspace = this.getAttribute("workspace-name")?.trim() || "this workspace";
      const email = this.getAttribute("account-email")?.trim() || "your account";
      for (const node of this.querySelectorAll<HTMLElement>("[data-ahp-slot='workspace'], [data-ahp-slot='workspace-plain']")) {
        node.textContent = workspace;
      }
      for (const node of this.querySelectorAll<HTMLElement>("[data-ahp-slot='email']")) {
        node.textContent = email;
      }
    }

    #status(message: string): void {
      const status = this.querySelector<HTMLElement>("[data-ahp-status]");
      if (status) status.textContent = message;
    }

    async #copy(button: HTMLButtonElement): Promise<void> {
      const value = button.dataset.ahpCopy ?? "";
      let copied = false;
      try {
        await navigator.clipboard.writeText(value);
        copied = true;
      } catch {
        // Clipboard access can be refused; select the visible value so the person can copy it.
        const target = button.previousElementSibling;
        if (target) {
          const range = document.createRange();
          range.selectNodeContents(target);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
      }
      window.clearTimeout(this.#copyTimer);
      for (const other of this.querySelectorAll<HTMLButtonElement>("[data-ahp-copy]")) other.textContent = "Copy";
      button.textContent = copied ? "Copied" : "Selected";
      this.#status(copied ? "Copied." : "Copy is blocked here. The text is selected; press Command or Control and C.");
      this.#copyTimer = window.setTimeout(() => {
        button.textContent = "Copy";
      }, 2_000);
    }
  }

  if (!customElements.get("agent-host-picker")) {
    customElements.define("agent-host-picker", AgentHostPickerElement);
  }
</script>

<style>
  .ahp {
    display: block;
    color: var(--text);
  }

  .ahp__view {
    display: grid;
    gap: var(--s-6);
  }

  .ahp__view[hidden] {
    display: none;
  }

  .ahp__head {
    display: grid;
    gap: var(--s-2);
  }

  .ahp__eyebrow {
    margin: 0;
    color: var(--accent-bright);
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .ahp__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-2xl);
    line-height: var(--lh-2xl);
    letter-spacing: var(--track-head);
    font-weight: var(--weight-head);
    text-wrap: balance;
  }

  .ahp__title:focus {
    outline: none;
  }

  .ahp__lead {
    max-inline-size: 58ch;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-base);
    line-height: var(--lh-base);
  }

  .ahp__group {
    display: grid;
    gap: var(--s-3);
  }

  .ahp__group-title {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .ahp__tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr));
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ahp__tile {
    inline-size: 100%;
    min-block-size: 4.25rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    color: var(--text);
    font: inherit;
    text-align: start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--ring-top);
    cursor: pointer;
    transition:
      border-color var(--dur-2) var(--ease-standard),
      box-shadow var(--dur-2) var(--ease-standard),
      transform var(--dur-2) var(--ease-standard);
  }

  .ahp__tile:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .ahp__tile:focus-visible,
  .ahp__copy:focus-visible,
  .ahp__back:focus-visible,
  .ahp__link:focus-visible,
  .ahp__button:focus-visible,
  .ahp__more > summary:focus-visible,
  .ahp__testing > summary:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .ahp__tile-copy {
    display: grid;
    justify-items: start;
    gap: 0.1rem;
    min-inline-size: 0;
  }

  .ahp__tile-copy strong {
    font-weight: var(--weight-semibold);
    font-size: var(--t-base);
    line-height: 1.3;
  }

  .ahp__tile-copy small {
    color: var(--text-muted);
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
  }

  .ahp__tile-copy .ahp__chip {
    margin-block-start: 0.3rem;
  }

  .ahp__orb {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 50%;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
    background: radial-gradient(circle at 32% 28%, #ffffff 0, var(--ahp-orb, #b8adf2) 62%);
    box-shadow: 0 10px 18px -12px rgba(37, 42, 50, 0.35);
  }

  .ahp__orb--large {
    inline-size: 3.25rem;
    block-size: 3.25rem;
    font-size: var(--t-base);
  }

  .ahp__orb--lavender { --ahp-orb: #b8adf2; }
