---
/*
 * THE MOMENT A PERSON TURNS THEIR OWN AGENT INTO A PARTICIPANT.
 *
 * Everything before this screen is setup — sign in, have a workspace. This is the step that
 * changes what the product is for the reader, and it is the one screen where getting the
 * shape wrong is expensive: the output is a live credential that is shown exactly once.
 *
 * THE HUMAN MINTS, THE AGENT RECEIVES. `create_agent_principal` and `mint_agent_token` are in
 * HUMAN_ONLY_COMMANDS (src/protocol/workspace-commands.ts:106-116), so an agent credential can
 * never produce another one. That was a security rule first, and it is also why this belongs
 * in a browser rather than in the CLI: the person is already signed in here, and handing over
 * a block of text is something a person does well.
 *
 * WHAT THE READER COPIES IS A PROMPT, NOT A COMMAND. It is addressed to the agent and includes
 * the live installer, workspace, connection details, one credential, and the rule not to echo
 * that credential back. The person does one thing with the result: Copy, paste, done.
 *
 * NO FORM OF ITS OWN. The Add an agent panel names the agent (Terminal agent, Grok Bot) and calls
 * requestPromptNamed; People & agents asks for a new key with requestPromptFor. This element
 * checks the session, mints, and shows the one-time result.
 *
 * NO SSR AND NO STATE IN THE MARKUP. Every state this element can be in is rendered here at
 * build time and switched with `data-state` on the host, because Astro scopes styles to
 * elements present in this template — markup created later by script would render unstyled.
 * The only thing the script writes into the DOM is text.
 */

interface Props {
  /** Optional: the host page may pin the workspace. Left off, the element finds one itself. */
  workspaceId?: string;
  workspaceName?: string;
  class?: string;
}

import { h0LinkJoinEnabled } from "../../lib/h0-link-join-flag";
import { joinInviteLimitSentence } from "../../../../src/protocol/agent-join-limits";

const {
  workspaceId,
  workspaceName,
  class: className,
} = Astro.props;
---

<agent-connect
  class:list={["ac", className]}
  data-state="loading"
  workspace-id={workspaceId}
  workspace-name={workspaceName}
>
  <div class="ac__panel" data-panel="loading">
    <h2 class="ac__muted ac__loading-title" data-slot="loading-title">Checking your session…</h2>
  </div>

  <div class="ac__panel ac__panel--state" data-panel="state">
    <h2 class="ac__state-title" data-slot="state-title">Not available</h2>
    <p class="ac__state-body" data-slot="state-body"></p>
    <button class="ac__btn ac__btn--quiet" type="button" data-action="retry" hidden>
      Try again
    </button>
  </div>

  <div class="ac__panel ac__form" data-panel="form">
    <p class="ac__form-error" data-slot="form-error" role="alert" hidden></p>
    {h0LinkJoinEnabled && (
      <div class="ac__field" data-h0-link-join>
        <p class="ac__hint">
          The joining agent chooses its name. {joinInviteLimitSentence()}
        </p>
        <button class="ac__btn ac__btn--quiet" type="button" data-action="mint-join">
          Create an invite
        </button>
      </div>
    )}
  </div>

  <div class="ac__panel ac__result" data-panel="result">
    <div class="ac__result-copy">
      <h2 class="ac__result-title">Your agent prompt is ready.</h2>
      <p class="ac__result-lead">
        Copy it before you leave this screen. This page closes it when the agent first connects.
      </p>
    </div>

    <p class="ac__warn" role="note">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path
          d="M12 8.4v4.4M12 16.2h.01M10.3 4.2 2.9 17.4a1.9 1.9 0 0 0 1.7 2.9h14.8a1.9 1.9 0 0 0 1.7-2.9L13.7 4.2a1.9 1.9 0 0 0-3.4 0Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span>The prompt or setup file can expose a secret to the model. Share it only with the assistant you intend to connect.</span>
    </p>

    <button class="ac__btn ac__btn--primary ac__btn--copy" type="button" data-action="copy">
      <span data-slot="copy-label">Copy prompt</span>
    </button>

    <button class="ac__btn ac__btn--quiet" type="button" data-action="download-connection">Use a setup file</button>

    <details class="ac__show">
      <summary>Show the prompt</summary>
      <div class="ac__block">
        <pre class="ac__pre" data-slot="prompt" tabindex="0" aria-label="The block to give your agent"></pre>
      </div>
      <p class="ac__hint">
        If you lose it, create another. Where the app supports it, the hosted connector keeps the secret out of the model.
      </p>
    </details>

    <p class="ac__status" role="status" aria-live="polite" data-slot="copy-status"></p>

    <p class="ac__hint" data-slot="connection-policy"></p>

    <div class="ac__result-actions">
      {h0LinkJoinEnabled && (
        <button class="ac__btn ac__btn--quiet" type="button" data-action="revoke-join" hidden>
          Revoke this invite
        </button>
      )}
      <button class="ac__btn ac__btn--quiet" type="button" data-action="done">
        Done
      </button>
    </div>
  </div>
</agent-connect>

<script>
  import {
    AGENT_TOKEN_MAX_TTL_MS,
    AgentConnectRefused,
    AgentNameTaken,
    ClientTooOld,
    CredentialNotShown,
    MintOutcomeUnknown,
    createAgentIdentity,
    ensureBrowserDevice,
    mintAgentCredential,
    myAgents,
    type AgentIdentity,
  } from "../../lib/agent-connect";
  import { connectionPolicyCopy } from "../../lib/standing-grants";
  import {
    NoDeployment,
    agentAccessStatuses,
    AuthRecoveryRequired,
    SessionExpired,
    currentSession,
    isMultiAccountEnabled,
    onAccountForcedTeardown,
    pinAccountContext,
    deployment,
    myWorkspaces,
    uuid,
  } from "../../lib/commonswarm";
  import { dashboardAgentPrompt, dashboardAgentConnection, dashboardAgentFilePrompt, promptCopyPayload } from "./agent-prompt";
  import { h0LinkJoinEnabled, loadLinkJoin } from "../../lib/h0-link-join-flag";
  import { callLinkJoin } from "../../lib/h0-link-join-load";
  import {
    concealJoinInvite,
    dismissShownJoin,
    shownJoinAfterRevoke,
  } from "../../lib/h0-link-join-flag-meaning";

  /*
   * A custom element rather than a page script, so the host page can drop <AgentConnect /> in
   * and optionally pin a workspace with an attribute, without this file knowing anything about
   * the page it lands on. Pages that own the workspace choice set workspace-id; pages that
   * don't let the element find one.
   */
  type MintRequest = ({ principalId: string } | { name: string }) & { workspaceId: string; userId: string; intent: number };

  class AgentConnectElement extends HTMLElement {
    static observedAttributes = ["workspace-id", "workspace-name"];

    /** Held only between the mint returning and the reader clearing the screen. */
    #prompt: string | null = null;
    /** Counts every change of the shown prompt; a Copy remembers the count it started under. */
    #promptEpoch = 0;
    #connection: string | null = null;
    #filePrompt: string | null = null;
    #connectionName = "cswarm-connection.json";
    #tokenId: string | null = null;
    #workspaceId = "";
    #workspaceName = "";
    #agents: AgentIdentity[] = [];
    #busy = false;
    /* The intent generation of the key mint in flight; null for none, or for an invite mint. */
    #busyIntent: number | null = null;
    #copyTimer: number | undefined;
    #pollTimer: number | undefined;
    #loadQueued = false;
    #loadVersion = 0;
    /* What the page asked to mint once the element is ready: a new key for an agent that exists,
       or a new agent with the name the Add an agent panel took. It is bound to the workspace and
       the account that asked, and to the intent generation it was asked in. */
    #request: MintRequest | null = null;
    /* Raised by every reset (auth change, sign-out, abandonment, disposal). A request or an
       in-flight mint from an older generation creates, mints, shows and copies nothing more. */
    #intentGeneration = 0;
    #retargetPending = false;
    #inviteId: string | null = null;
    #joinActive = false;
    #copyLabel = "Copy prompt";
    #tokenResultTitle = "";
    #tokenResultLead = "";
    /* Attributes present in the markup fire attributeChangedCallback during upgrade, BEFORE
       connectedCallback — so without this the element would load twice on every page. */
    #ready = false;
    #unsubForcedTeardown: (() => void) | null = null;

    connectedCallback() {
      if (this.#ready) return;
      this.#wire();
      this.#ready = true;
      void this.#load();
    }

    disconnectedCallback() {
      this.#unsubForcedTeardown?.();
      this.#unsubForcedTeardown = null;
      this.retirePending();
      window.clearTimeout(this.#copyTimer);
      window.clearInterval(this.#pollTimer);
    }

    attributeChangedCallback() {
      /* A queued request belongs to the workspace it was asked in; another workspace drops it. */
      if (this.#request && this.#request.workspaceId !== (this.getAttribute("workspace-id")?.trim() ?? "")) {
        this.#request = null;
      }
      if (!this.#ready || !this.isConnected) return;
      if (this.#busy || this.dataset.state === "done") {
        this.#retargetPending = true;
        return;
      }
      this.#queueLoad();
    }

    #queueLoad() {
      if (this.#loadQueued) return;
      this.#loadQueued = true;
      queueMicrotask(() => {
        this.#loadQueued = false;
        if (this.isConnected && !this.#busy) void this.#load();
      });
    }

    #q<T extends Element>(selector: string): T | null {
      return this.querySelector<T>(selector);
    }

    #text(slot: string, value: string) {
      const node = this.#q<HTMLElement>(`[data-slot="${slot}"]`);
      if (slot === "prompt" && node && node.textContent !== value) {
        // The disclosure belongs to one prompt. Whenever the shown prompt is cleared or replaced, fold it
        // again and retire any Copy still waiting on the old one, so a new credential never appears already open.
        this.#promptEpoch += 1;
        node.closest("details")?.removeAttribute("open");
      }
      if (node) node.textContent = value;
    }

    #state(value: string) {
      this.dataset.state = value;
    }

    #blocked(title: string, body: string, retry = false) {
      this.#text("state-title", title);
      this.#text("state-body", body);
      const button = this.#q<HTMLButtonElement>('[data-action="retry"]');
      if (button) button.hidden = !retry;
      this.#state("blocked");
      /* A request waiting on this load is dropped, never carried to a later load. */
      const request = this.#request;
      this.#request = null;
      if (request && "name" in request) this.#failed(body, true);
    }

    #wire() {
      /* Pin the clipboard flavour for a MANUAL copy out of the block. Without this the browser
       * also writes text/html, and a Markdown client converts that instead of the plain text:
       * underscores return as \_ and a bare URL returns as a Markdown link. The Copy button was
       * never the problem — writeText() is plain text — but selecting the block by hand was. */
      this.#q<HTMLElement>('[data-slot="prompt"]')?.addEventListener("copy", (event) => {
        const clipboard = (event as ClipboardEvent).clipboardData;
        if (!clipboard || !this.#prompt) return;
        clipboard.setData("text/plain", promptCopyPayload(window.getSelection()?.toString() ?? "", this.#prompt));
        event.preventDefault();
      });
      this.#q<HTMLButtonElement>('[data-action="download-connection"]')?.addEventListener("click", () => this.#downloadConnection());
      this.#q<HTMLButtonElement>('[data-action="retry"]')?.addEventListener("click", () => {
        void this.#load();
      });
      this.#q<HTMLButtonElement>('[data-action="copy"]')?.addEventListener("click", () => {
        void this.#copy();
      });
      this.#q<HTMLButtonElement>('[data-action="done"]')?.addEventListener("click", () => {
        this.finishPrompt("done");
      });
      // Rev 4 §4: Forced teardown (cross-tab sign-out, Sign out all, terminal expiry)
      // immediately clears any displayed connect credential & retires in-flight mints.
      if (typeof onAccountForcedTeardown === "function") {
        this.#unsubForcedTeardown = onAccountForcedTeardown(() => {
          this.clearPrompt();
          this.retirePending();
        });
      }
      if (h0LinkJoinEnabled) {
        window.addEventListener("pagehide", () => {
          if (this.#joinActive) this.finishPrompt("done");
        });
        if (this.#tokenResultTitle === "") {
          this.#tokenResultTitle = this.querySelector(".ac__result-title")?.textContent ?? "";
          this.#tokenResultLead = this.querySelector(".ac__result-lead")?.textContent ?? "";
        }
        const api = {
          workspaceId: () => this.#workspaceId,
          session: () => currentSession(),
          tryBegin: () => {
            if (this.#busy) return false;
            this.#busy = true;
            this.toggleAttribute("data-mint-busy", true);
            return true;
          },
          end: () => {
            this.#busy = false;
            this.toggleAttribute("data-mint-busy", false);
            if (this.#retargetPending && this.dataset.state !== "done") {
              this.#retargetPending = false;
              this.#queueLoad();
            }
          },
          setMintPending: (pending: boolean) => {
            const button = this.querySelector<HTMLButtonElement>('[data-action="mint-join"]');
            if (!button) return;
            button.disabled = pending;
            button.textContent = pending ? "Creating the invite…" : "Create an invite";
          },
          showInvite: (reveal: {
            paste: string | null;
            inviteId: string;
            documentUrl: string;
            lead: string;
            withheld: boolean;
          }) => this.#showJoinInvite(reveal),
          formError: (message: string | null) => this.#formError(message),
          note: (message: string) => this.#text("copy-status", message),
          markRevoked: (message: string, inviteId: string) => this.#markJoinRevoked(message, inviteId),
          inviteId: () => this.#inviteId,
        };
        const joining = loadLinkJoin();
        const showJoinLoadError = (message: string): void => {
          api.formError(message);
        };
        callLinkJoin(joining, () => undefined, showJoinLoadError);
        this.querySelector<HTMLButtonElement>('[data-action="mint-join"]')?.addEventListener("click", () => {
          callLinkJoin(joining, (module) => {
            void module.startJoinMint(api);
          }, showJoinLoadError);
        });
        this.querySelector<HTMLButtonElement>('[data-action="revoke-join"]')?.addEventListener("click", () => {
          callLinkJoin(joining, (module) => {
            void module.startJoinRevoke(api);
          }, showJoinLoadError);
        });
      }
    }

    /**
     * Retire whatever was asked for and not yet shown: the queued request, an in-flight mint
     * (which stops at its next step) and any load still running for it. Called on every auth
     * reset (through clearPrompt), on sign-out, and when the person abandons the request.
     */
    retirePending() {
      const pending = this.#request !== null || this.#busy;
      this.#intentGeneration += 1;
      this.#request = null;
      if (this.dataset.state === "loading") this.#loadVersion += 1;
      /* The panel's Copy setup prompt waits on this request; tell it the request is gone. */
      if (pending) this.dispatchEvent(new CustomEvent("commonswarm:agent-prompt-retired", { bubbles: true }));
    }

    clearPrompt(notify = true) {
      this.retirePending();
      this.finishPrompt("done", notify);
    }

    /**
     * The ticket a caller takes at its click, before any await: this element's intent generation then.
     * Every retirement raises the generation (Back and leaving the key view, choosing another app,
     * leaving the panel, the auth reset and sign-out through clearPrompt, disposal), so a ticket taken
     * before one of them never becomes a request (HezSec C1 on #479, narrowed).
     */
    get intentTicket(): number {
      return this.#intentGeneration;
    }

    /** Re-onboard one existing identity through the same mint and prompt path as Add an agent. */
    requestPromptFor(principalId: string, userId: string, workspaceId: string, ticket: number) {
      if (principalId) this.#requestPrompt({ principalId }, userId, workspaceId, ticket);
    }

    /** Create a new agent with this name and mint its prompt (the Add an agent panel's key routes). */
    requestPromptNamed(name: string, userId: string, workspaceId: string, ticket: number) {
      const trimmed = name.trim();
      if (trimmed) this.#requestPrompt({ name: trimmed }, userId, workspaceId, ticket);
    }

    /* The caller names the account, the workspace and the ticket of its click (HezSec C1 on #479). A
       request for any workspace other than the one this element is pinned to now, or with a ticket an
       abandonment has retired since, is a click that was superseded on its way here: it is refused
       before it becomes a request, so it never mints. The element never lends a newer generation to an
       older click. */
    #requestPrompt(request: { principalId: string } | { name: string }, userId: string, workspaceId: string, ticket: number) {
      if (!userId || !workspaceId || workspaceId !== (this.getAttribute("workspace-id")?.trim() ?? "")) return;
      if (ticket !== this.#intentGeneration) return;
      /* The roster remains reachable in the channel header while a prompt is visible. Never
         replace one live secret with another; the reader must copy or close the first one. */
      /* A mint retired by a reset (sign-out, account switch, abandonment) may still be unwinding: it
         creates and shows nothing more, but holds the single-mint guard until its current step
         returns. A new request waits for it, bound like any other, and #mint's finally loads and runs
         it, so every check before create, mint and reveal still applies (474 R2 deferred P2). */
      const unwinding = this.#busy && this.#busyIntent !== null && this.#busyIntent !== this.#intentGeneration;
      let blocked = (this.#busy && !unwinding) || this.#prompt !== null;
      if (h0LinkJoinEnabled) {
        blocked = blocked || this.#joinActive;
      }
      if (blocked) {
        /* The open prompt, or the one still being made, stays on screen. The asker hears that this
           request was not taken, so the panel's Copy setup prompt is ready again. */
        this.dispatchEvent(new CustomEvent("commonswarm:agent-prompt-retired", { bubbles: true }));
        return;
      }
      /* Bound to the workspace and the account it was asked in: a load that lands elsewhere, or
         a session that belongs to someone else, mints nothing. */
      this.#request = {
        ...request,
        workspaceId,
        userId,
        intent: this.#intentGeneration,
      };
      if (unwinding) return;
      if (
        this.dataset.state === "ready" &&
        this.#workspaceId === (this.getAttribute("workspace-id")?.trim() ?? "")
      ) {
        this.#mintRequestedPrompt();
        return;
      }
      this.#queueLoad();
    }

    finishPrompt(reason: "done" | "back" | "consumed", notify = true) {
      let leave = this.#prompt === null;
      if (h0LinkJoinEnabled) {
        leave = this.#prompt === null && !this.#joinActive;
      }
      if (leave) return;
      const tokenId = this.#tokenId;
      this.#forget();
      this.#state("ready");
      const retarget = this.#retargetPending;
      this.#retargetPending = false;
      if (notify) {
        this.dispatchEvent(
          new CustomEvent("commonswarm:agent-secret-cleared", {
            bubbles: true,
            detail: { reason, tokenId },
          }),
        );
      }
      if (retarget) this.#queueLoad();
    }

    /*
     * The credential leaves this page when the reader says so. The <pre> is the only place it
     * was ever written, so emptying that node and dropping the reference is the whole of it —
     * there is no cache, no localStorage entry, and no history entry to clean up.
     */
    #downloadConnection() {
      if (this.#connection === null || this.#filePrompt === null) return;
      const url = URL.createObjectURL(new Blob([this.#connection], { type: "application/json" }));
      const link = document.createElement("a");
      link.href = url;
      link.download = this.#connectionName;
      link.click();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      this.#prompt = this.#filePrompt;
      this.#text("prompt", this.#prompt);
      this.#resetCopyLabel();
      this.#text("copy-status", "Attach the downloaded setup file and paste this shorter prompt into your assistant.");
    }

    #forget() {
      if (h0LinkJoinEnabled) {
        if (this.#joinActive) {
          const hidden = concealJoinInvite({
            paste: this.#prompt,
            inviteId: this.#inviteId ?? "",
          });
          this.#prompt = hidden.paste;
        }
        const next = dismissShownJoin({
          inviteId: this.#inviteId,
          joinActive: this.#joinActive,
          prompt: this.#prompt,
        });
        this.#inviteId = next.inviteId;
        this.#joinActive = next.joinActive;
        this.#prompt = next.prompt;
        this.#restoreTokenResult();
      }
      this.#prompt = null;
      this.#connection = null;
      this.#filePrompt = null;
      this.#tokenId = null;
      window.clearInterval(this.#pollTimer);
      this.#pollTimer = undefined;
      this.#text("prompt", "");
      this.#text("connection-policy", "");
      this.#text("copy-status", "");
      this.#resetCopyLabel();
    }

    async #load() {
      const version = ++this.#loadVersion;
      this.#state("loading");
      if (!deployment()) {
        this.#blocked(
          "Use the live CommonSwarm site",
          "This saved copy cannot create an assistant key. Open commonswarm.com/app and " +
            "continue there. Nothing is wrong with your account.",
        );
        return;
      }

      let session;
      try {
        session = await currentSession();
      } catch (error) {
        if (version !== this.#loadVersion) return;
        if (error instanceof SessionExpired) {
          this.#blocked(
            "Sign in first",
            "Only a signed-in person can create an assistant key. Sign in, and this step will " +
              "be waiting.",
          );
          return;
        }
        this.#blocked(
          "Couldn't check your sign-in",
          error instanceof AuthRecoveryRequired
            ? error.message
            : "CommonSwarm could not check your sign-in. Try again.",
          true,
        );
        return;
      }
      if (version !== this.#loadVersion) return;
      if (!session) {
        this.#blocked(
          "Sign in first",
          "Only a signed-in person can create an assistant key. Sign in, and this step will " +
            "be waiting.",
        );
        return;
      }

      const pinned = this.getAttribute("workspace-id")?.trim() ?? "";
      const pinnedName = this.getAttribute("workspace-name")?.trim() ?? "";
      try {
        let nextWorkspaceId: string;
        let nextWorkspaceName: string;
        if (pinned) {
          nextWorkspaceId = pinned;
          nextWorkspaceName = pinnedName || pinned;
        } else {
          const workspaces = await myWorkspaces();
          if (version !== this.#loadVersion) return;
          const first = workspaces[0];
          if (!first) {
            this.#blocked(
              "You're not in a workspace yet",
              "Create a workspace above, or accept an invite from a teammate, then return " +
                "here to connect your AI assistant.",
            );
            return;
          }
          nextWorkspaceId = first.id;
          nextWorkspaceName = first.name;
        }
        const nextAgents = await myAgents(session, nextWorkspaceId);
        if (version !== this.#loadVersion) return;
        this.#workspaceId = nextWorkspaceId;
        this.#workspaceName = nextWorkspaceName;
        this.#agents = nextAgents;
        this.#text("workspace-name", this.#workspaceName);
      } catch (error) {
        if (version !== this.#loadVersion) return;
        this.#blocked(
          "Couldn't read this workspace",
          error instanceof NoDeployment
            ? "Open commonswarm.com/app and continue on the live site."
            : "CommonSwarm could not load the assistants already connected here, so it " +
              "stopped before adding anything. Try again.",
          true,
        );
        return;
      }

      this.#state("ready");
      this.#mintRequestedPrompt();
    }

    #mintRequestedPrompt() {
      const request = this.#request;
      if (!request || this.dataset.state !== "ready") return;
      this.#request = null;
      if (request.intent !== this.#intentGeneration) return;
      if (request.workspaceId !== this.#workspaceId) {
        this.#failed("The workspace changed before the prompt was created. Nothing was created.", "name" in request);
        return;
      }
      if ("principalId" in request && !this.#agents.some((agent) => agent.principalId === request.principalId)) {
        this.#failed("That AI assistant is no longer available. Reload the roster and try again.", false);
        return;
      }
      void this.#mint(request);
    }

    #formError(message: string | null) {
      const node = this.#q<HTMLElement>('[data-slot="form-error"]');
      if (!node) return;
      node.textContent = message ?? "";
      node.hidden = message === null;
    }

    /* A refusal is shown here, and the page is told: a name typed in the Add an agent panel is
       fixed there, beside the name. */
    #failed(message: string, named: boolean) {
      this.#formError(message);
      this.dispatchEvent(new CustomEvent("commonswarm:agent-prompt-failed", {
        bubbles: true,
        detail: { message, named },
      }));
    }

    async #mint(request: MintRequest) {
      /* ★ THE GUARD IS SET HERE, NOT 30 LINES DOWN, AND THE GAP WAS A DOUBLE-MINT.
         `#busy` used to be checked here and assigned only after `await currentSession()`
         and the validation below. Two submits inside that window — a double-click, or
         Enter held on the form — both passed the check while it was still false, and both
         went on to mint. That is TWO live agent credentials for one press, of which the UI
         shows one; the other is unrevocable in practice because its id was never displayed.
         A re-entrancy guard has to be set in the same synchronous turn it is tested in;
         anything else is a race with a comment on it. The finally below is what makes
         setting it this early safe — every early return still clears it. */
      if (this.#busy) return;
      this.#busy = true;
      this.#busyIntent = request.intent;
      this.toggleAttribute("data-mint-busy", true);
      try {
        await this.#mintGuarded(request);
      } finally {
        this.#busy = false;
        this.#busyIntent = null;
        this.toggleAttribute("data-mint-busy", false);
        if (this.#retargetPending && this.dataset.state !== "done") {
          this.#retargetPending = false;
          this.#queueLoad();
        } else if (this.#request && this.dataset.state !== "done") {
          /* A request that waited for this retired mint to unwind: a fresh load reads the session
             and the workspace again, then runs it through #mintRequestedPrompt. */
          this.#queueLoad();
        }
      }
    }

    /* Every step that creates, mints or shows something first checks that its request is still
       the live one and that the signed-in account is the one that asked. Leaving says nothing:
       the person who asked has gone, and the person now here did not ask. */
    #stillAsked(request: MintRequest, userId: string | undefined): boolean {
      return request.intent === this.#intentGeneration && userId === request.userId
        && request.workspaceId === this.#workspaceId;
    }

    #abandon() {
      this.#formError(null);
      this.#state("ready");
    }

    async #mintGuarded(request: MintRequest) {
      this.#formError(null);
      const named = "name" in request;
      const multiEnabled = typeof isMultiAccountEnabled === "function" && isMultiAccountEnabled();
      const pinned = multiEnabled
        ? pinAccountContext({ userId: request.userId, workspaceId: this.#workspaceId })
        : null;
      if (multiEnabled && (!pinned || !pinned.isCurrent(this.#workspaceId))) {
        this.#abandon();
        return;
      }

      let session;
      try {
        session = await currentSession();
      } catch (error) {
        if (request.intent !== this.#intentGeneration || (pinned && !pinned.isCurrent(this.#workspaceId))) {
          this.#abandon();
          return;
        }
        if (error instanceof SessionExpired) {
          this.#blocked(
            "Your sign-in expired",
            "No key was created. Sign in again and come back to this step.",
          );
          this.#failed("Your sign-in expired. No key was created.", named);
          return;
        }
        this.#state("ready");
        this.#failed(this.#explain(error), named);
        return;
      }
      if (request.intent !== this.#intentGeneration || (pinned && !pinned.isCurrent(this.#workspaceId))) {
        this.#abandon();
        return;
      }
      if (session && session.user.id !== request.userId) {
        this.#abandon();
        return;
      }
      if (!session) {
        this.#blocked(
          "Your sign-in expired",
          "No key was created. Sign in again and come back to this step.",
        );
        this.#failed("Your sign-in expired. No key was created.", named);
        return;
      }

      /* #busy is owned by #mint()'s wrapper now — it is set before the first await and
         cleared in a finally there, so assigning it again here would be a second source of
         truth for one flag. */
      this.#text("loading-title", "Creating the key…");
      this.#state("working");

      /*
       * ONE COMMAND ID PER INTENT, GENERATED HERE. The server replays a repeated id instead of
       * acting twice, which is what makes a network retry safe — and generating a fresh id
       * inside a retry is what once minted a second live credential. Nothing below retries by
       * itself; a failure is reported and the reader decides.
       */
      const identityCommandId = `web_${uuid()}`;
      const mintCommandId = `web_${uuid()}`;

      try {
        // The device has to exist before the mint will be accepted at all.
        const deviceId = await ensureBrowserDevice(session);
        if (!this.#stillAsked(request, session.user.id) || (pinned && !pinned.isCurrent(this.#workspaceId))) return this.#abandon();

        const identity: AgentIdentity = "principalId" in request
          ? this.#agents.find((agent) => agent.principalId === request.principalId) ?? {
            principalId: request.principalId,
            name: "your agent",
            model: null,
          }
          : await createAgentIdentity(session, identityCommandId, this.#workspaceId, request.name);
        if (!this.#stillAsked(request, session.user.id) || (pinned && !pinned.isCurrent(this.#workspaceId))) return this.#abandon();

        const credential = await mintAgentCredential(
          session, mintCommandId, this.#workspaceId, identity, deviceId, AGENT_TOKEN_MAX_TTL_MS,
        );
        /* Before the secret is shown or copied: the same request, and the same account signed in. */
        if (!this.#stillAsked(request, (await currentSession())?.user.id) || (pinned && !pinned.isCurrent(this.#workspaceId))) {
          return this.#abandon();
        }

        const target = deployment();
        if (!target) throw new NoDeployment();

        const promptInput = {
          credential,
          workspaceId: this.#workspaceId,
          workspaceName: this.#workspaceName,
          deploymentUrl: target.url,
          anonKey: target.anonKey,
        };
        this.#prompt = dashboardAgentPrompt(promptInput);
        if (h0LinkJoinEnabled) {
          this.#restoreTokenResult();
        }
        this.#connection = dashboardAgentConnection(promptInput);
        this.#filePrompt = dashboardAgentFilePrompt(promptInput);
        this.#connectionName = `cswarm-connection-${credential.principalId}.json`;
        this.#text("connection-policy", connectionPolicyCopy(credential, false));
        this.#text("prompt", this.#prompt);
        this.#tokenId = credential.tokenId;
        this.#text("copy-status", "");
        this.#resetCopyLabel();
        this.#state("done");
        this.dispatchEvent(
          new CustomEvent("commonswarm:agent-prompt-ready", {
            bubbles: true,
            detail: {
              principalId: credential.principalId,
              name: credential.principalName,
              model: identity.model,
              tokenId: credential.tokenId,
              workspaceId: this.#workspaceId,
              /* Created from the Add an agent panel's name, not a new key for an agent that exists. */
              named,
            },
          }),
        );
        this.#watchForFirstUse(credential.tokenId);
        /* "Copy setup prompt" copies when the browser still allows it after the mint; when it
           does not, the Copy prompt button under the result does it. */
        if (named) void this.#copy(true);
      } catch (error) {
        this.#state("ready");
        if (request.intent === this.#intentGeneration) this.#failed(this.#explain(error), named);
      } finally {
        this.#text("loading-title", "Checking your session…");
      }
      /* No `finally { #busy = false }` here: #mint()'s wrapper clears it, and clearing it
         twice would let a second submit through while this call was still unwinding. */
    }

    #watchForFirstUse(tokenId: string) {
      window.clearInterval(this.#pollTimer);
      let checking = false;
      const check = async () => {
        if (checking || this.#prompt === null || this.#tokenId !== tokenId) return;
        checking = true;
        try {
          const [status] = await agentAccessStatuses(this.#workspaceId, tokenId);
          if (status?.firstUsedAt) this.finishPrompt("consumed");
        } catch {
          // Polling is advisory. Pending access remains the durable place to
          // inspect or cancel a credential if this read temporarily fails.
        } finally {
          checking = false;
        }
      };
      this.#pollTimer = window.setInterval(() => void check(), 1_800);
    }

    /*
     * Every branch here names what is now true. A refusal says nothing was created; an unknown
     * outcome says nobody knows, and does not invite a retry that could double-issue.
     */
    #explain(error: unknown): string {
      if (error instanceof AgentNameTaken) {
        return `“${error.agentName}” is already in this workspace. Choose another name.`;
      }
      if (error instanceof CredentialNotShown) {
        return "That key was created during an earlier attempt and cannot be shown again. Create a new key.";
      }
      if (error instanceof ClientTooOld) {
        return "This saved page is out of date. Reload the live site before creating a key; nothing was created here.";
      }
      if (error instanceof AgentConnectRefused) {
        return "CommonSwarm did not complete this step. Nothing new was added. Check that you are signed in with a confirmed email, then try again.";
      }
      if (error instanceof MintOutcomeUnknown) {
        return "CommonSwarm could not confirm whether this step finished. Reload the page and look at what already exists before trying again.";
      }
      if (error instanceof AuthRecoveryRequired) {
        return error.message;
      }
      if (error instanceof SessionExpired) {
        return "Your sign-in expired. No key was created.";
      }
      if (error instanceof NoDeployment) {
        return "Open commonswarm.com/app and continue on the live site.";
      }
      return "Something went wrong before a key was created. Nothing was added.";
    }

    #showJoinInvite(reveal: {
      paste: string | null;
      inviteId: string;
      documentUrl: string;
      lead: string;
      withheld: boolean;
    }) {
      this.#text("connection-policy", "");
      this.#joinActive = true;
      this.#inviteId = reveal.inviteId;
      this.#connection = null;
      this.#filePrompt = null;
      this.#tokenId = null;
      this.#copyLabel = reveal.withheld ? "Copy prompt" : "Copy invite";
      const title = this.querySelector(".ac__result-title");
      if (title) title.textContent = reveal.withheld ? "The invite was created." : "Your invite is ready.";
      const lead = this.querySelector(".ac__result-lead");
      if (lead) lead.textContent = reveal.lead;
      const download = this.querySelector<HTMLButtonElement>('[data-action="download-connection"]');
      if (download) download.hidden = true;
      const revoke = this.querySelector<HTMLButtonElement>('[data-action="revoke-join"]');
      if (revoke) {
        revoke.hidden = false;
        revoke.disabled = false;
      }
      const copy = this.querySelector<HTMLButtonElement>('[data-action="copy"]');
      if (reveal.withheld || reveal.paste === null) {
        this.#prompt = null;
        this.#text("prompt", "");
        if (copy) copy.disabled = true;
        this.#text("copy-status", reveal.lead);
      } else {
        this.#prompt = reveal.paste;
        this.#text("prompt", reveal.paste);
        if (copy) copy.disabled = false;
        this.#text("copy-status", "");
        this.#resetCopyLabel();
      }
      this.#state("done");
      this.dispatchEvent(
        new CustomEvent("commonswarm:agent-prompt-ready", {
          bubbles: true,
          detail: { workspaceId: this.#workspaceId },
        }),
      );
    }

    #markJoinRevoked(message: string, revokedInviteId: string) {
      const next = shownJoinAfterRevoke(
        {
          inviteId: this.#inviteId,
          joinActive: this.#joinActive,
          prompt: this.#prompt,
        },
        revokedInviteId,
      );
      if (next === null) return;
      const hidden = concealJoinInvite({
        paste: this.#prompt,
        inviteId: this.#inviteId ?? "",
      });
      this.#prompt = hidden.paste;
      this.#joinActive = next.joinActive;
      this.#inviteId = next.inviteId;
      this.#text("prompt", "");
      this.#text("copy-status", message);
      const title = this.querySelector(".ac__result-title");
      if (title) title.textContent = "This invite is revoked.";
      const lead = this.querySelector(".ac__result-lead");
      if (lead) lead.textContent = message;
      const copy = this.querySelector<HTMLButtonElement>('[data-action="copy"]');
      if (copy) copy.disabled = true;
      const revoke = this.querySelector<HTMLButtonElement>('[data-action="revoke-join"]');
      if (revoke) revoke.disabled = true;
    }

    #restoreTokenResult() {
      this.#copyLabel = "Copy prompt";
      this.#joinActive = false;
      this.#inviteId = null;
      const title = this.querySelector(".ac__result-title");
      if (title && this.#tokenResultTitle) title.textContent = this.#tokenResultTitle;
      const lead = this.querySelector(".ac__result-lead");
      if (lead && this.#tokenResultLead) lead.textContent = this.#tokenResultLead;
      const download = this.querySelector<HTMLButtonElement>('[data-action="download-connection"]');
      if (download) download.hidden = false;
      const revoke = this.querySelector<HTMLButtonElement>('[data-action="revoke-join"]');
      if (revoke) {
        revoke.hidden = true;
        revoke.disabled = false;
      }
      const copy = this.querySelector<HTMLButtonElement>('[data-action="copy"]');
      if (copy) copy.disabled = false;
    }

    #resetCopyLabel() {
      this.#text("copy-label", this.#copyLabel);
      const button = this.#q<HTMLButtonElement>('[data-action="copy"]');
      button?.removeAttribute("data-copied");
    }

    /*
     * A copy button with no confirmation is a button people press twice. The label changes,
     * the button holds a copied state for a moment, and the live region says it out loud for
     * anyone not watching the button.
     */
    async #copy(quiet = false) {
      if (!this.#prompt) return;
      const button = this.#q<HTMLButtonElement>('[data-action="copy"]');
      // The clipboard answers later. By then this prompt may have been cleared or replaced, and the answer
      // must never act on a different one.
      const prompt = this.#prompt;
      const epoch = this.#promptEpoch;
      const stillThisPrompt = () => epoch === this.#promptEpoch && this.#prompt === prompt;
      try {
        await navigator.clipboard.writeText(this.#prompt);
      } catch {
        if (quiet || !stillThisPrompt()) return;
        // Clipboard access can be refused outright (permissions, or a non-secure origin). The
        // honest fallback is to select the text so the reader's own copy shortcut works.
        const pre = this.#q<HTMLElement>('[data-slot="prompt"]');
        if (pre) {
          // The prompt sits in a closed disclosure; a selection inside it is only usable once it is open.
          pre.closest("details")?.setAttribute("open", "");
          const range = document.createRange();
          range.selectNodeContents(pre);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
        this.#text("copy-status", "Your browser wouldn't let the page copy. It's selected — press ⌘C or Ctrl+C.");
        return;
      }
      if (!stillThisPrompt()) return;
      this.#text("copy-label", "Copied");
      button?.setAttribute("data-copied", "");
      this.#text("copy-status", "Copied. Paste the whole prompt into your AI assistant.");
      window.clearTimeout(this.#copyTimer);
      this.#copyTimer = window.setTimeout(() => this.#resetCopyLabel(), 2400);
    }
  }

  if (!customElements.get("agent-connect")) {
    customElements.define("agent-connect", AgentConnectElement);
  }
</script>

<style>
  /* One card. The step is a single decision followed by a single artifact, and splitting it
     across two surfaces would make the credential look like a separate screen you could
     navigate back to — which is exactly what it is not. */
  .ac {
    min-inline-size: 0;
    inline-size: 100%;
    display: block;
    padding: var(--pad-card-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--ring-top), var(--shadow-md);
    max-inline-size: var(--measure-wide);
  }


  .ac__muted {
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
    color: var(--text-muted);
  }

  /* Every panel is in the DOM at build time and switched by data-state on the host, so Astro's
     scoping attribute is on all of them. Nothing here is created by script. */
  .ac__panel {
    min-inline-size: 0;
    display: none;
    flex-direction: column;
    gap: var(--stack-lg);
  }

  /* Working shares the loading line ("Creating the key…"): one quiet line, not a progress screen. */
  .ac[data-state="loading"] [data-panel="loading"],
  .ac[data-state="working"] [data-panel="loading"],
  .ac[data-state="blocked"] [data-panel="state"],
  .ac[data-state="ready"] [data-panel="form"],
  .ac[data-state="done"] [data-panel="result"] {
    display: flex;
  }

  .ac__panel--state {
    gap: var(--stack-sm);
    align-items: flex-start;
  }

  .ac__state-title {
    font-size: var(--t-lg);
    line-height: var(--lh-lg);
    font-weight: var(--weight-semibold);
    color: var(--text);
  }

  .ac__loading-title {
    margin: 0;
    font-weight: var(--weight-body);
  }

  .ac__state-body {
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
    color: var(--text-muted);
  }

  .ac__field {
    display: flex;
    flex-direction: column;
    gap: var(--stack-xs);
  }

  .ac__hint {
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
    color: var(--text-faint);
  }

  .ac__warn {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    padding: var(--pad-card-sm);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
    color: var(--text);
    background: var(--warning-dim);
    border: 1px solid var(--warning-dim);
    border-radius: var(--radius);
  }

  .ac__warn svg {
    flex: none;
    margin-block-start: 0.15em;
    color: var(--warning);
  }

  .ac__form-error {
    padding: var(--pad-card-sm);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
    color: var(--text);
    background: var(--danger-dim);
    border-radius: var(--radius);
  }

  .ac__btn {
    align-self: flex-start;
    padding: var(--s-3) var(--s-5);
    font-family: inherit;
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
    font-weight: var(--weight-semibold);
    color: var(--text);
    background: var(--elev-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      background var(--dur-2) var(--ease-standard),
      transform var(--dur-1) var(--ease-standard);
  }

  .ac__btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .ac__btn:active {
    transform: translateY(1px);
  }

  .ac__btn--primary {
    color: var(--accent-ink);
    background: linear-gradient(180deg, var(--accent-bright), var(--accent));
    border-color: transparent;
    box-shadow: var(--ring-top);
  }

  .ac__btn--quiet {
    background: transparent;
    font-weight: var(--weight-medium);
    color: var(--text-muted);
  }

  .ac__result-copy {
    display: grid;
    gap: var(--s-2);
  }

  .ac__result-title {
    margin: 0;
    color: var(--text);
    font-size: var(--t-xl);
    line-height: var(--lh-xl);
    letter-spacing: var(--track-head);
    font-weight: var(--weight-head);
  }

  .ac__result-lead {
    max-inline-size: 58ch;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .ac__block {
    min-inline-size: 0;
    inline-size: 100%;
    max-inline-size: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--elev-3);
    overflow: hidden;
  }



  /* The prompt is long and machine-written; it stays folded until someone wants to read it. */
  .ac__show {
    min-inline-size: 0;
    inline-size: 100%;
  }

  .ac__show > summary {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .ac__show > summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .ac__show[open] > summary {
    margin-block-end: var(--s-2);
  }

  .ac__show > .ac__hint {
    margin-block-start: var(--s-3);
  }

  /* The one primary action of the result panel: copying the prompt is the whole point of this screen. */
  .ac__btn--copy {
    align-self: stretch;
    padding: var(--s-4) var(--s-6);
    font-size: var(--t-base);
    line-height: var(--lh-base);
  }

  /* Copied feedback stays violet: a green success state would certify the wrong thing —
     nothing here has succeeded except the clipboard. */
  .ac__btn--copy[data-copied] {
    background: var(--accent);
  }

  /* The block scrolls inside its own box rather than wrapping: this text is going to an agent
     verbatim, and a soft-wrapped continuation of a flag reads as a different flag. */
  .ac__pre {
    min-inline-size: 0;
    inline-size: 100%;
    max-inline-size: 100%;
    max-block-size: 22rem;
    padding: var(--s-4);
    overflow: auto;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1.7;
    color: var(--text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    tab-size: 2;
  }

  .ac__pre:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  .ac__status {
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
    color: var(--text-muted);
    min-block-size: 1.2em;
  }

  .ac__result-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-inline);
  }

  @media (width <= 64rem) {
    .ac__btn { min-inline-size: 44px; min-block-size: 44px; }
  }

  @media (max-width: 30rem) {
    .ac {
      padding: var(--pad-card);
    }

    .ac__btn {
      align-self: stretch;
      text-align: center;
    }
  }
</style>
