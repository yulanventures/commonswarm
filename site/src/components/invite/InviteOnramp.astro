---
/*
 * /invite: the page a household member opens from a private link.
 *
 * WHO READS IT. The second person in a household. She is not a developer, so every sentence
 * here is in household words: who invited her, what she will see, what stays private, what she
 * can do. The protocol words stay out of this file (a test fails if they come back).
 *
 * THE ORDER. Sign in as herself, review and join, then connect her own agents on step 2 when
 * she preset one on the review card. Host steps come from agent-hosts.ts; no keys, no commands.
 *
 * THE ACCESS CHOICE. The two roles and their sentences come from household-access.ts, the same
 * module the dashboard reads, so the two screens cannot describe a role differently. Nothing is
 * preselected: she picks one and ticks the box before the join is allowed.
 *
 * STYLING CHILD COMPONENTS. ProviderButtons renders its own buttons, and Astro scopes this
 * page's CSS only to elements written in this file. The button and provider-list rules are
 * therefore reached through :global() under .invite-onramp.
 */
import { CONTENT_ROLES, CONTENT_ROLE_COPY } from "../../lib/household-access";
import { INVITE_CONNECT_FOOTNOTE, inviteAssistantHosts } from "../../lib/agent-hosts";
import ProviderButtons from "../auth/ProviderButtons.astro";
import Wordmark from "../Wordmark.astro";
import "../../styles/home/onboarding.css";

const assistantHosts = inviteAssistantHosts();
---

<invite-onramp class="invite-onramp" data-state="loading">
  <div class="invite-onramp__brand"><Wordmark href="/" /></div>

  <section class="invite-onramp__panel" data-view="loading" role="status" aria-live="polite">
    <span class="invite-onramp__spinner" aria-hidden="true"></span>
    <p>Opening your invitation…</p>
  </section>

  <section class="invite-onramp__panel invite-onramp__card" data-view="unusable" hidden>
    <p class="invite-onramp__eyebrow">Invitation unavailable</p>
    <h1 class="invite-onramp__title">This link can’t be used.</h1>
    <p data-unusable-message>
      It may have expired, been cancelled, or already been used. Ask the sender for a new link.
    </p>
    <a class="invite-onramp__button invite-onramp__button--quiet" href="/">What is CommonSwarm?</a>
  </section>

  <section class="invite-onramp__panel invite-onramp__card" data-view="auth" hidden>
    <h1 class="invite-onramp__title"><span data-inviter>A teammate</span> invited you to <span data-workspace>a workspace</span>.</h1>
    <p class="invite-onramp__lead">
      Sign in as yourself to accept. New to CommonSwarm? Signing in creates your free account.
    </p>
    <ol class="invite-onramp__steps" role="list" aria-label="What happens next">
      <li><span>1</span>Sign in as yourself</li>
      <li><span>2</span>Choose what you share</li>
      <li><span>3</span>Connect your own agents</li>
    </ol>
    <ProviderButtons
      buttonClass="invite-onramp__button invite-onramp__button--quiet"
      listClass="invite-onramp__providers"
    >
      <div slot="after" class="invite-onramp__divider" aria-hidden="true"><span>or</span></div>
    </ProviderButtons>
    <form class="invite-onramp__auth" data-email-form>
      <label for="invite-email">Email address</label>
      <input id="invite-email" type="email" autocomplete="email" required placeholder="you@example.com" />
      <button class="invite-onramp__button" type="submit">Email me a sign-in link</button>
    </form>
    <p class="invite-onramp__status" data-auth-status role="status" aria-live="polite"></p>
    <p class="invite-onramp__error" data-auth-error role="alert" hidden></p>
  </section>

  <section class="invite-onramp__panel invite-onramp__card" data-view="sender" hidden>
    <h1 class="invite-onramp__title">This link is for the person you invited.</h1>
    <p class="invite-onramp__lead">Send it to them; don't open it yourself.</p>
    <button class="invite-onramp__button" type="button" data-copy-sender>Copy invite link</button>
    <p class="invite-onramp__status" data-sender-status role="status" aria-live="polite"></p>
    <a class="invite-onramp__button invite-onramp__button--quiet" href="/app">Back to the workspace</a>
  </section>

  <section class="invite-onramp__panel invite-onramp__card" data-view="review" hidden aria-labelledby="invite-review-title">
    <h1 class="invite-onramp__title" id="invite-review-title"><span data-inviter>A teammate</span> invited you to <span data-review-workspace>Home</span>.</h1>

    <div class="invite-onramp__facts">
      <h2 class="invite-onramp__facet">Who is here</h2>
      <p data-review-audience></p>
      <h2 class="invite-onramp__facet">What you will see</h2>
      <p data-review-disclosure></p>
      <p class="invite-onramp__private"><strong>What stays private:</strong> your other workspaces.</p>
    </div>

    <fieldset class="invite-onramp__choices">
      <legend>Your access</legend>
      <div class="invite-onramp__choice-list">
        {CONTENT_ROLES.map((role) => (
          <label class="invite-onramp__choice">
            <input type="radio" name="invite-content-role" value={role} data-content-role />
            <span>
              <strong>{CONTENT_ROLE_COPY[role].label}</strong>
              <small>{CONTENT_ROLE_COPY[role].detail}</small>
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="invite-onramp__choices">
      <legend>Which assistant will you bring?</legend>
      <div class="invite-onramp__assistant-list">
        {assistantHosts.map((host) => (
          <label class="invite-onramp__choice invite-onramp__assistant">
            <input type="radio" name="invite-assistant" value={host.id} data-assistant-host />
            <span>
              <strong>{host.name}</strong>
              <small>{host.maker}</small>
            </span>
          </label>
        ))}
        <label class="invite-onramp__choice invite-onramp__assistant">
          <input type="radio" name="invite-assistant" value="just-me" data-assistant-host />
          <span><strong>Just me for now</strong></span>
        </label>
      </div>
    </fieldset>

    <label class="invite-onramp__consent">
      <input type="checkbox" data-independent-consent />
      <span>I'm joining as myself.</span>
    </label>
    <p class="invite-onramp__hint" data-review-hint role="alert" hidden></p>

    <div class="invite-onramp__actions">
      <button class="invite-onramp__button" type="button" data-confirm-join><span class="invite-onramp__label">Join <span data-join-workspace-name>Home</span></span></button>
      <a class="invite-onramp__button invite-onramp__button--quiet" href="/app">Not now</a>
    </div>
    <p class="invite-onramp__fineprint" data-review-expiry></p>
  </section>

  <section class="invite-onramp__panel" data-view="joining" hidden role="status" aria-live="polite">
    <span class="invite-onramp__spinner" aria-hidden="true"></span>
    <p>Joining <strong data-workspace>a workspace</strong>…</p>
  </section>

  <section class="invite-onramp__panel invite-onramp__card" data-view="join-error" hidden>
    <p class="invite-onramp__eyebrow">Connection interrupted</p>
    <h1 class="invite-onramp__title">Let’s check the invitation again.</h1>
    <p>
      CommonSwarm could not confirm whether you joined. Your invitation is still saved
      safely in this browser.
    </p>
    <button class="invite-onramp__button" type="button" data-retry-join>Try again</button>
  </section>

  <section class="invite-onramp__connect hm-invite-connect" data-view="connect" hidden>
    <p class="hm-invite-connect__step" data-connect-step-label hidden>Step 2 of 2</p>
    <div class="hm-invite-connect__capsule" data-connect-capsule hidden aria-label="You and your assistant">
      <span class="hm-invite-connect__person" data-connect-initials aria-hidden="true"></span>
      <span class="hm-invite-connect__agent" aria-hidden="true"></span>
    </div>
    <p class="hm-invite-connect__status" data-connect-status hidden></p>
    <h1 class="hm-invite-connect__title invite-onramp__title" data-connect-title tabindex="-1">Connect your assistant.</h1>
    <ol class="hm-ahp__steps" data-connect-steps hidden></ol>
    <ul class="hm-ahp__notes" data-connect-notes hidden role="list"></ul>
    <a class="invite-onramp__button" data-connect-open hidden rel="nofollow">Open assistant</a>
    <button class="hm-invite-connect__copy-link" type="button" data-connect-copy hidden>Copy the connect prompt instead</button>
    <p class="hm-invite-connect__footnote" data-connect-footnote hidden>{INVITE_CONNECT_FOOTNOTE}</p>
    <div class="invite-onramp__receipt" data-connect-receipt>
      <span class="invite-onramp__receipt-mark" aria-hidden="true">✓</span>
      <h2 class="invite-onramp__receipt-title">You're in <span data-workspace>a workspace</span>.</h2>
    </div>
    <a class="invite-onramp__button" href="/app">Open the workspace</a>
  </section>

  <section class="invite-onramp__panel invite-onramp__card" data-view="complete" hidden>
    <p class="invite-onramp__eyebrow">You’re in</p>
    <h1 class="invite-onramp__title" data-complete-title>Agent access is ready.</h1>
    <p>
      Open the workspace to see the shared channel. Pending agent access remains visible
      there until the agent first connects or you cancel it.
    </p>
    <a class="invite-onramp__button" href="/app">Open the workspace</a>
  </section>
</invite-onramp>

<script>
  import {
    EmailAddressRejected,
    EmailRateLimited,
    currentSession,
    client,
    deployment,
    myWorkspaces,
    signInWithEmail,
    signInWithProvider,
  } from "../../lib/commonswarm";
  import { authProvider, listSentence } from "../../lib/auth-providers";
  import {
    assertInviteDeployment,
    decodeMemberInvite,
    forgetInvite,
    memberInviteUrl,
    recalledInvite,
    rememberInvite,
    type MemberInvitePayload,
  } from "../../lib/member-invite";

  import { browserHumanInvitations, HumanInviteRefused } from '../../lib/human-invitations';
  import type { HumanInvitePreview } from '../../../../src/cloud/human-invitations';
  import {
    AGENT_CONNECTOR_ADDRESS,
    AGENT_HOST_STATUS_LABELS,
    DESKTOP_SIGN_IN_NOTE,
    INVITE_CONNECT_FOOTNOTE,
    MENU_LABELS_NOTE,
    TURN_ONLY_NOTE,
    inviteAssistantHosts,
    joinSentence,
    privacyNote,
    type AgentHost,
    type AgentHostStep,
  } from "../../lib/agent-hosts";
  const host = document.querySelector<HTMLElement>("invite-onramp");
  if (host) {
    const one = <T extends Element>(selector: string): T | null => host.querySelector<T>(selector);
    let payload: MemberInvitePayload | null = null;
    let resumeId = "";
    let senderLink = "";
    let authGeneration = 0;
    let authUser: string | null = null;
    let authEmail: string | null = null;
    let preview: HumanInvitePreview | null = null;
    let prepared: ReturnType<ReturnType<typeof browserHumanInvitations>['prepareAcceptance']> | null = null;

    /*
     * The provider names for prose, read off the BUTTONS THAT ARE ON THIS PAGE.
     *
     * Not off a second list, and not typed. AGENTS.md: "If a user-facing string lists things
     * the code enforces … that list must come from the same constant the enforcement reads."
     * The buttons are already generated from AUTH_PROVIDERS, so deriving the sentence from
     * the buttons makes the sentence and the choices the same set by construction — there is
     * no third place for the two to drift apart.
     */
    const renderedProviderNames = (): string[] =>
      [...host.querySelectorAll<HTMLElement>("[data-signin-provider]")]
        .map((button) => button.dataset.signinProvider ?? "")
        .map((id) => {
          try {
            return authProvider(id).name;
          } catch {
            return "";
          }
        })
        .filter((name) => name.length > 0);

    const show = (name: string): void => {
      for (const view of host.querySelectorAll<HTMLElement>("[data-view]")) {
        view.hidden = view.dataset.view !== name;
      }
      host.dataset.state = name;
      window.requestAnimationFrame(() => {
        const heading = one<HTMLElement>(`[data-view="${name}"] h1, [data-view="${name}"] h2`);
        if (!heading) return;
        heading.tabIndex = -1;
        heading.focus({ preventScroll: true });
      });
    };

    const fillLabels = (invite: MemberInvitePayload): void => {
      for (const node of host.querySelectorAll<HTMLElement>("[data-inviter]")) {
        node.textContent = invite.inviter_display_name;
      }
      for (const node of host.querySelectorAll<HTMLElement>("[data-workspace]")) {
        node.textContent = invite.workspace_name;
      }
    };

    const unusable = (message?: string): void => {
      if (resumeId) forgetInvite(resumeId, localStorage);
      const node = one<HTMLElement>("[data-unusable-message]");
      if (node && message) node.textContent = message;
      show("unusable");
    };

    /*
     * The review's access choice. Two radio cards in a fieldset, each tagged data-content-role;
     * the chosen role is whichever one is checked. Nothing is checked until she picks one.
     */
    const roleChoices = (): HTMLInputElement[] =>
      [...host.querySelectorAll<HTMLInputElement>("[data-content-role]")];
    const assistantChoices = (): HTMLInputElement[] =>
      [...host.querySelectorAll<HTMLInputElement>("[data-assistant-host]")];
    const chosenRole = (): string => roleChoices().find((choice) => choice.checked)?.value ?? "";
    const chosenAssistant = (): string =>
      assistantChoices().find((choice) => choice.checked)?.value ?? "";
    const consentBox = (): HTMLInputElement => one<HTMLInputElement>("[data-independent-consent]")!;
    const reviewHint = (): HTMLElement => one<HTMLElement>("[data-review-hint]")!;
    const lockReview = (locked: boolean): void => {
      consentBox().disabled = locked;
      for (const choice of roleChoices()) choice.disabled = locked;
      for (const choice of assistantChoices()) choice.disabled = locked;
    };
    const resetReview = (): void => {
      lockReview(false);
      consentBox().checked = false;
      for (const choice of roleChoices()) choice.checked = false;
      for (const choice of assistantChoices()) choice.checked = false;
      reviewHint().hidden = true;
    };
    const reviewReady = (): boolean => {
      const role = chosenRole();
      return preview !== null && consentBox().checked && (role === "reader" || role === "editor");
    };

    const assistantCatalog = inviteAssistantHosts();
    const assistantStorageKey = (workspaceId: string): string => `invite-assistant:${workspaceId}`;
    const viewerInitials = (name: string): string =>
      name.replace(/[^\p{L}\p{N}]/gu, "").slice(0, 1).toLocaleUpperCase() || "Y";

    const connectNotes = (host: AgentHost): string[] => {
      const connects = (host.status !== null && host.status !== "waiting") || Boolean(host.testing);
      return [
        ...(connects ? [TURN_ONLY_NOTE, privacyNote(host.id === "other-app" ? "that app" : host.name)] : []),
        ...(host.desktopSignIn ? [DESKTOP_SIGN_IN_NOTE.joiner] : []),
        ...host.notes,
        MENU_LABELS_NOTE,
      ];
    };

    const fillConnectStep = (workspaceName: string, hostId: string): void => {
      const connectHost = assistantCatalog.find((entry) => entry.id === hostId) ?? null;
      const stepLabel = one<HTMLElement>("[data-connect-step-label]");
      const capsule = one<HTMLElement>("[data-connect-capsule]");
      const title = one<HTMLElement>("[data-connect-title]");
      const steps = one<HTMLOListElement>("[data-connect-steps]");
      const notes = one<HTMLUListElement>("[data-connect-notes]");
      const status = one<HTMLElement>("[data-connect-status]");
      const open = one<HTMLAnchorElement>("[data-connect-open]");
      const copy = one<HTMLButtonElement>("[data-connect-copy]");
      const footnote = one<HTMLElement>("[data-connect-footnote]");
      const receipt = one<HTMLElement>("[data-connect-receipt]");
      const showAssistant = connectHost !== null && hostId !== "just-me";
      if (stepLabel) stepLabel.hidden = !showAssistant;
      if (capsule) capsule.hidden = !showAssistant;
      if (footnote) footnote.hidden = !showAssistant;
      if (receipt) receipt.hidden = showAssistant;
      if (!showAssistant) {
        if (title) title.textContent = `You're in ${workspaceName}.`;
        if (steps) steps.hidden = true;
        if (notes) notes.hidden = true;
        if (status) status.hidden = true;
        if (open) open.hidden = true;
        if (copy) copy.hidden = true;
        return;
      }
      const first = authEmail?.split("@")[0] ?? "You";
      if (title) title.textContent = `Connect ${connectHost.name}.`;
      const initialsNode = one<HTMLElement>("[data-connect-initials]");
      if (initialsNode) initialsNode.textContent = viewerInitials(first);
      if (status) {
        if (connectHost.status) {
          status.textContent = AGENT_HOST_STATUS_LABELS[connectHost.status];
          status.dataset.status = connectHost.status;
          status.hidden = false;
        } else {
          status.hidden = true;
        }
      }
      const prompt = connectHost.steps.find((step) => step.say)?.say ?? joinSentence(connectHost.name);
      let promptElement: HTMLElement | null = null;
      if (steps) {
        steps.hidden = false;
        steps.replaceChildren();
        const renderStep = (step: AgentHostStep): HTMLLIElement => {
          const item = document.createElement("li");
          item.className = "hm-ahp__step";
          const paragraph = document.createElement("p");
          paragraph.textContent = step.text
            .replaceAll("{workspace}", workspaceName)
            .replaceAll("{email}", authEmail ?? "your account");
          item.append(paragraph);
          if (step.address) {
            const row = document.createElement("div");
            row.className = "hm-ahp__copyable";
            const code = document.createElement("code");
            code.className = "hm-ahp__value";
            code.textContent = AGENT_CONNECTOR_ADDRESS;
            row.append(code);
            item.append(row);
          }
          if (step.code) {
            const row = document.createElement("div");
            row.className = "hm-ahp__copyable";
            const code = document.createElement("pre");
            code.className = "hm-ahp__value";
            code.textContent = step.code;
            row.append(code);
            item.append(row);
          }
          if (step.say) {
            const row = document.createElement("div");
            row.className = "hm-ahp__copyable hm-ahp__copyable--say";
            const quote = document.createElement("q");
            quote.className = "hm-ahp__value";
            quote.textContent = step.say;
            if (!promptElement && step.say === prompt) promptElement = quote;
            row.append(quote);
            item.append(row);
          }
          if (step.link) {
            const link = document.createElement("a");
            link.className = "hm-ahp__button";
            link.href = step.link.href;
            link.rel = "nofollow";
            link.textContent = step.link.label;
            item.append(link);
          }
          return item;
        };
        for (const step of connectHost.steps) steps.append(renderStep(step));
      }
      if (notes) {
        const lines = connectNotes(connectHost);
        notes.hidden = lines.length === 0;
        notes.replaceChildren();
        for (const line of lines) {
          const item = document.createElement("li");
          item.textContent = line;
          notes.append(item);
        }
      }
      const linkStep = connectHost.steps.find((step) => step.link);
      if (open) {
        if (linkStep?.link) {
          open.href = linkStep.link.href;
          open.textContent = `Open ${connectHost.name}`;
          open.hidden = false;
        } else {
          open.hidden = true;
        }
      }
      if (copy) {
        copy.hidden = false;
        copy.onclick = async () => {
          let copied = false;
          try {
            await navigator.clipboard.writeText(prompt);
            copied = true;
          } catch {
            if (!promptElement && steps) {
              promptElement = document.createElement("q");
              promptElement.className = "hm-ahp__value";
              promptElement.textContent = prompt;
              steps.append(promptElement);
            }
            const target = promptElement;
            if (target) {
              const range = document.createRange();
              range.selectNodeContents(target);
              const selection = window.getSelection();
              selection?.removeAllRanges();
              selection?.addRange(range);
            }
          }
          copy.textContent = copied ? "Copied" : "Select and copy";
        };
      }
      if (footnote) footnote.textContent = INVITE_CONNECT_FOOTNOTE;
    };

    const continueToAgent = (workspaceId: string, workspaceName: string, hostId = chosenAssistant()): void => {
      for (const node of host.querySelectorAll<HTMLElement>('[data-view="connect"] [data-workspace]')) {
        node.textContent = workspaceName;
      }
      if (hostId) {
        try {
          sessionStorage.setItem(assistantStorageKey(workspaceId), hostId);
        } catch {
          // The connect step still works for this visit without persistence.
        }
      }
      fillConnectStep(workspaceName, hostId);
      const next = new URL("/invite", window.location.origin);
      next.searchParams.set("joined", workspaceId);
      history.replaceState(null, "", next);
      show("connect");
    };

    const accept = async (confirmed = false): Promise<void> => {
      if (!payload) return unusable();
      const sender = payload.inviter_display_name;
      const session = await currentSession();
      if (!session) return show("auth");
      authUser = session.user.id;
      authEmail = session.user.email ?? null;
      const generation = authGeneration;
      if (payload.inviter_user_id === session.user.id) {
        senderLink = memberInviteUrl(window.location.origin, payload);
        return show("sender");
      }
      show("joining");
      try {
        const existing = (await myWorkspaces()).find(
          (workspace) => workspace.id === payload?.workspace_id,
        );
        if (generation !== authGeneration) return;
        if (existing) {
          forgetInvite(resumeId, localStorage);
          continueToAgent(existing.id, existing.name);
          return;
        }
        const invitations = browserHumanInvitations();
        if (!confirmed) {
          prepared = null;
          const value = await invitations.preview({source:'link',token:payload.invitation_token});
          if (generation !== authGeneration) return;
          if (value.status === 'joined') return continueToAgent(value.workspace_id, value.workspace_name);
          preview = value;
          for (const node of host.querySelectorAll<HTMLElement>('[data-review-workspace]')) {
            node.textContent = value.workspace_name;
          }
          for (const node of host.querySelectorAll<HTMLElement>("[data-join-workspace-name]")) {
            node.textContent = value.workspace_name;
          }
          one<HTMLElement>('[data-review-audience]')!.textContent = value.audience.map(m => `${m.display_name} (${m.role})`).join(', ');
          one<HTMLElement>('[data-review-disclosure]')!.textContent = value.disclosure;
          one<HTMLElement>('[data-review-expiry]')!.textContent = 'This invitation expires ' + new Date(value.expires_at).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }) + '.';
          resetReview();
          return show('review');
        }
        const role = chosenRole();
        if (!preview || !consentBox().checked || (role !== 'reader' && role !== 'editor')) return show('review');
        lockReview(true);
        prepared ??= invitations.prepareAcceptance({source:'link',token:payload.invitation_token},preview,role);
        const accepted = await prepared.send();
        if (generation !== authGeneration) return;
        const workspaceId = String(accepted.workspace_id);
        const workspaceName = String(accepted.workspace_name);
        forgetInvite(resumeId, localStorage);
        continueToAgent(workspaceId, workspaceName);
      } catch (error) {
        if (generation !== authGeneration) return;
        try {
          const recovered = (await myWorkspaces()).find(
            (workspace) => workspace.id === payload?.workspace_id,
          );
          if (generation !== authGeneration) return;
          if (recovered) {
            forgetInvite(resumeId, localStorage);
            continueToAgent(recovered.id, recovered.name);
            return;
          }
        } catch {
          // The saved invitation remains available for an explicit retry.
        }
        if (error instanceof HumanInviteRefused && error.reason === 'review_changed') { preview = null; prepared = null; return await accept(); }
        if (!(error instanceof HumanInviteRefused)) {
          show("join-error");
          return;
        }
        unusable(`This invitation could not be accepted. It may have expired, or it may have been sent to a different email address. If you were just invited, ask ${sender} to check who can see the workspace.`);
      }
    };

    const boot = async (): Promise<void> => {
      const target = deployment();
      if (!target) {
        return unusable("This saved page is not connected to a CommonSwarm deployment.");
      }
      const url = new URL(window.location.href);
      const encoded = url.hash.startsWith("#invite=")
        ? url.hash.slice("#invite=".length)
        : "";
      if (encoded) {
        history.replaceState(null, "", new URL("/invite", window.location.origin));
      }
      try {
        if (encoded) {
          payload = decodeMemberInvite(encoded);
          assertInviteDeployment(payload, target);
          resumeId = rememberInvite(payload, localStorage);
          const clean = new URL("/invite", window.location.origin);
          clean.searchParams.set("resume", resumeId);
          history.replaceState(null, "", clean);
        } else {
          resumeId = url.searchParams.get("resume") ?? "";
          payload = resumeId ? recalledInvite(resumeId, localStorage) : null;
        }
      } catch {
        return unusable();
      }

      if (!payload) {
        const joinedId = url.searchParams.get("joined") ?? "";
        const session = await currentSession();
        authEmail = session?.user.email ?? null;
        const joined = session
          ? (await myWorkspaces()).find((workspace) => workspace.id === joinedId)
          : null;
        if (joined) {
          let hostId = "";
          try {
            hostId = sessionStorage.getItem(assistantStorageKey(joined.id)) ?? "";
          } catch {
            hostId = "";
          }
          return continueToAgent(joined.id, joined.name, hostId);
        }
        return unusable();
      }
      fillLabels(payload);
      await accept();
    };

    one<HTMLFormElement>("[data-email-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const input = one<HTMLInputElement>("#invite-email");
      const error = one<HTMLElement>("[data-auth-error]");
      const status = one<HTMLElement>("[data-auth-status]");
      if (!input || !resumeId) return;
      if (error) error.hidden = true;
      try {
        const redirect = new URL("/invite", window.location.origin);
        redirect.searchParams.set("resume", resumeId);
        await signInWithEmail(input.value.trim(), redirect.href);
        if (status) status.textContent = `Check ${input.value.trim()} for your sign-in link.`;
      } catch (caught) {
        const choices = listSentence(renderedProviderNames());
        if (error) {
          error.textContent = caught instanceof EmailRateLimited
            ? choices
              ? `Email delivery is busy. Sign in with ${choices}, or try again later.`
              : "Email delivery is busy. Try again later."
            : caught instanceof EmailAddressRejected
            ? "Enter a complete email address."
            : caught instanceof Error
            ? caught.message
            : "CommonSwarm could not send the sign-in link.";
          error.hidden = false;
        }
      }
    });

    /*
     * One handler for every generated button. The id comes off the element, so a provider
     * added to AUTH_PROVIDERS works here with no change: the button renders itself and
     * signInWithProvider re-checks the id against the same array before any request.
     */
    for (const button of host.querySelectorAll<HTMLButtonElement>("[data-signin-provider]")) {
      button.addEventListener("click", async () => {
        if (!resumeId) return;
        const id = button.dataset.signinProvider ?? "";
        const redirect = new URL("/invite", window.location.origin);
        redirect.searchParams.set("resume", resumeId);
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        try {
          await signInWithProvider(id, redirect.href);
        } catch {
          /*
           * No NoDeployment branch here, and it is not an oversight. Two things make that
           * state unreachable from this button: the buttons exist only when the BUILD read an
           * enabled provider off a deployment, and `boot()` above shows the "unusable" panel
           * and never reveals this view when `deployment()` is null at runtime.
           */
          const error = one<HTMLElement>("[data-auth-error]");
          if (error) {
            let name = "That";
            try {
              name = authProvider(id).name;
            } catch {
              name = "That";
            }
            error.textContent = `${name} sign-in could not start. Try the email option.`;
            error.hidden = false;
          }
          button.disabled = false;
          button.removeAttribute("aria-busy");
        }
      });
    }

    one<HTMLButtonElement>("[data-retry-join]")?.addEventListener("click", () => {
      void accept(true);
    });

    /*
     * Joining needs a chosen role and the ticked box. If either is missing, say which one
     * and stop here: sending the click on would flash the "Joining" screen and then quietly
     * return to this one.
     */
    one<HTMLButtonElement>("[data-confirm-join]")?.addEventListener("click", () => {
      if (reviewReady()) {
        reviewHint().hidden = true;
        void accept(true);
        return;
      }
      const noRole = chosenRole() === "";
      const noBox = !consentBox().checked;
      const hint = reviewHint();
      hint.textContent = noRole && noBox
        ? "Choose your access and tick the box to join."
        : noRole
        ? "Choose your access to join."
        : "Tick the box to confirm you are joining as yourself.";
      hint.hidden = false;
      (noRole ? roleChoices()[0] : consentBox())?.focus();
    });

    one<HTMLElement>('[data-view="review"]')?.addEventListener("change", () => {
      if (reviewReady()) reviewHint().hidden = true;
    });

    one<HTMLButtonElement>("[data-copy-sender]")?.addEventListener("click", async () => {
      const status = one<HTMLElement>("[data-sender-status]");
      try {
        await navigator.clipboard.writeText(senderLink);
        if (status) status.textContent = "Copied. Send it to the person you invited.";
      } catch {
        if (status) status.textContent = "Your browser blocked copy. Go back to the workspace and create a new link.";
      }
    });

    /*
     * Nothing on this page emits this event now that the one-time key flow is not part of the
     * joiner's path. The "complete" view and this listener stay so the page keeps one state
     * machine; they are the only way back in if that flow is ever added again.
     */
    host.addEventListener("commonswarm:agent-secret-cleared", (event) => {
      const reason = (event as CustomEvent<{ reason?: unknown }>).detail?.reason;
      const title = one<HTMLElement>("[data-complete-title]");
      if (title) {
        title.textContent = reason === "consumed"
          ? "Your agent connected."
          : "Agent access is ready.";
      }
      show("complete");
    });

    client()?.auth.onAuthStateChange((event, session) => {
      const user = session?.user.id ?? null;
      if (event === 'SIGNED_OUT' || authUser !== null && user !== authUser) {
        ++authGeneration; preview = null; prepared = null; payload = null;
        unusable('Sign in as the invited person and reopen the invitation.');
      }
      authUser = user;
      authEmail = session?.user.email ?? null;
    });
    void boot();
  }
</script>

