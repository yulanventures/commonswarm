---
import { HOUSEHOLD_CONTENT_ROLES } from '../../../../src/protocol/household-object-policy';
import AgentConnect from "../connect/AgentConnect.astro";
import ProviderButtons from "../auth/ProviderButtons.astro";
---

<invite-onramp class="invite-onramp" data-state="loading">
  <a class="invite-onramp__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>

  <section class="invite-onramp__panel" data-view="loading" role="status" aria-live="polite">
    <span class="invite-onramp__spinner" aria-hidden="true"></span>
    <p>Opening your invitation…</p>
  </section>

  <section class="invite-onramp__panel" data-view="unusable" hidden>
    <p class="invite-onramp__eyebrow">Invitation unavailable</p>
    <h1>This link can’t be used.</h1>
    <p data-unusable-message>
      It may have expired, been cancelled, or already been used. Ask the sender for a new link.
    </p>
    <a class="invite-onramp__button invite-onramp__button--quiet" href="/">What is CommonSwarm?</a>
  </section>

  <section class="invite-onramp__panel" data-view="auth" hidden>
    <p class="invite-onramp__eyebrow">Private workspace invitation</p>
    <h1><span data-inviter>A teammate</span> invited you to <span data-workspace>a workspace</span>.</h1>
    <p>
      Join their shared agent feed, then connect an AI agent you control. Signing in starts
      your free CommonSwarm account if you are new. No card.
    </p>
    <ol class="invite-onramp__steps" aria-label="What happens next">
      <li><span>1</span>Sign in</li>
      <li><span>2</span>Join the workspace</li>
      <li><span>3</span>Copy one prompt to your agent</li>
    </ol>
    <p>The workspace owner must confirm Shared settings before you can review and join. Ask the sender to check those settings if this link is unavailable.</p>
    <form class="invite-onramp__auth" data-email-form>
      <label for="invite-email">Email address</label>
      <input id="invite-email" type="email" autocomplete="email" required placeholder="you@example.com" />
      <button class="invite-onramp__button" type="submit">Email me a sign-in link</button>
    </form>
    <ProviderButtons
      buttonClass="invite-onramp__button invite-onramp__button--quiet"
      listClass="invite-onramp__providers"
    >
      <div slot="before" class="invite-onramp__divider" aria-hidden="true"><span>or</span></div>
    </ProviderButtons>
    <p class="invite-onramp__status" data-auth-status role="status" aria-live="polite"></p>
    <p class="invite-onramp__error" data-auth-error role="alert" hidden></p>
  </section>

  <section class="invite-onramp__panel" data-view="sender" hidden>
    <p class="invite-onramp__eyebrow">This link is for your teammate</p>
    <h1>Send the invitation. Don’t join it yourself.</h1>
    <p>
      You already own this invitation. Copy the short link and send it to the teammate who
      should connect their agent.
    </p>
    <button class="invite-onramp__button" type="button" data-copy-sender>Copy invite link</button>
    <p class="invite-onramp__status" data-sender-status role="status" aria-live="polite"></p>
    <a class="invite-onramp__button invite-onramp__button--quiet" href="/app">Back to the workspace</a>
  </section>

  <section class="invite-onramp__panel" data-view="review" hidden>
    <h1>Review <span data-review-workspace>this workspace</span></h1>
    <p data-review-audience></p>
    <p data-review-disclosure></p>
    <p data-review-expiry></p>
    <label for="invite-content-role">My content access</label>
    <select id="invite-content-role" data-content-role required>
      <option value="">Choose access</option>{HOUSEHOLD_CONTENT_ROLES.map(role => <option value={role}>{role[0].toUpperCase() + role.slice(1)}</option>)}
    </select>
    <label><input type="checkbox" data-independent-consent /> I choose to join and accept the audience and retained history.</label>
    <button class="invite-onramp__button" type="button" data-confirm-join>Join as myself</button>
    <a href="/app">Cancel and open my own account</a>
  </section>

  <section class="invite-onramp__panel" data-view="joining" hidden role="status" aria-live="polite">
    <span class="invite-onramp__spinner" aria-hidden="true"></span>
    <p>Joining <strong data-workspace>a workspace</strong>…</p>
  </section>

  <section class="invite-onramp__panel" data-view="join-error" hidden>
    <p class="invite-onramp__eyebrow">Connection interrupted</p>
    <h1>Let’s check the invitation again.</h1>
    <p>
      CommonSwarm could not confirm whether you joined. Your invitation is still saved
      safely in this browser.
    </p>
    <button class="invite-onramp__button" type="button" data-retry-join>Try again</button>
  </section>

  <section class="invite-onramp__connect" data-view="connect" hidden>
    <div class="invite-onramp__receipt">
      <span aria-hidden="true">✓</span>
      <p>
        You joined <strong data-workspace>a workspace</strong>.
        Your agents need your own authorization. Use a separate OAuth connector grant for this workspace.
      </p>
    </div>
    <p>Create your own personal workspace from the workspace menu. Keep private and shared agents on separate connections.</p>
    <p>For hosted MCP, connect <code>https://mcp.commonswarm.com/mcp</code> through your own account, select this shared workspace, and call <code>claim_seat</code>. Each chat using the same connector grant can select its seats. Seat names do not isolate chats.</p>
    <a href="/app">Open my workspaces and connected apps</a>
    <AgentConnect eyebrow="Your local agent" />
  </section>

  <section class="invite-onramp__panel" data-view="complete" hidden>
    <p class="invite-onramp__eyebrow">You’re in</p>
    <h1 data-complete-title>Agent access is ready.</h1>
    <p>
      Open the workspace to see the shared channel. Pending agent access remains visible
      there until the agent first connects or you cancel it.
    </p>
    <a class="invite-onramp__button" href="/app">Open the workspace</a>
  </section>
</invite-onramp>

<script>
  import {
    EmailAddressRejected,
    EmailRateLimited,
    currentSession,
    client,
    deployment,
    myWorkspaces,
    signInWithEmail,
    signInWithProvider,
  } from "../../lib/commonswarm";
  import { authProvider, listSentence } from "../../lib/auth-providers";
  import {
    assertInviteDeployment,
    decodeMemberInvite,
    forgetInvite,
    memberInviteUrl,
    recalledInvite,
    rememberInvite,
    type MemberInvitePayload,
  } from "../../lib/member-invite";

  import { browserHumanInvitations, HumanInviteRefused } from '../../lib/human-invitations';
  import type { HumanInvitePreview } from '../../../../src/cloud/human-invitations';
  const host = document.querySelector<HTMLElement>("invite-onramp");
  if (host) {
    const one = <T extends Element>(selector: string): T | null => host.querySelector<T>(selector);
    let payload: MemberInvitePayload | null = null;
    let resumeId = "";
    let senderLink = "";
    let authGeneration = 0;
    let authUser: string | null = null;
    let preview: HumanInvitePreview | null = null;
    let prepared: ReturnType<ReturnType<typeof browserHumanInvitations>['prepareAcceptance']> | null = null;

    /*
     * The provider names for prose, read off the BUTTONS THAT ARE ON THIS PAGE.
     *
     * Not off a second list, and not typed. AGENTS.md: "If a user-facing string lists things
     * the code enforces … that list must come from the same constant the enforcement reads."
     * The buttons are already generated from AUTH_PROVIDERS, so deriving the sentence from
     * the buttons makes the sentence and the choices the same set by construction — there is
     * no third place for the two to drift apart.
     */
    const renderedProviderNames = (): string[] =>
      [...host.querySelectorAll<HTMLElement>("[data-signin-provider]")]
        .map((button) => button.dataset.signinProvider ?? "")
        .map((id) => {
          try {
            return authProvider(id).name;
          } catch {
            return "";
          }
        })
        .filter((name) => name.length > 0);

    const show = (name: string): void => {
      for (const view of host.querySelectorAll<HTMLElement>("[data-view]")) {
        view.hidden = view.dataset.view !== name;
      }
      host.dataset.state = name;
      window.requestAnimationFrame(() => {
        const heading = one<HTMLElement>(`[data-view="${name}"] h1, [data-view="${name}"] h2`);
        if (!heading) return;
        heading.tabIndex = -1;
        heading.focus({ preventScroll: true });
      });
    };

    const fillLabels = (invite: MemberInvitePayload): void => {
      for (const node of host.querySelectorAll<HTMLElement>("[data-inviter]")) {
        node.textContent = invite.inviter_display_name;
      }
      for (const node of host.querySelectorAll<HTMLElement>("[data-workspace]")) {
        node.textContent = invite.workspace_name;
      }
    };

    const unusable = (message?: string): void => {
      if (resumeId) forgetInvite(resumeId, localStorage);
      const node = one<HTMLElement>("[data-unusable-message]");
      if (node && message) node.textContent = message;
      show("unusable");
    };

    const continueToAgent = (workspaceId: string, workspaceName: string): void => {
      const connect = one<HTMLElement>("agent-connect");
      connect?.setAttribute("workspace-id", workspaceId);
      connect?.setAttribute("workspace-name", workspaceName);
      const next = new URL("/invite", window.location.origin);
      next.searchParams.set("joined", workspaceId);
      history.replaceState(null, "", next);
      show("connect");
    };

    const accept = async (confirmed = false): Promise<void> => {
      if (!payload) return unusable();
      const session = await currentSession();
      if (!session) return show("auth");
      authUser = session.user.id;
      const generation = authGeneration;
      if (payload.inviter_user_id === session.user.id) {
        senderLink = memberInviteUrl(window.location.origin, payload);
        return show("sender");
      }
      show("joining");
      try {
        const existing = (await myWorkspaces()).find(
          (workspace) => workspace.id === payload?.workspace_id,
        );
        if (generation !== authGeneration) return;
        if (existing) {
          forgetInvite(resumeId, localStorage);
          continueToAgent(existing.id, existing.name);
          return;
        }
        const invitations = browserHumanInvitations();
        if (!confirmed) {
          prepared = null;
          const value = await invitations.preview({source:'link',token:payload.invitation_token});
          if (generation !== authGeneration) return;
          if (value.status === 'joined') return continueToAgent(value.workspace_id, value.workspace_name);
          preview = value;
          one<HTMLElement>('[data-review-workspace]')!.textContent = value.workspace_name;
          one<HTMLElement>('[data-review-audience]')!.textContent = 'Current members: ' + value.audience.map(m => `${m.display_name} (${m.role})`).join(', ');
          one<HTMLElement>('[data-review-disclosure]')!.textContent = value.disclosure;
          one<HTMLElement>('[data-review-expiry]')!.textContent = 'Expires ' + new Date(value.expires_at).toLocaleString();
          one<HTMLInputElement>('[data-independent-consent]')!.disabled = false;
          one<HTMLSelectElement>('[data-content-role]')!.disabled = false;
          one<HTMLInputElement>('[data-independent-consent]')!.checked = false;
          one<HTMLSelectElement>('[data-content-role]')!.value = '';
          return show('review');
        }
        const role = one<HTMLSelectElement>('[data-content-role]')!.value;
        if (!preview || !one<HTMLInputElement>('[data-independent-consent]')!.checked || (role !== 'reader' && role !== 'editor')) return show('review');
        one<HTMLInputElement>('[data-independent-consent]')!.disabled = true;
        one<HTMLSelectElement>('[data-content-role]')!.disabled = true;
        prepared ??= invitations.prepareAcceptance({source:'link',token:payload.invitation_token},preview,role);
        const accepted = await prepared.send();
        if (generation !== authGeneration) return;
        const workspaceId = String(accepted.workspace_id);
        const workspaceName = String(accepted.workspace_name);
        forgetInvite(resumeId, localStorage);
        continueToAgent(workspaceId, workspaceName);
      } catch (error) {
        if (generation !== authGeneration) return;
        try {
          const recovered = (await myWorkspaces()).find(
            (workspace) => workspace.id === payload?.workspace_id,
          );
          if (generation !== authGeneration) return;
          if (recovered) {
            forgetInvite(resumeId, localStorage);
            continueToAgent(recovered.id, recovered.name);
            return;
          }
        } catch {
          // The saved invitation remains available for an explicit retry.
        }
        if (error instanceof HumanInviteRefused && error.reason === 'review_changed') { preview = null; prepared = null; return await accept(); }
        if (!(error instanceof HumanInviteRefused)) {
          show("join-error");
          return;
        }
        unusable("This invitation could not be accepted. Ask the sender to check the recipient address, expiry, and shared workspace settings.");
      }
    };

    const boot = async (): Promise<void> => {
      const target = deployment();
      if (!target) {
        return unusable("This saved page is not connected to a CommonSwarm deployment.");
      }
      const url = new URL(window.location.href);
      const encoded = url.hash.startsWith("#invite=")
        ? url.hash.slice("#invite=".length)
        : "";
      if (encoded) {
        history.replaceState(null, "", new URL("/invite", window.location.origin));
      }
      try {
        if (encoded) {
          payload = decodeMemberInvite(encoded);
          assertInviteDeployment(payload, target);
          resumeId = rememberInvite(payload, localStorage);
          const clean = new URL("/invite", window.location.origin);
          clean.searchParams.set("resume", resumeId);
          history.replaceState(null, "", clean);
        } else {
          resumeId = url.searchParams.get("resume") ?? "";
          payload = resumeId ? recalledInvite(resumeId, localStorage) : null;
        }
      } catch {
        return unusable();
      }

      if (!payload) {
        const joinedId = url.searchParams.get("joined") ?? "";
        const session = await currentSession();
        const joined = session
          ? (await myWorkspaces()).find((workspace) => workspace.id === joinedId)
          : null;
        if (joined) return continueToAgent(joined.id, joined.name);
        return unusable();
      }
      fillLabels(payload);
      await accept();
    };

    one<HTMLFormElement>("[data-email-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const input = one<HTMLInputElement>("#invite-email");
      const error = one<HTMLElement>("[data-auth-error]");
      const status = one<HTMLElement>("[data-auth-status]");
      if (!input || !resumeId) return;
      if (error) error.hidden = true;
      try {
        const redirect = new URL("/invite", window.location.origin);
        redirect.searchParams.set("resume", resumeId);
        await signInWithEmail(input.value.trim(), redirect.href);
        if (status) status.textContent = `Check ${input.value.trim()} for your sign-in link.`;
      } catch (caught) {
        const choices = listSentence(renderedProviderNames());
        if (error) {
          error.textContent = caught instanceof EmailRateLimited
            ? choices
              ? `Email delivery is busy. Sign in with ${choices}, or try again later.`
              : "Email delivery is busy. Try again later."
            : caught instanceof EmailAddressRejected
            ? "Enter a complete email address."
            : caught instanceof Error
            ? caught.message
            : "CommonSwarm could not send the sign-in link.";
          error.hidden = false;
        }
      }
    });

    /*
     * One handler for every generated button. The id comes off the element, so a provider
     * added to AUTH_PROVIDERS works here with no change: the button renders itself and
     * signInWithProvider re-checks the id against the same array before any request.
     */
    for (const button of host.querySelectorAll<HTMLButtonElement>("[data-signin-provider]")) {
      button.addEventListener("click", async () => {
        if (!resumeId) return;
        const id = button.dataset.signinProvider ?? "";
        const redirect = new URL("/invite", window.location.origin);
        redirect.searchParams.set("resume", resumeId);
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        try {
          await signInWithProvider(id, redirect.href);
        } catch {
          /*
           * No NoDeployment branch here, and it is not an oversight. Two things make that
           * state unreachable from this button: the buttons exist only when the BUILD read an
           * enabled provider off a deployment, and `boot()` above shows the "unusable" panel
           * and never reveals this view when `deployment()` is null at runtime.
           */
          const error = one<HTMLElement>("[data-auth-error]");
          if (error) {
            let name = "That";
            try {
              name = authProvider(id).name;
            } catch {
              name = "That";
            }
            error.textContent = `${name} sign-in could not start. Try the email option.`;
            error.hidden = false;
          }
          button.disabled = false;
          button.removeAttribute("aria-busy");
        }
      });
    }

    one<HTMLButtonElement>("[data-retry-join]")?.addEventListener("click", () => {
      void accept(true);
    });

    one<HTMLButtonElement>("[data-confirm-join]")?.addEventListener("click", () => { void accept(true); });

    one<HTMLButtonElement>("[data-copy-sender]")?.addEventListener("click", async () => {
      const status = one<HTMLElement>("[data-sender-status]");
      try {
        await navigator.clipboard.writeText(senderLink);
        if (status) status.textContent = "Copied. Send it to your teammate.";
      } catch {
        if (status) status.textContent = "Your browser blocked copy. Return to the workspace and create a new link.";
      }
    });

    host.addEventListener("commonswarm:agent-secret-cleared", (event) => {
      const reason = (event as CustomEvent<{ reason?: unknown }>).detail?.reason;
      const title = one<HTMLElement>("[data-complete-title]");
      if (title) {
        title.textContent = reason === "consumed"
          ? "Your agent connected."
          : "Agent access is ready.";
      }
      show("complete");
    });

    client()?.auth.onAuthStateChange((event, session) => {
      const user = session?.user.id ?? null;
      if (event === 'SIGNED_OUT' || authUser !== null && user !== authUser) {
        ++authGeneration; preview = null; prepared = null; payload = null;
        unusable('Sign in as the invited person and reopen the invitation.');
      }
      authUser = user;
    });
    void boot();
  }
</script>

<style>
  .invite-onramp {
    min-block-size: 100svh;
    inline-size: min(100% - var(--gutter) * 2, 46rem);
    margin-inline: auto;
    padding-block: clamp(var(--s-8), 8vw, var(--s-16));
    display: grid;
    align-content: center;
    gap: var(--s-8);
  }

  .invite-onramp__wordmark {
    justify-self: start;
    color: var(--text);
    font-size: var(--t-lg);
    font-weight: var(--weight-head);
    letter-spacing: var(--track-tight);
    text-decoration: none;
  }

  .invite-onramp__panel,
  .invite-onramp__connect {
    min-inline-size: 0;
    display: grid;
    gap: var(--s-5);
  }

  .invite-onramp__panel[hidden],
  .invite-onramp__connect[hidden] {
    display: none;
  }

  .invite-onramp__eyebrow {
    margin: 0;
    color: var(--accent-bright);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .invite-onramp h1 {
    max-inline-size: 18ch;
    margin: 0;
    font-size: var(--t-3xl);
    line-height: 1.02;
    letter-spacing: var(--track-head);
    text-wrap: balance;
  }

  .invite-onramp h1:focus {
    outline: none;
    box-shadow: none;
  }

  .invite-onramp p {
    max-inline-size: 62ch;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-base);
    line-height: var(--lh-base);
  }

  .invite-onramp__steps {
    display: grid;
    gap: var(--s-3);
    padding: 0;
    list-style: none;
  }

  .invite-onramp__steps li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--text);
  }

  .invite-onramp__steps span,
  .invite-onramp__receipt > span {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    display: grid;
    place-items: center;
    flex: none;
    color: var(--accent-bright);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
  }

  .invite-onramp__auth {
    display: grid;
    gap: var(--s-3);
  }

  .invite-onramp__auth label {
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-medium);
  }

  .invite-onramp__auth input {
    min-block-size: 2.75rem;
    inline-size: 100%;
    padding: var(--s-3) var(--s-4);
    color: var(--text);
    background: var(--elev-1);
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius);
    font: inherit;
  }

  .invite-onramp__button {
    min-block-size: 2.75rem;
    inline-size: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-3) var(--s-5);
    color: var(--accent-ink);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    font: inherit;
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    cursor: pointer;
  }

  .invite-onramp__providers {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }

  .invite-onramp__button--quiet {
    color: var(--text);
    background: transparent;
    border-color: var(--border-strong);
  }

  .invite-onramp__button:focus-visible,
  .invite-onramp__auth input:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .invite-onramp__divider {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--text-faint);
    font-size: var(--t-xs);
  }

  .invite-onramp__divider::before,
  .invite-onramp__divider::after {
    content: "";
    block-size: 1px;
    flex: 1;
    background: var(--border);
  }

  .invite-onramp__status {
    min-block-size: 1.4em;
    font-size: var(--t-sm) !important;
  }

  .invite-onramp__error {
    padding: var(--s-3);
    color: var(--text) !important;
    background: var(--danger-dim);
    border-radius: var(--radius);
    font-size: var(--t-sm) !important;
  }

  .invite-onramp__spinner {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border: 2px solid var(--border);
    border-block-start-color: var(--accent);
    border-radius: var(--radius-pill);
    animation: invite-spin 0.8s linear infinite;
  }

  .invite-onramp__receipt {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-4);
    border-block: 1px solid var(--border);
  }

  @keyframes invite-spin {
    to { transform: rotate(1turn); }
  }

  @media (max-width: 30rem) {
    .invite-onramp__button {
      inline-size: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .invite-onramp__spinner {
      animation: none;
    }
  }
</style>
