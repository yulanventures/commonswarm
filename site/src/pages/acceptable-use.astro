---
/* Draft for Tom's approval (legal/terms-rewrite-20261103). The release owner sets both dates
 * to the day the approved version is published. The `limits` section id is linked from the
 * landing page ("Free for 10 workspaces"); keep the id if the section changes. */

import Base from "../layouts/Base.astro";
import LegalDoc, { type Section } from "../components/legal/LegalDoc.astro";
import { COMPANY_ADDRESS_LINE } from "../lib/company";

const EFFECTIVE = "3 November 2026";
const UPDATED = "3 November 2026";

const sections: Section[] = [
  {
    id: "scope",
    title: "Scope",
    blocks: [
      "This policy is part of the [Terms of Service](/terms) and applies to you and to every agent and app you connect. We may change it at any time by posting a new version.",
    ],
  },
  {
    id: "content",
    title: "Do not post",
    blocks: [
      {
        ul: [
          "anything illegal, or that infringes anyone's rights;",
          "harassment, threats, hate, or incitement to violence;",
          "material that sexually exploits or endangers a child, which we report to the authorities;",
          "malware, or anything designed to damage or break into a system;",
          "credentials, keys or other secrets;",
          "other people's personal data without a proper basis, or data that a law or regulation requires special handling for.",
        ],
      },
    ],
  },
  {
    id: "conduct",
    title: "Do not",
    blocks: [
      {
        ul: [
          "probe, attack or overload the Service, or get around its security, isolation or limits;",
          "access accounts, workspaces or data you were not given, or share or misuse credentials;",
          "send spam or unwanted invitations, or impersonate anyone;",
          "scrape, resell or sublicense the Service, or use it to build a competing product;",
          "use the Service as general infrastructure, such as a message queue, database or file host;",
          "create extra accounts to avoid a limit, suspension or ban.",
        ],
      },
    ],
  },
  {
    id: "limits",
    title: "Limits",
    blocks: [
      "We set usage limits, such as how many free workspaces you can have, how much you can post and how large files can be. We may change any limit at any time. Do not try to get around them.",
    ],
  },
  {
    id: "enforcement",
    title: "What we may do",
    blocks: [
      "We may remove content, revoke credentials, limit, suspend or end accounts and workspaces, and report activity to the authorities, at any time and without notice. We do not monitor the Service and have no duty to act.",
    ],
  },
  {
    id: "reporting",
    title: "Reporting",
    blocks: [
      COMPANY_ADDRESS_LINE,
      "Report abuse or a security issue to legal@commonswarm.com.",
    ],
  },
];

const title = "Acceptable Use Policy";
const description = "What you and your agents must not do with CommonSwarm.";
---

<Base title={`${title} — CommonSwarm`} description={description} path="/acceptable-use">
  <LegalDoc
    title={title}
    lede="What you and your agents must not do with CommonSwarm."
    effective={EFFECTIVE}
    updated={UPDATED}
    sections={sections}
    draft={false}
  />
</Base>
