---
/*
 * /privacy — Tom's approved processing, provider, and retention decisions.
 * The release owner updates both dates if the planned site release slips.
 * Sign-in providers follow the same GoTrue settings as the sign-in buttons.
 */

import Base from "../layouts/Base.astro";
import LegalDoc, { type Section } from "../components/legal/LegalDoc.astro";
import { COMPANY_ADDRESS_LINE } from "../lib/company";
import {
  enabledProvidersForBuild,
  providerEntities,
} from "../lib/auth-providers";

const providers = await enabledProvidersForBuild({
  url: import.meta.env.PUBLIC_SUPABASE_URL,
  anonKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
});
const entities = providerEntities(providers);

const EFFECTIVE = "2 October 2026";
const UPDATED = "2 October 2026";

const sections: Section[] = [
  {
    id: "who",
    title: "Who we are",
    blocks: [
      COMPANY_ADDRESS_LINE,
      "This policy forms part of the [Terms of Service](/terms). Contact us at legal@commonswarm.com.",
    ],
  },
  {
    id: "service-records",
    title: "Logs",
    blocks: [
      "We keep web-server and application logs on our server. Access is limited to our operator. Logs are kept for 35 days.",
    ],
  },
  {
    id: "sharing",
    title: "Service providers",
    blocks: [
      {
        ul: [
          "**Hetzner.** Hosting in Germany.",
          "**Cloudflare.** DNS, proxy, TLS, R2 file storage and backups.",
          "**Resend.** Transactional email.",
        ],
      },
      "Hetzner, Cloudflare and Resend act as processors on our behalf under their standard data processing terms.",
      ...(providers.length > 0
        ? [
            `Sign-in through ${entities} is your choice; these sign-in providers are not our processors.`,
          ]
        : []),
    ],
  },
  {
    id: "connected-agents",
    title: "Connected AI assistants and agents",
    blocks: [
      "AI assistants and agents you connect to CommonSwarm (for example through the hosted MCP connector) are tools you choose and control. Their handling, retention and training use of the data they access is governed by their own terms, not ours. We do not send your data to any AI provider on our own initiative.",
    ],
  },
  {
    id: "retention",
    title: "Retention and deletion",
    blocks: [
      "Files and hosted MCP OAuth records are deleted when you delete them or your account. Backups age out within 35 days. A backup restore does not re-create deleted data except for disaster recovery, after which deletions are re-applied.",
    ],
  },
  {
    id: "regional",
    title: "Where data is processed",
    blocks: [
      "Primary processing takes place on our server in Germany. Cloudflare files, backups and email delivery may be processed in the United States. Our operator is in the United States.",
      "Where data leaves the EEA or the UK, we rely on our providers' standard contractual clauses.",
    ],
  },
  {
    id: "contact",
    title: "Contact",
    blocks: [
      COMPANY_ADDRESS_LINE,
      "Contact us at legal@commonswarm.com.",
    ],
  },
];

const title = "Privacy Policy";
const description =
  "Processing locations, provider roles, logs, retention, and connected AI tools for CommonSwarm.";
---

<Base title={`${title} — CommonSwarm`} description={description} path="/privacy">
  <LegalDoc
    title={title}
    lede="Where data is processed, who processes it, and how logs, files and backups are retained."
    effective={EFFECTIVE}
    updated={UPDATED}
    sections={sections}
    draft={false}
  />
</Base>
