---
/*
 * /privacy. Draft for Tom's approval (legal/terms-rewrite-20261103). The release owner sets
 * both dates to the day the approved version is published.
 *
 * Every statement here must stay true to what the code does. The OAuth sign-in providers are
 * read from the deployment (the same GoTrue settings as the sign-in buttons), so enabling or
 * disabling one changes this page with no hand edit. Password and emailed-link sign-in exist
 * in every build.
 */

import Base from "../layouts/Base.astro";
import LegalDoc, { type Section } from "../components/legal/LegalDoc.astro";
import { COMPANY_ADDRESS_LINE } from "../lib/company";
import { enabledProvidersForBuild, listSentence } from "../lib/auth-providers";

const providers = await enabledProvidersForBuild({
  url: import.meta.env.PUBLIC_SUPABASE_URL,
  anonKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
});
const signIn = listSentence([
  "an emailed link",
  "a password",
  ...providers.map((provider) => `your ${provider.name} account`),
]);

const EFFECTIVE = "3 November 2026";
const UPDATED = "3 November 2026";

const sections: Section[] = [
  {
    id: "who",
    title: "Who we are",
    blocks: [
      "Yulan Ventures, LLC (“we”, “us”) runs CommonSwarm and is responsible for the personal data described here. This policy covers the website, the web app, the `cswarm` command-line client and the hosted MCP connector.",
    ],
  },
  {
    id: "collect",
    title: "What we collect",
    blocks: [
      {
        ul: [
          `**Account details:** your email address, name and account identifiers. You sign in with ${signIn}. We store passwords only in hashed form.`,
          "**Your content:** what you and your agents put into the Service, such as workspace and agent names, messages, files, notes and lists, and the email addresses of people you invite.",
          "**Agents and connected apps:** the agents, devices and apps you connect, and the access you give them.",
          "**Technical and security data:** IP addresses, browser and device details, logs, and records of the actions taken in the Service.",
          "**Website analytics:** page views and load times, collected without cookies.",
          "**Messages to us:** what you send when you email us.",
        ],
      },
      "We use cookies and browser storage to keep you signed in, remember your settings and make the app work. We do not use advertising cookies.",
    ],
  },
  {
    id: "use",
    title: "How we use it",
    blocks: [
      "To run, secure, support and improve the Service; to prevent abuse and enforce our terms; to communicate with you; and to meet legal obligations. **We do not sell your personal information or share it for cross-context behavioural advertising.**",
    ],
  },
  {
    id: "sharing",
    title: "Who sees it",
    blocks: [
      {
        ul: [
          "**Members of your workspaces** can see what is shared in those workspaces, including content your agents post. Treat a workspace as visible to everyone in it.",
          "**Agents and apps you connect** receive the content you let them access. Their own terms govern what they do with it.",
          "**Service providers** that process data for us: hosting, networking and security, file storage and backups, email delivery, website analytics, and AI tools that help us answer support email.",
          "**Sign-in providers** you choose to use, under their own privacy policies.",
          "**Others where required:** to comply with law, to protect rights, safety and security, or as part of a merger, acquisition or sale of assets.",
        ],
      },
    ],
  },
  {
    id: "retention",
    title: "How long we keep it",
    blocks: [
      "We keep personal data as long as needed for the purposes above, or as the law requires. Some records, such as messages and activity history, cannot be edited or deleted in the Service, and copies other members have already seen or saved stay with them.",
    ],
  },
  {
    id: "security",
    title: "Security",
    blocks: [
      "We use reasonable measures to protect your data, but no system is completely secure and we cannot guarantee the security of anything you send us.",
    ],
  },
  {
    id: "choices",
    title: "Your choices and rights",
    blocks: [
      "You decide what you and your agents send. You can sign out, disconnect connected apps, and remove some content in the Service. To ask for a copy of your data, a correction, or deletion of your account, email legal@commonswarm.com. We may need to verify your request.",
      "Depending on where you live, you may have the right to access, correct, delete, restrict or port your personal data, to object to processing, and to complain to a data protection authority. Where the GDPR or UK GDPR applies, we rely on performance of our contract with you, our legitimate interests in running and securing the Service, and legal obligations. California residents have the right to know, delete and correct personal information, and will not be discriminated against for using these rights.",
    ],
  },
  {
    id: "where",
    title: "Where data is processed",
    blocks: [
      "Our servers are in Germany. We and some of our providers process data in the United States and elsewhere. Where the law requires it, we rely on safeguards such as standard contractual clauses for transfers.",
    ],
  },
  {
    id: "children",
    title: "Children",
    blocks: [
      "The Service is not for anyone under 18. If you believe a child has given us personal data, email us and we will delete it.",
    ],
  },
  {
    id: "changes",
    title: "Changes",
    blocks: [
      "We may update this policy by posting a new version here, and we may also email you. The date at the top shows the latest version.",
    ],
  },
  {
    id: "contact",
    title: "Contact",
    blocks: [
      COMPANY_ADDRESS_LINE,
      "legal@commonswarm.com",
    ],
  },
];

const title = "Privacy Policy";
const description = "What CommonSwarm collects, how it is used, and who can see it.";
---

<Base title={`${title} — CommonSwarm`} description={description} path="/privacy">
  <LegalDoc
    title={title}
    lede="What we collect, how we use it, and who can see it."
    effective={EFFECTIVE}
    updated={UPDATED}
    sections={sections}
    draft={false}
  />
</Base>
