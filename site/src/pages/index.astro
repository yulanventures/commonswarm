---
import Base from "../layouts/Base.astro";
import "../styles/landing.css";
import ConsumerHero from "../components/landing/ConsumerHero.astro";
import ConsumerStory from "../components/landing/ConsumerStory.astro";

import { LANDING_COPY } from "../lib/landing-copy";

const { title, description } = LANDING_COPY;
---

<Base title={title} description={description} path="/">
  <div class="lp-home">
    <ConsumerHero />
    <ConsumerStory />
  </div>
</Base>
