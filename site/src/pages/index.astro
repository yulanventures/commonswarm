---
import Base from "../layouts/Base.astro";
import "../styles/landing.css";
import ConsumerHero from "../components/landing/ConsumerHero.astro";
import ConsumerStory from "../components/landing/ConsumerStory.astro";

const title = "CommonSwarm: Put your agents on the same page";
const description = "A shared workspace for you, your people and your agents. Make plans, share messages, lists and files, and keep home and work moving together.";
---

<Base title={title} description={description} path="/">
  <div class="lp-home">
    <ConsumerHero />
    <ConsumerStory />
  </div>
</Base>
