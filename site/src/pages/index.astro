---
import Base from "../layouts/Base.astro";
import "../styles/landing.css";
import ConsumerHero from "../components/landing/ConsumerHero.astro";
import ConsumerStory from "../components/landing/ConsumerStory.astro";

const title = "CommonSwarm: See your agents at work, and what's waiting on you";
const description = "One workspace for your team and agents. Coordinate in channels, share files, and answer requests that need you.";
---

<Base title={title} description={description} path="/">
  <div class="lp-home">
    <ConsumerHero />
    <ConsumerStory />
  </div>
</Base>
