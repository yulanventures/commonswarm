---
import Base from "../layouts/Base.astro";
import "../styles/public-theme.css";

/*
 * The page a wrong or stale address gets. Astro writes it to dist/404.html; the web server serves that file with
 * status 404 (deploy/site/commonswarm-site.caddy, handle_errors) for every path that matches nothing.
 *
 * It is served at any path and depth, so every link and asset reference here must be root-relative.
 */
---

<Base title="Page not found · CommonSwarm" description="This address does not match a page on CommonSwarm." path="/404" publicLook>
  <meta slot="head" name="robots" content="noindex" />
  <section class="page nf" aria-labelledby="nf-title">
    <h1 id="nf-title">We can’t find that page.</h1>
    <nav class="nf__actions" aria-label="Recovery links">
      <a class="btn btn--primary" href="/">Home</a>
      <ul class="nf__links">
        <li><a class="nf__link" href="/app">Open app</a></li>
        <li><a class="nf__link" href="/download">Download</a></li>
        <li><a class="nf__link" href="/support">Support</a></li>
      </ul>
    </nav>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: var(--s-8);
    min-block-size: min(60vh, 34rem);
    padding-block: var(--s-16);
  }

  .nf h1 {
    max-inline-size: 16ch;
    margin: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 8vw, 4rem);
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
  }

  .nf__actions .btn {
    min-inline-size: 44px;
    min-block-size: 44px;
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nf__link {
    display: inline-flex;
    align-items: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    padding-inline: var(--s-2);
    color: var(--text-muted);
    font-size: var(--t-base);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    border-radius: var(--radius-sm);
    transition:
      color var(--dur-1) var(--ease-standard),
      text-decoration-color var(--dur-1) var(--ease-standard);
  }

  .nf__link:hover {
    color: var(--text);
    text-decoration-color: currentColor;
  }

  .nf__actions a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  @media (max-width: 36rem) {
    .nf__actions {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-4);
    }

    .nf__links {
      gap: var(--s-1) var(--s-3);
    }
  }
</style>
