const description = "The terms you agree to when you use CommonSwarm.";
---

<Base title={`${title} — CommonSwarm`} description={description} path="/terms">
  <LegalDoc
    title={title}
    lede="The agreement between you and Yulan Ventures, LLC when you use CommonSwarm."
